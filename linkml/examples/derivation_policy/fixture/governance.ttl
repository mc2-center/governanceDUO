@prefix gov: <https://w3id.org/synapse/governance#> .
@prefix syn: <https://www.synapse.org/Synapse:> .

# Shaped like the canonical example (linkml/examples/graph/governance_graph.example.yaml):
# SynapseEntity -gov:requiresAR-> AccessRequirement, with the AR's tier directly
# on its own node (gov:dataTier), not a curated-record bridge (plans/model_refactor.md
# R5: the AR's graph node is the one place its tier lives). AR (and later
# Activity/Usage) IRIs are written in full: govid:'s minted local names contain
# '/', which isn't a legal (unescaped) Turtle PN_LOCAL character, so they can't
# be prefixed names the way syn:/gov: ones can. This fixture doesn't model ACLs,
# so each entity is (trivially) its own benefactor, only to satisfy
# gov:SynapseEntity's required benefactor.
syn:syn70000001 a gov:SynapseEntity ;
    gov:benefactor syn:syn70000001 ;
    gov:requiresAR <https://w3id.org/synapse/governance/ar/7001> .
syn:syn70000002 a gov:SynapseEntity ;
    gov:benefactor syn:syn70000002 ;
    gov:requiresAR <https://w3id.org/synapse/governance/ar/7002> .

<https://w3id.org/synapse/governance/ar/7001> a gov:AccessRequirement ;
    gov:dataTier gov:ControlledTier .
# AR-7002 carries no gov:dataTier -- fails closed to Unclassified.
<https://w3id.org/synapse/governance/ar/7002> a gov:AccessRequirement .

# Three Controlled inputs sharing one AR, and an output bound directly to a
# Private AR.
syn:syn70000011 a gov:SynapseEntity ;
    gov:benefactor syn:syn70000011 ;
    gov:requiresAR <https://w3id.org/synapse/governance/ar/7003> .
syn:syn70000012 a gov:SynapseEntity ;
    gov:benefactor syn:syn70000012 ;
    gov:requiresAR <https://w3id.org/synapse/governance/ar/7003> .
syn:syn70000014 a gov:SynapseEntity ;
    gov:benefactor syn:syn70000014 ;
    gov:requiresAR <https://w3id.org/synapse/governance/ar/7003> .
syn:syn70000013 a gov:SynapseEntity ;
    gov:benefactor syn:syn70000013 ;
    gov:requiresAR <https://w3id.org/synapse/governance/ar/7004> .

<https://w3id.org/synapse/governance/ar/7003> a gov:AccessRequirement ;
    gov:dataTier gov:ControlledTier .
<https://w3id.org/synapse/governance/ar/7004> a gov:AccessRequirement ;
    gov:dataTier gov:PrivateTier .

# A second Private-bound input, with no derivation ancestry of its own.
syn:syn70000017 a gov:SynapseEntity ;
    gov:benefactor syn:syn70000017 ;
    gov:requiresAR <https://w3id.org/synapse/governance/ar/7004> .
