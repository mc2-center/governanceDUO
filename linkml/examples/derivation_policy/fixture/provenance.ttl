@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix sagegov: <https://sagebionetworks.org/governance/> .
@prefix syn: <https://www.synapse.org/Synapse:> .

# Two disjoint-AR data inputs plus an executed script; one output.
sagegov:activity-7001 a prov:Activity ;
    prov:generated syn:syn70000003 ;
    prov:qualifiedUsage
        [ a prov:Usage ; prov:entity syn:syn70000001 ; sagegov:wasExecuted false ] ,
        [ a prov:Usage ; prov:entity syn:syn70000002 ; sagegov:wasExecuted false ] ,
        [ a prov:Usage ; prov:entity syn:syn70000009 ; sagegov:wasExecuted true ] .

# Two Controlled inputs -> an output bound directly to a Private AR.
sagegov:activity-7002 a prov:Activity ;
    prov:generated syn:syn70000013 ;
    prov:qualifiedUsage
        [ a prov:Usage ; prov:entity syn:syn70000011 ; sagegov:wasExecuted false ] ,
        [ a prov:Usage ; prov:entity syn:syn70000012 ; sagegov:wasExecuted false ] .

# Three Controlled inputs sharing one AR: no pair is disjoint, and no rule
# covers all three, but the Controlled+Controlled rule covers each pair.
sagegov:activity-7003 a prov:Activity ;
    prov:generated syn:syn70000015 ;
    prov:qualifiedUsage
        [ a prov:Usage ; prov:entity syn:syn70000011 ; sagegov:wasExecuted false ] ,
        [ a prov:Usage ; prov:entity syn:syn70000012 ; sagegov:wasExecuted false ] ,
        [ a prov:Usage ; prov:entity syn:syn70000014 ; sagegov:wasExecuted false ] .

# Controlled + Private inputs; the Controlled+Private rule lowers the output to
# Controlled (it has no binding of its own), and nothing is flagged.
sagegov:activity-7004 a prov:Activity ;
    prov:generated syn:syn70000016 ;
    prov:qualifiedUsage
        [ a prov:Usage ; prov:entity syn:syn70000011 ; sagegov:wasExecuted false ] ,
        [ a prov:Usage ; prov:entity syn:syn70000013 ; sagegov:wasExecuted false ] .

# Controlled, Controlled, Private, Private: the Private+Private pair is forbidden
# and the Controlled+Controlled pair needs review; the notes must lead with the
# forbidding rule.
sagegov:activity-7005 a prov:Activity ;
    prov:generated syn:syn70000018 ;
    prov:qualifiedUsage
        [ a prov:Usage ; prov:entity syn:syn70000011 ; sagegov:wasExecuted false ] ,
        [ a prov:Usage ; prov:entity syn:syn70000012 ; sagegov:wasExecuted false ] ,
        [ a prov:Usage ; prov:entity syn:syn70000013 ; sagegov:wasExecuted false ] ,
        [ a prov:Usage ; prov:entity syn:syn70000017 ; sagegov:wasExecuted false ] .
