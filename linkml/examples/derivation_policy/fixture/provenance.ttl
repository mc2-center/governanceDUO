@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix gov: <https://w3id.org/synapse/governance#> .
@prefix syn: <https://www.synapse.org/Synapse:> .

# Every Usage carries its own IRI (.../activity/<n>/usage/<m>, graph_iris.usage()'s
# convention), not a blank node: shapes/governance.shacl.ttl requires an IRI on
# every graph node (plans/model_refactor.md -- "no blank nodes: every node needs
# an IRI"). Written in full: the minted local names contain '/', not a legal
# (unescaped) Turtle PN_LOCAL character, so they can't be prefixed names.

# Two disjoint-AR data inputs plus an executed script; one output.
<https://w3id.org/synapse/governance/activity/7001> a prov:Activity ;
    prov:generated syn:syn70000003 ;
    prov:qualifiedUsage
        <https://w3id.org/synapse/governance/activity/7001/usage/1>,
        <https://w3id.org/synapse/governance/activity/7001/usage/2>,
        <https://w3id.org/synapse/governance/activity/7001/usage/3> .
<https://w3id.org/synapse/governance/activity/7001/usage/1> a prov:Usage ; prov:entity syn:syn70000001 ; gov:wasExecuted false .
<https://w3id.org/synapse/governance/activity/7001/usage/2> a prov:Usage ; prov:entity syn:syn70000002 ; gov:wasExecuted false .
<https://w3id.org/synapse/governance/activity/7001/usage/3> a prov:Usage ; prov:entity syn:syn70000009 ; gov:wasExecuted true .

# Two Controlled inputs -> an output bound directly to a Private AR.
<https://w3id.org/synapse/governance/activity/7002> a prov:Activity ;
    prov:generated syn:syn70000013 ;
    prov:qualifiedUsage
        <https://w3id.org/synapse/governance/activity/7002/usage/1>,
        <https://w3id.org/synapse/governance/activity/7002/usage/2> .
<https://w3id.org/synapse/governance/activity/7002/usage/1> a prov:Usage ; prov:entity syn:syn70000011 ; gov:wasExecuted false .
<https://w3id.org/synapse/governance/activity/7002/usage/2> a prov:Usage ; prov:entity syn:syn70000012 ; gov:wasExecuted false .

# Three Controlled inputs sharing one AR: no pair is disjoint, and no rule
# covers all three, but the Controlled+Controlled rule covers each pair.
<https://w3id.org/synapse/governance/activity/7003> a prov:Activity ;
    prov:generated syn:syn70000015 ;
    prov:qualifiedUsage
        <https://w3id.org/synapse/governance/activity/7003/usage/1>,
        <https://w3id.org/synapse/governance/activity/7003/usage/2>,
        <https://w3id.org/synapse/governance/activity/7003/usage/3> .
<https://w3id.org/synapse/governance/activity/7003/usage/1> a prov:Usage ; prov:entity syn:syn70000011 ; gov:wasExecuted false .
<https://w3id.org/synapse/governance/activity/7003/usage/2> a prov:Usage ; prov:entity syn:syn70000012 ; gov:wasExecuted false .
<https://w3id.org/synapse/governance/activity/7003/usage/3> a prov:Usage ; prov:entity syn:syn70000014 ; gov:wasExecuted false .

# Controlled + Private inputs; the Controlled+Private rule lowers the output to
# Controlled (it has no binding of its own), and nothing is flagged.
<https://w3id.org/synapse/governance/activity/7004> a prov:Activity ;
    prov:generated syn:syn70000016 ;
    prov:qualifiedUsage
        <https://w3id.org/synapse/governance/activity/7004/usage/1>,
        <https://w3id.org/synapse/governance/activity/7004/usage/2> .
<https://w3id.org/synapse/governance/activity/7004/usage/1> a prov:Usage ; prov:entity syn:syn70000011 ; gov:wasExecuted false .
<https://w3id.org/synapse/governance/activity/7004/usage/2> a prov:Usage ; prov:entity syn:syn70000013 ; gov:wasExecuted false .

# Controlled, Controlled, Private, Private: the Private+Private pair is forbidden
# and the Controlled+Controlled pair needs review; the notes must lead with the
# forbidding rule.
<https://w3id.org/synapse/governance/activity/7005> a prov:Activity ;
    prov:generated syn:syn70000018 ;
    prov:qualifiedUsage
        <https://w3id.org/synapse/governance/activity/7005/usage/1>,
        <https://w3id.org/synapse/governance/activity/7005/usage/2>,
        <https://w3id.org/synapse/governance/activity/7005/usage/3>,
        <https://w3id.org/synapse/governance/activity/7005/usage/4> .
<https://w3id.org/synapse/governance/activity/7005/usage/1> a prov:Usage ; prov:entity syn:syn70000011 ; gov:wasExecuted false .
<https://w3id.org/synapse/governance/activity/7005/usage/2> a prov:Usage ; prov:entity syn:syn70000012 ; gov:wasExecuted false .
<https://w3id.org/synapse/governance/activity/7005/usage/3> a prov:Usage ; prov:entity syn:syn70000013 ; gov:wasExecuted false .
<https://w3id.org/synapse/governance/activity/7005/usage/4> a prov:Usage ; prov:entity syn:syn70000017 ; gov:wasExecuted false .

# Single-input activity (no review: len(inputs) < 2) -- just to bring
# syn70000019 into the entity set so its ControlLabel gets computed (see
# governance.ttl's comment on syn70000019).
<https://w3id.org/synapse/governance/activity/7006> a prov:Activity ;
    prov:generated syn:syn70000021 ;
    prov:qualifiedUsage <https://w3id.org/synapse/governance/activity/7006/usage/1> .
<https://w3id.org/synapse/governance/activity/7006/usage/1> a prov:Usage ; prov:entity syn:syn70000019 ; gov:wasExecuted false .
