@prefix association: <https://w3id.org/synapse/ad/association/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sagebrain: <https://w3id.org/synapse/sagebrain#> .
@prefix syn: <https://www.synapse.org/Synapse:> .

# Bridge axiom -- owned by sagebrain-model's governance layer; declared here
# only so this fixture is self-contained (see README.md).
sagebrain:derived_from rdfs:subPropertyOf prov:wasDerivedFrom .

# A sagebrain knowledge node derived from the Activity's output file.
association:fixture-assoc-01 a sagebrain:GeneExpressionAssociation ;
    sagebrain:derived_from syn:syn70000003 .
