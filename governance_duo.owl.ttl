            owl:onProperty governanceduo:sourceGeography ;
            owl:someValuesFrom linkml:String ] ;
    owl:intersectionOf ( [ a owl:Restriction ;
                owl:onProperty governanceduo:dataUseModifiers ;
                owl:someValuesFrom linkml:String ] governanceduo:GovernanceMixin ) .

