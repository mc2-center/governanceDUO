  "description": "Representation of a Synapse Access Requirement and its relationships to entities, grants, and projects.",
  "properties": {
    "AccessRequirementId": {
      "description": "A unique identifier for the access requirement. This should be the numeric identifier of the access requirement.",
      "not": {
        "type": "null"
      },
      "title": "AccessRequirement_id"
    },
    "Attribution": {
      "description": "The attribution statement for the data associated with the access requirement. Equivalent to DUOPlus7.",
      "title": "attribution",
      "type": "string"
    },
    "CollaborationRequired": {
      "description": "If collaboration is required for the access requirement, provide the PI email address. Provide multiple as a comma-separated list.",
      "title": "collaborationRequired",
      "type": "string"
    },
    "ContributionDate": {
      "description": "The date on which the access requirement was added.",
      "format": "date",
      "title": "contributionDate",
      "type": "string"
    },
    "ContributorName": {
      "description": "The name of the person who added this access requirement.",
      "title": "contributorName",
      "type": "string"
    },
    "DataPermission": {
      "description": "The permissions associated with the data under the access requirement. Equivalent to DUOPlus4.",
      "items": {
        "enum": [
          "Agreement",
          "Attestation",
          "Award",
          "Other"
        ],
        "type": "string"
      },
      "title": "dataPermission",
      "type": "array"
    },
    "DataTier": {
      "description": "The tier of data access associated with the access requirement. Equivalent to DUOPlus5.",
      "items": {
        "enum": [
          "Anonymous",
          "Controlled",
          "Open",
          "Private"
        ],
        "type": "string"
      },
      "title": "dataTier",
      "type": "array"
    },
    "DataUseModifiers": {
      "description": "A list of data use modifiers that apply to the access requirement. Examples include GRU, IRB, etc.",
      "items": {
        "enum": [
          "CC",
          "COL",
          "DSR",
          "DUM",
          "DUOPlus1",
          "DUOPlus2",
          "DUOPlus3",
          "DUOPlus4",
          "DUOPlus5",
          "DUOPlus6",
          "DUOPlus7",
          "GRU",
          "GSO",
          "GSR",
          "HMB",
          "IRB",
          "IST",
          "MOR",
          "NCU",
          "NMDS",
          "NPOA",
          "NPU",
          "NPUNCU",
          "NRES",
          "POA",
          "PS",
          "PUB",
          "PendingAnnotation",
          "RST",
          "RTN",
          "TSM",
          "USE"
        ],
        "type": "string"
      },
      "title": "dataUseModifiers",
      "type": "array"
    },
    "DeidentificationType": {
      "description": "The type of de-identification applied to the data associated with the access requirement. Equivalent to DUOPlus3.",
      "items": {
        "enum": [
          "Anonymized",
          "ExpertDetermination",
          "HIPPALDS",
          "Other",
          "Pseudonymized",
          "SafeHarbor"
        ],
        "type": "string"
      },
      "title": "deidentificationType",
      "type": "array"
    },
    "DiseaseSpecificResearch": {
      "description": "The type(s) of disease research allowed by this access requirement. Provide the MONDO ID in format MONDO:id. Provide multiple values as a comma-separated list. MONDO terms can be found here: https://ols.monarchinitiative.org/ontologies/mondo",
      "items": {
        "pattern": "MONDO:\\d{7}",
        "type": "string"
      },
      "pattern": "MONDO:\\d{7}",
      "title": "diseaseSpecificResearch",
      "type": "array"
    },
    "EntityIdList": {
      "description": "Synapse ID(s) for Synapse container(s) (e.g. Project, Dataset, Folder, Table, etc.) with which the Access Requirement is expected to be associated. Provide multiple values as a comma-separated list.",
      "title": "entityIdList",
      "type": "string"
    },
