{
  "$id": "http://example.com/Study_validation",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "allOf": [
    {
      "if": {
        "properties": {
          "DataUseModifiers": {
            "contains": {
              "enum": [
                "COL"
              ]
            }
          }
        }
      },
      "then": {
        "properties": {
          "CollaborationRequired": {
            "not": {
              "type": "null"
            }
          }
        },
        "required": [
          "CollaborationRequired"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "DataUseModifiers": {
            "contains": {
              "enum": [
                "DSR"
              ]
            }
          }
        }
      },
      "then": {
        "properties": {
          "DiseaseSpecificResearch": {
            "not": {
              "type": "null"
            }
          }
        },
        "required": [
          "DiseaseSpecificResearch"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "DataUseModifiers": {
            "contains": {
              "enum": [
                "DUOPlus1"
              ]
            }
          }
        }
      },
      "then": {
        "properties": {
          "SourceGeography": {
            "not": {
              "type": "null"
            }
          }
        },
        "required": [
          "SourceGeography"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "DataUseModifiers": {
            "contains": {
              "enum": [
                "DUOPlus2"
              ]
            }
          }
        }
      },
      "then": {
        "properties": {
          "PopulationType": {
            "not": {
              "type": "null"
            }
          }
        },
        "required": [
          "PopulationType"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "DataUseModifiers": {
            "contains": {
              "enum": [
                "DUOPlus3"
              ]
            }
          }
        }
      },
      "then": {
        "properties": {
          "DeidentificationType": {
            "not": {
              "type": "null"
            }
          }
        },
        "required": [
          "DeidentificationType"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "DataUseModifiers": {
            "contains": {
              "enum": [
                "DUOPlus4"
              ]
            }
          }
        }
      },
      "then": {
        "properties": {
          "DataPermission": {
            "not": {
              "type": "null"
            }
          }
        },
        "required": [
          "DataPermission"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "DataUseModifiers": {
            "contains": {
              "enum": [
                "DUOPlus5"
              ]
            }
          }
        }
      },
      "then": {
        "properties": {
          "DataTier": {
            "not": {
              "type": "null"
            }
          }
        },
        "required": [
          "DataTier"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "DataUseModifiers": {
            "contains": {
              "enum": [
                "DUOPlus6"
              ]
            }
          }
        }
      },
      "then": {
        "properties": {
          "License": {
            "not": {
              "type": "null"
            }
          }
        },
        "required": [
          "License"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "DataUseModifiers": {
            "contains": {
              "enum": [
                "DUOPlus7"
              ]
            }
          }
        }
      },
      "then": {
        "properties": {
          "Attribution": {
            "not": {
              "type": "null"
            }
          }
        },
        "required": [
          "Attribution"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "DataUseModifiers": {
            "contains": {
              "enum": [
                "GSR"
              ]
            }
          }
        }
      },
      "then": {
        "properties": {
          "GeographicalRestriction": {
            "not": {
              "type": "null"
            }
          }
        },
        "required": [
          "GeographicalRestriction"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "DataUseModifiers": {
            "contains": {
              "enum": [
                "IST"
              ]
            }
          }
        }
      },
      "then": {
        "properties": {
          "InstitutionSpecificRestriction": {
            "not": {
              "type": "null"
            }
          }
        },
        "required": [
          "InstitutionSpecificRestriction"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "DataUseModifiers": {
            "contains": {
              "enum": [
                "MOR"
              ]
            }
          }
        }
      },
      "then": {
        "properties": {
          "PublicationMoratorium": {
            "not": {
              "type": "null"
            }
          }
        },
        "required": [
          "PublicationMoratorium"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "DataUseModifiers": {
            "contains": {
              "enum": [
                "RST"
              ]
            }
          }
        }
      },
      "then": {
        "properties": {
          "ResearchSpecificRestrictions": {
            "not": {
              "type": "null"
            }
          }
        },
        "required": [
          "ResearchSpecificRestrictions"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "DataUseModifiers": {
            "contains": {
              "enum": [
                "TSM"
              ]
            }
          }
        }
      },
      "then": {
        "properties": {
          "TimeLimitOnUse": {
            "not": {
              "type": "null"
            }
          }
        },
        "required": [
          "TimeLimitOnUse"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "DataUseModifiers": {
            "contains": {
              "enum": [
                "USE"
              ]
            }
          }
        }
      },
      "then": {
        "properties": {
          "UserSpecificRestriction": {
            "not": {
              "type": "null"
            }
          }
        },
        "required": [
          "UserSpecificRestriction"
        ]
      }
    }
