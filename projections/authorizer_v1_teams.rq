# Projection (flag-gated stopgap, TEAMS=1): expand each acl:agentGroup grant
# into per-member grants, flattened team membership (plans/model_refactor.md
# decision 3). Written to a SEPARATE file (governance_graph_export/
# authorizer_v1_teams.ttl); it does not re-emit the team-level grant
# projections/authorizer_v1.rq already writes.
#
# Each flattened grant carries gov:viaTeam (the old-namespace team principal),
# and copies its source team grant's gov:bindingType exactly (Direct when the
# team's Authorization is on the entity's own benefactor, Inferred otherwise) --
# the projection does not re-derive Direct/Inferred itself. Same permission/
# ACCESS-derivation rule as authorizer_v1.rq.
#
# acl:agentClass grants (PUBLIC, AUTHENTICATED_USERS) have no vcard:hasMember,
# so this query emits nothing for them either; see authorizer_v1.rq's header and
# scripts/project.py's printed count.
PREFIX acl:   <http://www.w3.org/ns/auth/acl#>
PREFIX gov:   <https://w3id.org/synapse/governance#>
PREFIX old:   <https://sagebionetworks.org/governance/>
PREFIX skos:  <http://www.w3.org/2004/02/skos/core#>
PREFIX vcard: <http://www.w3.org/2006/vcard/ns#>
CONSTRUCT {
  ?e old:hasACL ?grant .
  ?grant a old:AccessGrant ;
         old:principal ?principal ;
         old:permission ?perm ;
         old:bindingType ?binding ;
         old:source old:Synapse ;
         old:viaTeam ?team .
}
WHERE {
  ?e gov:benefactor ?b .
  ?auth a acl:Authorization ; acl:default ?b ; acl:mode ?mode ; acl:agentGroup ?group .
  ?group vcard:hasMember ?member .
  ?mode skos:notation ?notation .
  BIND(REPLACE(STR(?member), "^.*[:/]", "") AS ?pid)
  BIND(REPLACE(STR(?group), "^.*[:/]", "") AS ?tid)
  BIND(IRI(CONCAT(STR(old:), "principal-", ?pid)) AS ?principal)
  BIND(IRI(CONCAT(STR(old:), "principal-", ?tid)) AS ?team)
  BIND(IRI(CONCAT(STR(old:), "grant-", STRAFTER(STR(?e), "Synapse:"), "-", ?pid, "-via-", ?tid)) AS ?grant)
  BIND(IF(?e = ?b, old:Direct, old:Inferred) AS ?binding)
  VALUES ?derived { false true }
  FILTER(!?derived || ?notation = "DOWNLOAD")
  BIND(IRI(CONCAT(STR(old:), IF(?derived, "ACCESS", ?notation))) AS ?perm)
}
