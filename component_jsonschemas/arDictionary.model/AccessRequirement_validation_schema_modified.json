  "description": "Representation of a Synapse Access Requirement and its relationships to entities, grants, and projects.",
  "properties": {
    "AccessRequirementId": {
      "description": "A unique identifier for the access requirement. This should be the numeric identifier of the access requirement.",
      "title": "AccessRequirement_id",
      "type": "string"
    },
    "ActivatedByAttribute": {
      "description": "The name of a Synapse annotation key that will be applied to entities released under this AR. Setting this attribute to activationValue designates that the AR should be active.",
      "oneOf": [
        {
          "title": "array",
          "type": "array"
        },
        {
          "title": "null",
          "type": "null"
        }
      ],
      "title": "activatedByAttribute"
    },
    "ActivationValue": {
      "description": "The value of Synapse annotation recorded under activatedByAttribute that will be applied to entities released under this AR to indicate the AR should be active",
      "oneOf": [
        {
          "title": "array",
          "type": "array"
        },
        {
          "title": "null",
          "type": "null"
        }
      ],
      "title": "activationValue"
    },
    "Attribution": {
      "description": "The attribution statement for the data associated with the access requirement. Equivalent to DUOPlus7.",
