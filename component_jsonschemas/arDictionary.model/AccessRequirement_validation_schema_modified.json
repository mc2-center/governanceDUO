      "title": "collaborationRequired"
    },
    "Component": {
      "description": "Category of metadata (e.g. Tools, Publications, etc.); provide the same one for all items/rows.",
      "title": "Component",
      "type": "string"
    },
    "ContributionDate": {
      "description": "The date on which the access requirement was added.",
      "title": "contributionDate",
      "type": "string"
    },
    "ContributorName": {
      "description": "The name of the person who added this access requirement.",
      "title": "contributorName",
      "type": "string"
    },
    "DataPermission": {
      "description": "The permissions associated with the data under the access requirement. Equivalent to DUOPlus4.",
      "oneOf": [
        {
          "items": {
            "enum": [
              "Agreement",
              "Attestation",
              "Award",
              "Other"
