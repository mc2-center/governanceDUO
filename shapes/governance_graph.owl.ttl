## governance_graph.owl.ttl
##
## Hand-authored TBox for the gov:/syn: namespace that scripts/build_governance_graph.py
## emits into governance_graph_export/governance_graph.ttl. NOT generated by gen-shacl /
## OwlSchemaGenerator like governance_duo.owl.ttl is: those generators produce
## governanceduo:-namespaced classes/properties straight from governance_graph.yaml,
## which is a different (and, for the ABox, unused) URI space than the deliberately
## bespoke gov:/syn: convention build_governance_graph.py targets to match the
## "SageBrain-Governance Graph Design" doc's own worked examples -- see that script's
## module docstring for why a generic dump wasn't used.
##
## This file exists for two reasons:
##   1. So gov:Team/gov:User have a common gov:Principal superclass to declare, as a
##      robustness net for tools that reason over rdfs:subClassOf -- though
##      build_governance_graph.py's add_principal() also asserts a bare gov:Principal
##      type directly on every individual now, so a plain SPARQL query for
##      `?x a gov:Principal` works even without loading this TBox.
##   2. So the gov: namespace is self-describing rather than "whatever the Python
##      script happens to emit," the same motivation build_owl.py has for stamping
##      reused DUO terms with extra annotations.
##
## gov:source is deliberately left as plain rdf:Property (not owl:ObjectProperty or
## owl:DatatypeProperty): governance_graph.yaml declares its range as a plain string,
## but the ABox mints an IRI per distinct source value instead (see gov:source below).
## gov:createdBy, by contrast, is a clean owl:ObjectProperty: SynapseEntity's raw
## Synapse user id is emitted under the separate gov:createdByUserId predicate instead
## (see that property's own comment), so gov:createdBy is never a literal.

@prefix gov: <https://sagebionetworks.org/governance/> .
@prefix syn: <https://www.synapse.org/Synapse:> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://sagebionetworks.org/governance/> a owl:Ontology ;
    rdfs:comment "TBox for governance_graph_export/governance_graph.ttl's gov:/syn: ABox convention. gov:AccessRequirement individuals (e.g. gov:AR-123) are stub reference nodes denoting the same real-world Access Requirement as a governanceduo:access_requirement.<n> individual in the governanceduo: namespace -- no owl:sameAs is asserted between the two ABoxes today; that cross-namespace link is not yet made explicit anywhere in this repo." .

#################################################################
# Classes
#################################################################

gov:SynapseEntity a owl:Class ;
    rdfs:comment "Mirrors governanceduo:SynapseEntity (governance_graph.yaml), re-declared here under gov:'s own namespace." .

gov:AccessGrant a owl:Class ;
    rdfs:comment "Mirrors governanceduo:AccessGrant." .

gov:AccessRequirementAssociation a owl:Class ;
    rdfs:comment "Mirrors governanceduo:AccessRequirementAssociation." .

gov:DataAccessSubmission a owl:Class ;
    rdfs:comment "Mirrors governanceduo:DataAccessSubmission. DataAccessSubmissionStatus has no class of its own here: its state/reason/createdBy/createdOn/modifiedBy/modifiedOn (as gov:statusCreatedBy/gov:statusCreatedOn/gov:statusModifiedBy/gov:statusModifiedOn) are merged onto this same individual, per governance_graph.yaml's own note that DataAccessSubmissionStatus has no independent identifier in Synapse's schema." .

gov:AccessRequirement a owl:Class ;
    rdfs:comment "Stub reference class for AccessRequirement individuals named from an AccessRequirementAssociation/DataAccessSubmission -- not the full governanceduo:AccessRequirement record." .

gov:Principal a owl:Class ;
    rdfs:comment "Mirrors governanceduo:Principal. Individuals are typed gov:Principal explicitly, plus gov:Team or gov:User (see below) matching the design doc's own worked examples." .

gov:Team a owl:Class ;
    rdfs:subClassOf gov:Principal .

gov:User a owl:Class ;
    rdfs:subClassOf gov:Principal .

#################################################################
# Properties
#################################################################

gov:resource a owl:ObjectProperty ;
    rdfs:range gov:SynapseEntity ;
    rdfs:comment "Domain: AccessGrant, AccessRequirementAssociation." .

gov:principal a owl:ObjectProperty ;
    rdfs:domain gov:AccessGrant ;
    rdfs:range gov:Principal .

gov:permission a owl:ObjectProperty ;
    rdfs:domain gov:AccessGrant ;
    rdfs:comment "Range: an AccessTypeEnum value minted as its own IRI, e.g. gov:DOWNLOAD -- not a literal, despite governanceduo:permission's range being a plain enum. See shapes/governance_graph.shacl.ttl's sh:in list for the closed vocabulary." .

gov:source a rdf:Property ;
    rdfs:comment "Range: an IRI, e.g. gov:Synapse -- governance_graph.yaml declares this slot's range as a plain string; the ABox mints an IRI per distinct source value instead." .

gov:bindingType a owl:ObjectProperty ;
    rdfs:comment "Range: a BindingTypeEnum value minted as its own IRI (gov:Direct or gov:Inherited)." .

gov:sourceAclId a owl:DatatypeProperty ;
    rdfs:domain gov:AccessGrant ;
    rdfs:range xsd:integer .

gov:sourceAclResourceAccessId a owl:DatatypeProperty ;
    rdfs:domain gov:AccessGrant ;
    rdfs:range xsd:integer .

gov:createdOn a owl:DatatypeProperty ;
    rdfs:range xsd:long ;
    rdfs:comment "Epoch milliseconds. Used by SynapseEntity, AccessGrant, and DataAccessSubmission." .

gov:createdBy a owl:ObjectProperty ;
    rdfs:range gov:Principal ;
    rdfs:comment "The submission's own creator, as an IRI reference to a gov:Principal node. Used by DataAccessSubmission; do not confuse with gov:statusCreatedBy below (the same submission's DataAccessSubmissionStatus row can have a different creator, e.g. an ACT reviewer) or gov:createdByUserId (a raw literal id, not a Principal reference)." .

gov:createdByUserId a owl:DatatypeProperty ;
    rdfs:domain gov:SynapseEntity ;
    rdfs:range xsd:integer ;
    rdfs:comment "A raw Synapse numeric user id (NODE.CREATED_BY), kept separate from the IRI-valued gov:createdBy so this property can be a clean, single-range owl:DatatypeProperty." .

gov:statusCreatedBy a owl:ObjectProperty ;
    rdfs:domain gov:DataAccessSubmission ;
    rdfs:range gov:Principal ;
    rdfs:comment "DataAccessSubmissionStatus's own creator (merged onto the DataAccessSubmission individual -- see gov:DataAccessSubmission's comment), as an IRI reference to a gov:Principal node. Distinct from gov:createdBy, which is the submission's own creator." .

gov:statusModifiedBy a owl:ObjectProperty ;
    rdfs:domain gov:DataAccessSubmission ;
    rdfs:range gov:Principal ;
    rdfs:comment "DataAccessSubmissionStatus's own last-modifier, as an IRI reference to a gov:Principal node." .

gov:statusCreatedOn a owl:DatatypeProperty ;
    rdfs:domain gov:DataAccessSubmission ;
    rdfs:range xsd:long ;
    rdfs:comment "DataAccessSubmissionStatus's own creation timestamp (epoch milliseconds). Distinct from gov:createdOn, the submission's own creation timestamp." .

gov:statusModifiedOn a owl:DatatypeProperty ;
    rdfs:domain gov:DataAccessSubmission ;
    rdfs:range xsd:long ;
    rdfs:comment "DataAccessSubmissionStatus's own last-modified timestamp (epoch milliseconds)." .

gov:accessRequirement a owl:ObjectProperty ;
    rdfs:range gov:AccessRequirement ;
    rdfs:comment "Used both for AccessRequirementAssociation's own accessRequirement slot and, by predicate reuse, for DataAccessSubmission's accessRequirementId slot -- governance_graph.yaml declares these as two differently-named slots; the ABox intentionally uses one predicate for both so 'what AccessRequirement does this concern?' is a uniform gov:accessRequirement query regardless of subject class." .

gov:state a owl:ObjectProperty ;
    rdfs:domain gov:DataAccessSubmission ;
    rdfs:comment "Range: a SubmissionStateEnum value minted as its own IRI (gov:SUBMITTED/APPROVED/REJECTED/CANCELLED)." .

gov:reason a owl:DatatypeProperty ;
    rdfs:domain gov:DataAccessSubmission ;
    rdfs:range xsd:string .

gov:principalId a owl:DatatypeProperty ;
    rdfs:domain gov:Principal ;
    rdfs:range xsd:integer .

gov:parentId a owl:ObjectProperty ;
    rdfs:domain gov:SynapseEntity ;
    rdfs:range gov:SynapseEntity .

gov:name a owl:DatatypeProperty ;
    rdfs:domain gov:SynapseEntity ;
    rdfs:range xsd:string .

gov:nodeType a owl:DatatypeProperty ;
    rdfs:domain gov:SynapseEntity ;
    rdfs:range xsd:string .

gov:etag a owl:DatatypeProperty ;
    rdfs:domain gov:SynapseEntity ;
    rdfs:range xsd:string .

gov:alias a owl:DatatypeProperty ;
    rdfs:domain gov:SynapseEntity ;
    rdfs:range xsd:string .

gov:currentRevNum a owl:DatatypeProperty ;
    rdfs:domain gov:SynapseEntity ;
    rdfs:range xsd:integer .

gov:maxRevNum a owl:DatatypeProperty ;
    rdfs:domain gov:SynapseEntity .

gov:hasACL a owl:ObjectProperty ;
    rdfs:domain gov:SynapseEntity ;
    rdfs:range gov:AccessGrant ;
    rdfs:comment "Derived convenience triple emitted by build_governance_graph.py alongside each AccessGrant; not its own governance_graph.yaml slot." .

gov:hasAccessRequirement a owl:ObjectProperty ;
    rdfs:domain gov:SynapseEntity ;
    rdfs:range gov:AccessRequirement ;
    rdfs:comment "Derived convenience triple emitted alongside each AccessRequirementAssociation; not its own governance_graph.yaml slot." .

gov:hasApproval a owl:ObjectProperty ;
    rdfs:domain gov:Principal ;
    rdfs:range gov:AccessRequirement ;
    rdfs:comment "Emitted only when the paired DataAccessSubmissionStatus.state is APPROVED -- mirrors the design doc's simplified gov:hasApproval predicate." .
