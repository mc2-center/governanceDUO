## governance_graph.owl.ttl
##
## Hand-authored TBox for the gov:/syn: namespace that scripts/build_governance_graph.py
## emits into governance_graph_export/governance_graph.ttl. NOT generated by gen-shacl /
## OwlSchemaGenerator like governance_duo.owl.ttl is: governance_graph.yaml's classes
## now declare class_uri/slot_uri pointing at this same sagegov: IRI space (so
## build_governance_graph.py resolves its predicates from the schema at runtime
## instead of hardcoding independent Python constants -- see that script's module
## docstring), and gen-owl/gen-shacl do pick those up (governance_duo.owl.ttl records
## them as skos:exactMatch annotations on the primary governanceduo: classes;
## shapes/governance_duo.shacl.ttl's sh:path entries use the sagegov: predicates
## directly). What neither generator can produce, and what this hand-authored file
## fills in, is the parts of the gov:/syn: ABox with no LinkML slot behind them at all
## (Principal's bare-integer id minting, the hasACL/hasAccessRequirement/hasApproval
## derived triples, the id-hyphenation display convention) -- see
## build_governance_graph.py's module docstring for the full list.
##
## This file exists for two reasons:
##   1. So gov:Team/gov:User have a common gov:Principal superclass to declare, as a
##      robustness net for tools that reason over rdfs:subClassOf -- though
##      build_governance_graph.py's add_principal() also asserts a bare gov:Principal
##      type directly on every individual now, so a plain SPARQL query for
##      `?x a gov:Principal` works even without loading this TBox.
##   2. So the gov: namespace is self-describing rather than "whatever the Python
##      script happens to emit," the same motivation build_owl.py has for stamping
##      reused DUO terms with extra annotations.
##
## gov:source is deliberately left as plain rdf:Property (not owl:ObjectProperty or
## owl:DatatypeProperty): governance_graph.yaml declares its range as a plain string,
## but the ABox mints an IRI per distinct source value instead (see gov:source below).
## gov:createdBy, by contrast, is a clean owl:ObjectProperty: SynapseEntity's raw
## Synapse user id is emitted under the separate gov:createdByUserId predicate instead
## (see that property's own comment), so gov:createdBy is never a literal.

@prefix gov: <https://sagebionetworks.org/governance/> .
@prefix syn: <https://www.synapse.org/Synapse:> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://sagebionetworks.org/governance/> a owl:Ontology ;
    rdfs:comment "TBox for governance_graph_export/governance_graph.ttl's gov:/syn: ABox convention. gov:AccessRequirement individuals (e.g. gov:AR-42) are stub reference nodes denoting the same real-world Access Requirement as a governanceduo:access_requirement.<n> individual in the governanceduo: namespace -- scripts/build_governance_graph.py asserts owl:sameAs between the two wherever an AccessRequirement stub node is minted (see add_access_requirement_association), so this cross-namespace identity is explicit in the exported ABox, not merely implied by naming convention." .

#################################################################
# Classes
#################################################################

gov:SynapseEntity a owl:Class ;
    rdfs:comment "Mirrors governanceduo:SynapseEntity (governance_graph.yaml), re-declared here under gov:'s own namespace." .

gov:AccessGrant a owl:Class ;
    rdfs:comment "Mirrors governanceduo:AccessGrant." .

gov:AccessRequirementAssociation a owl:Class ;
    rdfs:comment "Mirrors governanceduo:AccessRequirementAssociation." .

gov:DataAccessSubmission a owl:Class ;
    rdfs:comment "Mirrors governanceduo:DataAccessSubmission. DataAccessSubmissionStatus has no class of its own here: its state/rejectedReason/modifiedOn (the latter as gov:statusModifiedOn) are merged onto this same individual, per governance_graph.yaml's own note that DataAccessSubmissionStatus has no independent identifier in Synapse's schema. Field/predicate names throughout were corrected to match Synapse's live Submission/SubmissionStatus REST objects, not the original DATA_ACCESS_SUBMISSION(_STATUS) table-column guess -- see governance_graph.yaml's corrected descriptions on both classes." .

gov:AccessRequirement a owl:Class ;
    rdfs:comment "Stub reference class for AccessRequirement individuals named from an AccessRequirementAssociation/DataAccessSubmission -- not the full governanceduo:AccessRequirement record. Optionally has gov:hasCondition edges to gov:Condition individuals -- see scripts/build_governance_graph.py's add_access_requirement()." .

gov:Condition a owl:Class ;
    rdfs:comment "Mirrors governance_graph.yaml's Condition class: a single DUO-code-backed condition on an AccessRequirement, surfacing GovernanceMixin's dataUseModifiers/companion-slot data (already present in this repo's AccessRequirement examples) as a first-class node instead of leaving it invisible on the gov:AccessRequirement stub. Not is_a BaseEntity -- like DataAccessSubmissionStatus, it has no independent identifier of its own; it's keyed structurally by (AccessRequirement, duoCode)." .

gov:AccessApproval a owl:Class ;
    rdfs:comment "Mirrors governanceduo:AccessApproval -- a real, separate Synapse REST object from DataAccessSubmission/DataAccessSubmissionStatus (the workflow/audit trail that produces one). gov:hasApproval is re-derived from this class (status == APPROVED) as the primary source going forward; the existing DataAccessSubmissionStatus-derived edge is left as-is. See plans/governance_graph_open_questions.md Section B." .

gov:ResearchProject a owl:Class ;
    rdfs:comment "Mirrors governanceduo:ResearchProject. Replaces the bare researchProjectId FK integer literal DataAccessSubmission/DataAccessRequest previously carried with a real node + edge." .

gov:Site a owl:Class ;
    rdfs:comment "An institution real Synapse data associates with a ResearchProject or User-type Principal -- minted deterministically by slugifying a free-text institution/company name string (no stable Site id exists anywhere in Synapse's schema). See scripts/build_governance_graph.py's site_node_for()." .

gov:Principal a owl:Class ;
    rdfs:comment "Mirrors governanceduo:Principal. Individuals are typed gov:Principal explicitly, plus gov:Team or gov:User (see below) matching the design doc's own worked examples." .

gov:Team a owl:Class ;
    rdfs:subClassOf gov:Principal .

gov:User a owl:Class ;
    rdfs:subClassOf gov:Principal .

#################################################################
# Properties
#################################################################

gov:resource a owl:ObjectProperty ;
    rdfs:range gov:SynapseEntity ;
    rdfs:comment "Domain: AccessGrant, AccessRequirementAssociation." .

gov:principal a owl:ObjectProperty ;
    rdfs:domain gov:AccessGrant ;
    rdfs:range gov:Principal .

gov:permission a owl:ObjectProperty ;
    rdfs:domain gov:AccessGrant ;
    rdfs:comment "Range: an AccessTypeEnum value minted as its own IRI, e.g. gov:DOWNLOAD -- not a literal, despite governanceduo:permission's range being a plain enum. See shapes/governance_graph.shacl.ttl's sh:in list for the closed vocabulary." .

gov:source a rdf:Property ;
    rdfs:comment "Range: an IRI, e.g. gov:Synapse -- governance_graph.yaml declares this slot's range as a plain string; the ABox mints an IRI per distinct source value instead." .

gov:bindingType a owl:ObjectProperty ;
    rdfs:comment "Range: a BindingTypeEnum value minted as its own IRI (gov:Direct or gov:Inherited)." .

gov:sourceAclId a owl:DatatypeProperty ;
    rdfs:domain gov:AccessGrant ;
    rdfs:range xsd:integer .

gov:sourceAclResourceAccessId a owl:DatatypeProperty ;
    rdfs:domain gov:AccessGrant ;
    rdfs:range xsd:integer .

gov:createdOn a owl:DatatypeProperty ;
    rdfs:range xsd:long ;
    rdfs:comment "Epoch milliseconds. Used by SynapseEntity and AccessGrant. DataAccessSubmission uses gov:submittedOn instead -- Synapse's live Submission REST object names that field submittedOn, not createdOn (see governance_graph.yaml's corrected description)." .

gov:createdByUserId a owl:DatatypeProperty ;
    rdfs:domain gov:SynapseEntity ;
    rdfs:range xsd:integer ;
    rdfs:comment "A raw Synapse numeric user id (NODE.CREATED_BY)." .

gov:submittedBy a owl:ObjectProperty ;
    rdfs:domain gov:DataAccessSubmission ;
    rdfs:range gov:Principal ;
    rdfs:comment "The submission's own submitter, as an IRI reference to a gov:Principal node. Synapse's live Submission REST object names this field submittedBy, not createdBy (see governance_graph.yaml's corrected description). Do not confuse with gov:modifiedBy below (the same submission's status can later be modified by a different Principal, e.g. an ACT reviewer) or gov:createdByUserId (a raw literal id on SynapseEntity, not a Principal reference)." .

gov:submittedOn a owl:DatatypeProperty ;
    rdfs:domain gov:DataAccessSubmission ;
    rdfs:range xsd:long ;
    rdfs:comment "Epoch milliseconds. Synapse's live Submission REST object names this field submittedOn, not createdOn." .

gov:modifiedBy a owl:ObjectProperty ;
    rdfs:domain gov:DataAccessSubmission ;
    rdfs:range gov:Principal ;
    rdfs:comment "Who last modified this submission's status, as an IRI reference to a gov:Principal node. Synapse's live Submission REST object carries this field directly on Submission itself, not on DataAccessSubmissionStatus (which has no such field live) -- see governance_graph.yaml's corrected description." .

gov:statusModifiedOn a owl:DatatypeProperty ;
    rdfs:domain gov:DataAccessSubmission ;
    rdfs:range xsd:long ;
    rdfs:comment "DataAccessSubmissionStatus's own last-modified timestamp (epoch milliseconds) -- the one status/audit field Synapse's live SubmissionStatus REST object actually carries independently of Submission itself." .

gov:accessRequirement a owl:ObjectProperty ;
    rdfs:range gov:AccessRequirement ;
    rdfs:comment "Used both for AccessRequirementAssociation's own accessRequirement slot and, by predicate reuse, for DataAccessSubmission's accessRequirementId slot -- governance_graph.yaml declares these as two differently-named slots; the ABox intentionally uses one predicate for both so 'what AccessRequirement does this concern?' is a uniform gov:accessRequirement query regardless of subject class." .

gov:state a owl:ObjectProperty ;
    rdfs:domain gov:DataAccessSubmission ;
    rdfs:comment "Range: a SubmissionStateEnum value minted as its own IRI (gov:SUBMITTED/APPROVED/REJECTED/CANCELLED)." .

gov:rejectedReason a owl:DatatypeProperty ;
    rdfs:domain gov:DataAccessSubmission ;
    rdfs:range xsd:string ;
    rdfs:comment "Synapse's live SubmissionStatus REST object names this field rejectedReason, not reason (see governance_graph.yaml's corrected description)." .

gov:principalId a owl:DatatypeProperty ;
    rdfs:domain gov:Principal ;
    rdfs:range xsd:integer .

gov:parentId a owl:ObjectProperty ;
    rdfs:domain gov:SynapseEntity ;
    rdfs:range gov:SynapseEntity .

gov:name a owl:DatatypeProperty ;
    rdfs:domain gov:SynapseEntity ;
    rdfs:range xsd:string .

gov:nodeType a owl:DatatypeProperty ;
    rdfs:domain gov:SynapseEntity ;
    rdfs:range xsd:string .

gov:etag a owl:DatatypeProperty ;
    rdfs:domain gov:SynapseEntity ;
    rdfs:range xsd:string .

gov:alias a owl:DatatypeProperty ;
    rdfs:domain gov:SynapseEntity ;
    rdfs:range xsd:string .

gov:currentRevNum a owl:DatatypeProperty ;
    rdfs:domain gov:SynapseEntity ;
    rdfs:range xsd:integer .

gov:maxRevNum a owl:DatatypeProperty ;
    rdfs:domain gov:SynapseEntity .

gov:hasACL a owl:ObjectProperty ;
    rdfs:domain gov:SynapseEntity ;
    rdfs:range gov:AccessGrant ;
    rdfs:comment "Derived convenience triple emitted by build_governance_graph.py alongside each AccessGrant; not its own governance_graph.yaml slot." .

gov:hasAccessRequirement a owl:ObjectProperty ;
    rdfs:domain gov:SynapseEntity ;
    rdfs:range gov:AccessRequirement ;
    rdfs:comment "Derived convenience triple emitted alongside each AccessRequirementAssociation; not its own governance_graph.yaml slot." .

gov:hasApproval a owl:ObjectProperty ;
    rdfs:domain gov:Principal ;
    rdfs:range gov:AccessRequirement ;
    rdfs:comment "Emitted only when the paired DataAccessSubmissionStatus.state is APPROVED -- mirrors the design doc's simplified gov:hasApproval predicate." .

gov:hasCondition a owl:ObjectProperty ;
    rdfs:domain gov:AccessRequirement ;
    rdfs:range gov:Condition ;
    rdfs:comment "Derived convenience triple emitted alongside each Condition, same as gov:hasACL/gov:hasAccessRequirement above; not its own governance_graph.yaml slot (the real AccessRequirement class lives in access_requirement.yaml, which governance_graph.yaml imports -- not the other way around -- so a slot declared there could never range over Condition, defined here, without an import cycle). See scripts/build_governance_graph.py's add_access_requirement()." .

gov:conditionType a owl:DatatypeProperty ;
    rdfs:domain gov:Condition ;
    rdfs:range xsd:string ;
    rdfs:comment "The DUO code's own duo_shorthand annotation (e.g. \"GRU\", \"DS\") for the 24 real DUO codes; the bare DataUseModifierEnum key (e.g. \"DUOPlus1\") for the 7 Sage-local extensions, which have no duo_shorthand at all." .

gov:duoCode a owl:DatatypeProperty ;
    rdfs:domain gov:Condition ;
    rdfs:range xsd:string ;
    rdfs:comment "The real DUO CURIE (DataUseModifierEnum's meaning:), when one exists -- absent for the 7 Sage-local DUOPlus1-7 extensions." .

gov:description a owl:DatatypeProperty ;
    rdfs:domain gov:Condition ;
    rdfs:range xsd:string ;
    rdfs:comment "DataUseModifierEnum.permissible_values[code]'s own description: text, not re-authored." .

gov:conditionDetail a owl:DatatypeProperty ;
    rdfs:domain gov:Condition ;
    rdfs:range xsd:string ;
    rdfs:comment "Zero or more companion-slot values from the source AccessRequirement, one per GovernanceMixin.rules entry matching this Condition's duoCode -- see governance_graph.yaml and scripts/build_governance_graph.py's add_access_requirement()." .

gov:satisfies a owl:ObjectProperty ;
    rdfs:domain gov:AccessApproval ;
    rdfs:range gov:AccessRequirement ;
    rdfs:comment "AccessApproval.requirementId, mapped onto the target ontology's gov:satisfies -- distinct from gov:accessRequirement (used by AccessRequirementAssociation/DataAccessSubmission), since AccessApproval specifically represents satisfaction of a requirement." .

gov:requirementVersion a owl:DatatypeProperty ;
    rdfs:domain gov:AccessApproval ;
    rdfs:range xsd:integer .

gov:heldBy a owl:ObjectProperty ;
    rdfs:domain gov:AccessApproval ;
    rdfs:range gov:Principal ;
    rdfs:comment "AccessApproval.accessorId, mapped onto the target ontology's gov:heldBy." .

gov:status a owl:ObjectProperty ;
    rdfs:domain gov:AccessApproval ;
    rdfs:comment "Range: an ApprovalStateEnum value minted as its own IRI (gov:APPROVED/REVOKED) -- deliberately not gov:state, which is DataAccessSubmission's SubmissionStateEnum-valued predicate. Mapped onto the target ontology's gov:status." .

gov:expiresAt a owl:DatatypeProperty ;
    rdfs:domain gov:AccessApproval ;
    rdfs:range xsd:long ;
    rdfs:comment "AccessApproval.expiredOn, mapped onto the target ontology's gov:expiresAt -- the real field plans/rebac_governance_graph_alignment.md's first draft was wrong to call an unsourceable gap." .

gov:sourceApprovalId a owl:DatatypeProperty ;
    rdfs:domain gov:AccessApproval ;
    rdfs:range xsd:integer ;
    rdfs:comment "Traceability back to the literal AccessApproval.id row this record was derived from." .

gov:affiliatedWith a owl:ObjectProperty ;
    rdfs:range gov:Site ;
    rdfs:comment "Derived convenience triple emitted alongside a minted gov:Site node, same as gov:hasACL/gov:hasCondition above; not its own governance_graph.yaml slot. Domain: ResearchProject, DataAccessRequest, and User-type Principal (UserProfile.company has no Team equivalent). See scripts/build_governance_graph.py's site_node_for()." .

gov:institution a owl:DatatypeProperty ;
    rdfs:domain gov:Site ;
    rdfs:range xsd:string ;
    rdfs:comment "The Site node's own display name. On ResearchProject/DataAccessRequest, the same underlying string only drives a gov:affiliatedWith edge -- it is not independently re-emitted as a literal on those subjects." .

gov:projectLead a owl:DatatypeProperty ;
    rdfs:domain gov:ResearchProject ;
    rdfs:range xsd:string .

gov:intendedDataUseStatement a owl:DatatypeProperty ;
    rdfs:domain gov:ResearchProject ;
    rdfs:range xsd:string .

gov:createdBy a owl:ObjectProperty ;
    rdfs:range gov:Principal ;
    rdfs:comment "Who authored this record, as an IRI reference to a gov:Principal node. Used by ResearchProject and DataAccessRequest -- distinct from gov:submittedBy (the workflow-submission-action concept, used by DataAccessSubmission/AccessApproval) and gov:createdByUserId (a raw literal id, used by SynapseEntity)." .

gov:researchProject a owl:ObjectProperty ;
    rdfs:domain gov:DataAccessSubmission ;
    rdfs:range gov:ResearchProject ;
    rdfs:comment "DataAccessSubmission.researchProjectId -- now a real node (was a bare integer literal until ResearchProject existed)." .
