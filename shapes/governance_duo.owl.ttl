        governanceduo:GeographicalRegionEnum ;
    rdfs:label "VI" ;
    rdfs:subClassOf governanceduo:GeographicalRegionEnum ;
    skos:definition "Virgin Islands (U.S.)" .

<https://w3id.org/sage-bionetworks/governance-duo/GeographicalRegionEnum#VN> a owl:Class,
        governanceduo:GeographicalRegionEnum ;
    rdfs:label "VN" ;
    rdfs:subClassOf governanceduo:GeographicalRegionEnum ;
    skos:definition "Viet Nam" .

<https://w3id.org/sage-bionetworks/governance-duo/GeographicalRegionEnum#VU> a owl:Class,
        governanceduo:GeographicalRegionEnum ;
    rdfs:label "VU" ;
    rdfs:subClassOf governanceduo:GeographicalRegionEnum ;
    skos:definition "Vanuatu" .

<https://w3id.org/sage-bionetworks/governance-duo/GeographicalRegionEnum#WF> a owl:Class,
        governanceduo:GeographicalRegionEnum ;
    rdfs:label "WF" ;
    rdfs:subClassOf governanceduo:GeographicalRegionEnum ;
    skos:definition "Wallis and Futuna" .

<https://w3id.org/sage-bionetworks/governance-duo/GeographicalRegionEnum#WS> a owl:Class,
        governanceduo:GeographicalRegionEnum ;
    rdfs:label "WS" ;
    rdfs:subClassOf governanceduo:GeographicalRegionEnum ;
    skos:definition "Samoa" .

<https://w3id.org/sage-bionetworks/governance-duo/GeographicalRegionEnum#YE> a owl:Class,
        governanceduo:GeographicalRegionEnum ;
    rdfs:label "YE" ;
    rdfs:subClassOf governanceduo:GeographicalRegionEnum ;
    skos:definition "Yemen" .

<https://w3id.org/sage-bionetworks/governance-duo/GeographicalRegionEnum#YT> a owl:Class,
        governanceduo:GeographicalRegionEnum ;
    rdfs:label "YT" ;
    rdfs:subClassOf governanceduo:GeographicalRegionEnum ;
    skos:definition "Mayotte" .

<https://w3id.org/sage-bionetworks/governance-duo/GeographicalRegionEnum#ZA> a owl:Class,
        governanceduo:GeographicalRegionEnum ;
    rdfs:label "ZA" ;
    rdfs:subClassOf governanceduo:GeographicalRegionEnum ;
    skos:definition "South Africa" .

<https://w3id.org/sage-bionetworks/governance-duo/GeographicalRegionEnum#ZM> a owl:Class,
        governanceduo:GeographicalRegionEnum ;
    rdfs:label "ZM" ;
    rdfs:subClassOf governanceduo:GeographicalRegionEnum ;
    skos:definition "Zambia" .

<https://w3id.org/sage-bionetworks/governance-duo/GeographicalRegionEnum#ZW> a owl:Class,
        governanceduo:GeographicalRegionEnum ;
    rdfs:label "ZW" ;
    rdfs:subClassOf governanceduo:GeographicalRegionEnum ;
    skos:definition "Zimbabwe" .

<https://w3id.org/sage-bionetworks/governance-duo/LicenseEnum#Apache_2.0> a owl:Class,
        governanceduo:LicenseEnum ;
    rdfs:label "Apache_2.0" ;
    rdfs:subClassOf governanceduo:LicenseEnum ;
    skos:definition "Apache License 2.0, a permissive license allowing for use, modification, and distribution." .

<https://w3id.org/sage-bionetworks/governance-duo/LicenseEnum#BSD_3_Clause> a owl:Class,
        governanceduo:LicenseEnum ;
    rdfs:label "BSD_3_Clause" ;
    rdfs:subClassOf governanceduo:LicenseEnum ;
    skos:definition "BSD 3-Clause License, a permissive license allowing for use, modification, and distribution with attribution." .

<https://w3id.org/sage-bionetworks/governance-duo/LicenseEnum#CC0> a owl:Class,
        governanceduo:LicenseEnum ;
    rdfs:label "CC0" ;
    rdfs:subClassOf governanceduo:LicenseEnum ;
    skos:definition "Creative Commons Zero license, allowing for the free use of the data." .

<https://w3id.org/sage-bionetworks/governance-duo/LicenseEnum#CC_BY> a owl:Class,
        governanceduo:LicenseEnum ;
    rdfs:label "CC_BY" ;
    rdfs:subClassOf governanceduo:LicenseEnum ;
    skos:definition "Creative Commons Attribution license, requiring attribution to the original source." .

<https://w3id.org/sage-bionetworks/governance-duo/LicenseEnum#CC_BY_NC> a owl:Class,
        governanceduo:LicenseEnum ;
    rdfs:label "CC_BY_NC" ;
    rdfs:subClassOf governanceduo:LicenseEnum ;
    skos:definition "Creative Commons Attribution-NonCommercial license, allowing for non-commercial use with attribution." .

<https://w3id.org/sage-bionetworks/governance-duo/LicenseEnum#CC_BY_NC_ND> a owl:Class,
        governanceduo:LicenseEnum ;
    rdfs:label "CC_BY_NC_ND" ;
    rdfs:subClassOf governanceduo:LicenseEnum ;
    skos:definition "Creative Commons Attribution-NonCommercial-NoDerivatives license, allowing for non-commercial use with attribution but no modifications." .

<https://w3id.org/sage-bionetworks/governance-duo/LicenseEnum#CC_BY_NC_SA> a owl:Class,
        governanceduo:LicenseEnum ;
    rdfs:label "CC_BY_NC_SA" ;
    rdfs:subClassOf governanceduo:LicenseEnum ;
    skos:definition "Creative Commons Attribution-NonCommercial-ShareAlike license, allowing for non-commercial modifications with attribution and sharing under the same license." .

<https://w3id.org/sage-bionetworks/governance-duo/LicenseEnum#CC_BY_ND> a owl:Class,
        governanceduo:LicenseEnum ;
    rdfs:label "CC_BY_ND" ;
    rdfs:subClassOf governanceduo:LicenseEnum ;
    skos:definition "Creative Commons Attribution-NoDerivatives license, allowing for redistribution with attribution but no modifications." .

<https://w3id.org/sage-bionetworks/governance-duo/LicenseEnum#CC_BY_SA> a owl:Class,
        governanceduo:LicenseEnum ;
    rdfs:label "CC_BY_SA" ;
    rdfs:subClassOf governanceduo:LicenseEnum ;
    skos:definition "Creative Commons Attribution-ShareAlike license, allowing for modifications with attribution and sharing under the same license." .

<https://w3id.org/sage-bionetworks/governance-duo/LicenseEnum#GPL_3.0> a owl:Class,
        governanceduo:LicenseEnum ;
    rdfs:label "GPL_3.0" ;
    rdfs:subClassOf governanceduo:LicenseEnum ;
    skos:definition "GNU General Public License v3.0, a copyleft license requiring derivative works to be licensed under the same terms." .

<https://w3id.org/sage-bionetworks/governance-duo/LicenseEnum#MIT> a owl:Class,
        governanceduo:LicenseEnum ;
    rdfs:label "MIT" ;
    rdfs:subClassOf governanceduo:LicenseEnum ;
    skos:definition "MIT License, a permissive license allowing for use, modification, and distribution." .

<https://w3id.org/sage-bionetworks/governance-duo/PrincipalTypeEnum#Team> a owl:Class,
        governanceduo:PrincipalTypeEnum ;
    rdfs:label "Team" ;
    rdfs:subClassOf governanceduo:PrincipalTypeEnum .

<https://w3id.org/sage-bionetworks/governance-duo/PrincipalTypeEnum#User> a owl:Class,
        governanceduo:PrincipalTypeEnum ;
    rdfs:label "User" ;
    rdfs:subClassOf governanceduo:PrincipalTypeEnum .

governanceduo:ResearchProject a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "ResearchProject" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:createdOn ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:createdBy ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty governanceduo:accessRequirementId ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:etag ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:institution ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^research_project\\.\\d+$" ] ) ] ;
            owl:onProperty governanceduo:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:projectLead ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:intendedDataUseStatement ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty governanceduo:id ],
        governanceduo:BaseEntity ;
    skos:definition "Documents the research context/justification behind a DataAccessRequest (and, by extension, a DataAccessSubmission). Mirrors Synapse's real ResearchProject REST object (org.sagebionetworks.repo.model.dataaccess.ResearchProject), verified against rest-docs.synapse.org and the OpenAPI spec. Replaces the bare researchProjectId FK integer literal DataAccessSubmission previously carried with a real node + edge. See plans/governance_graph_open_questions.md Section C." ;
    skos:exactMatch sagegov:ResearchProject ;
    skos:inScheme governanceduo:governance_graph .

<https://w3id.org/sage-bionetworks/governance-duo/StudyIndexDateEnum#Birth%20Date> a owl:Class,
        governanceduo:StudyIndexDateEnum ;
    rdfs:label "Birth Date" ;
    rdfs:subClassOf governanceduo:StudyIndexDateEnum .

<https://w3id.org/sage-bionetworks/governance-duo/StudyIndexDateEnum#Collection%20Date> a owl:Class,
        governanceduo:StudyIndexDateEnum ;
    rdfs:label "Collection Date" ;
    rdfs:subClassOf governanceduo:StudyIndexDateEnum .

<https://w3id.org/sage-bionetworks/governance-duo/StudyIndexDateEnum#Diagnosis%20Date> a owl:Class,
        governanceduo:StudyIndexDateEnum ;
    rdfs:label "Diagnosis Date" ;
    rdfs:subClassOf governanceduo:StudyIndexDateEnum .

<https://w3id.org/sage-bionetworks/governance-duo/StudyIndexDateEnum#Enrollment%20Date> a owl:Class,
        governanceduo:StudyIndexDateEnum ;
    rdfs:label "Enrollment Date" ;
    rdfs:subClassOf governanceduo:StudyIndexDateEnum .

<https://w3id.org/sage-bionetworks/governance-duo/SubmissionStateEnum#APPROVED> a owl:Class,
        governanceduo:SubmissionStateEnum ;
    rdfs:label "APPROVED" ;
    rdfs:subClassOf governanceduo:SubmissionStateEnum .

<https://w3id.org/sage-bionetworks/governance-duo/SubmissionStateEnum#CANCELLED> a owl:Class,
        governanceduo:SubmissionStateEnum ;
    rdfs:label "CANCELLED" ;
    rdfs:subClassOf governanceduo:SubmissionStateEnum .

<https://w3id.org/sage-bionetworks/governance-duo/SubmissionStateEnum#REJECTED> a owl:Class,
        governanceduo:SubmissionStateEnum ;
    rdfs:label "REJECTED" ;
    rdfs:subClassOf governanceduo:SubmissionStateEnum .

<https://w3id.org/sage-bionetworks/governance-duo/SubmissionStateEnum#SUBMITTED> a owl:Class,
        governanceduo:SubmissionStateEnum ;
    rdfs:label "SUBMITTED" ;
    rdfs:subClassOf governanceduo:SubmissionStateEnum .

governanceduo:accessRequirementId a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "accessRequirementId" ;
    rdfs:range governanceduo:AccessRequirement ;
    skos:closeMatch dcterms:requires ;
    skos:definition "The AccessRequirement this submission is an application against (DATA_ACCESS_SUBMISSION.ACCESS_REQUIREMENT_ID)." ;
    skos:inScheme governanceduo:governance_graph ;
    skos:note "slot_uri intentionally reuses sagegov:accessRequirement, the same predicate AccessRequirementAssociation.accessRequirement uses, even though this is a differently-named LinkML slot -- so \"what AccessRequirement does this concern?\" is a uniform gov:accessRequirement query regardless of subject class. See scripts/build_governance_graph.py." .

governanceduo:approvedProjects a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "approvedProjects" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^did:[a-z0-9]+:.+$" ] ) ] ;
    skos:definition "DID(s) of project(s) approved to use the data under this access requirement. Added to close a Policy Fabric gap: project-specific-restriction keys its Reference Values Schema on a multivalued approvedProjects list of DIDs, which no existing slot held." ;
    skos:inScheme governanceduo:mixins ;
    skos:note "Required when dataUseModifiers contains DUO:0000027 — see GovernanceMixin rules." .

governanceduo:assetDid a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "assetDid" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^did:[a-z0-9]+:.+$" ] ) ] ;
    skos:definition "The Policy Fabric Asset-registry DID for synapseId." ;
    skos:inScheme governanceduo:mixins .

governanceduo:attribution a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "attribution" ;
    skos:closeMatch ebiswo:9000006 ;
    skos:definition "The attribution statement for the data associated with the access requirement. Equivalent to DUOPlus7." ;
    skos:inScheme governanceduo:mixins ;
    skos:note "Required when dataUseModifiers contains DUOPlus7 — see GovernanceMixin rules.",
        "SWO:9000006 \"Attribution clause\" (Software Ontology term, reused via the mcro ontology) — a license-clause-shaped close mapping; this slot instead holds the free-text statement itself, not the clause concept." .

governanceduo:bindingType a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "bindingType" ;
    rdfs:range governanceduo:BindingTypeEnum ;
    skos:inScheme governanceduo:governance_graph .

governanceduo:collaborationRequired a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "collaborationRequired" ;
    skos:definition "If collaboration is required for the access requirement, provide the PI email address. Provide multiple as a comma-separated list." ;
    skos:exactMatch NCIT:C221739 ;
    skos:inScheme governanceduo:mixins ;
    skos:note "NCIT:C221739 \"Consent for Use Requires Collaboration Agreement\" carries the synonyms \"COL\"/\"Collaboration required\", the same shorthand this repo already uses for DUO:0000020 — verified live and non-obsolete via the OLS4 API.",
        "Required when dataUseModifiers contains DUO:0000020 — see GovernanceMixin rules." .

governanceduo:currentRevNum a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "currentRevNum" ;
    rdfs:range linkml:Integer ;
    skos:definition "The current revision number of the record. Shared the same way as `name` above, by SynapseAccessRequirementMixin (ACCESS_REQUIREMENT.CURRENT_REV_NUM) and SynapseEntity (NODE.CURRENT_REV_NUM)." ;
    skos:inScheme governanceduo:mixins .

governanceduo:dataUseModifier a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "dataUseModifier" ;
    rdfs:range governanceduo:DataUseModifierEnum ;
    skos:definition "The DUO code (or Sage DUOPlus extension) this binding documents." ;
    skos:inScheme governanceduo:policy_fabric .

governanceduo:diseaseSpecificResearch a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "diseaseSpecificResearch" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "MONDO:\\d{7}" ] ) ] ;
    skos:definition "The type(s) of disease research allowed by this access requirement. Provide the MONDO ID in format MONDO:id. Provide multiple values as a comma-separated list. MONDO terms can be found here: https://ols.monarchinitiative.org/ontologies/mondo" ;
    skos:inScheme governanceduo:mixins ;
    skos:note "Required when dataUseModifiers contains DUO:0000007 — see GovernanceMixin rules." .

governanceduo:drsSelfUri a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "drsSelfUri" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^drs://.+$" ] ) ] ;
    skos:definition "The DRS DrsObject.self_uri — a hostname-based `drs://<hostname>/<drsId>` URI (DRS's other addressing style, compact-identifier URIs resolved via identifiers.org/n2t.net, is not used here since Synapse ids already resolve directly against a Synapse-operated DRS host)." ;
    skos:inScheme governanceduo:drs_alignment .

governanceduo:institution a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "institution" ;
    skos:definition "Institution/company name, verbatim from Synapse (ResearchProject.institution / DataAccessRequest.institution -- both real fields hold the same free-text shape as UserProfile.company above). On ResearchProject/DataAccessRequest, consumed by site_node_for() to derive a gov:affiliatedWith edge, not independently re-emitted; on Site itself, this is the node's own display name and IS emitted directly." ;
    skos:inScheme governanceduo:governance_graph .

governanceduo:institutionSpecificRestriction a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "institutionSpecificRestriction" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "ROR:[a-z0-9]{9}" ] ) ] ;
    skos:definition "Institutions with specific restrictions associated with the access requirement. Provide the institution ROR ID in format ROR:id. Provide multiple entries as a comma-separated list. ROR IDs can be found here: https://ror.org/search" ;
    skos:inScheme governanceduo:mixins ;
    skos:note "Required when dataUseModifiers contains DUO:0000028 — see GovernanceMixin rules." .

governanceduo:name a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "name" ;
    skos:definition "A Synapse-native display name. Shared by SynapseAccessRequirementMixin (ACCESS_REQUIREMENT.NAME) and, via the transitive import chain governance_graph.yaml -> access_requirement.yaml -> mixins.yaml, SynapseEntity (NODE.NAME) in governance_graph.yaml — defined once here rather than in governance_graph.yaml itself, since mixins.yaml cannot import governance_graph.yaml back without creating a cycle (governance_graph.yaml already depends on mixins.yaml through access_requirement.yaml)." ;
    skos:inScheme governanceduo:mixins .

governanceduo:nonprofitLegalForms a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "nonprofitLegalForms" ;
    skos:definition "Legal entity form(s) qualifying as not-for-profit, coded per ISO 20275:2017 (Entity Legal Form Code List). Added to close a Policy Fabric gap: not-for-profit-organisation-use-only and not-for-profit-non-commercial-use-only both key their Reference Values Schema on a multivalued nonprofitLegalForms list, which no existing slot held." ;
    skos:inScheme governanceduo:mixins ;
    skos:note "Required when dataUseModifiers contains DUO:0000045 or DUO:0000018 — see GovernanceMixin rules." .

governanceduo:notAfter a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "notAfter" ;
    skos:definition "ISO-8601 datetime after which use is no longer permitted. Added to close a Policy Fabric gap: time-limit-on-use's Reference Values Schema key notAfter is an absolute datetime, whereas the existing timeLimitOnUse slot holds a number of months — a different shape entirely, so this is a new, distinct slot." ;
    skos:inScheme governanceduo:mixins ;
    skos:note "Required when dataUseModifiers contains DUO:0000025 — see GovernanceMixin rules." .

governanceduo:policyContractDid a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "policyContractDid" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^did:[a-z0-9]+:.+$" ] ) ] ;
    skos:definition "The DID of the deployed rego_policy_agent/rego_token contract pair once this AccessRequirement's selected DUO codes have been \"exposed\" as a policy in Policy Fabric. Mirrors Asset.metadata.policy_contract." ;
    skos:inScheme governanceduo:mixins .

governanceduo:populationType a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "populationType" ;
    skos:definition "The population studied in the research associated with the access requirement. Equivalent to DUOPlus2." ;
    skos:inScheme governanceduo:mixins ;
    skos:note "Required when dataUseModifiers contains DUOPlus2 — see GovernanceMixin rules." .

governanceduo:publicationMoratorium a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "publicationMoratorium" ;
    skos:definition "End date of the publication moratorium associated with the access requirement." ;
    skos:inScheme governanceduo:mixins ;
    skos:note "Required when dataUseModifiers contains DUO:0000024 — see GovernanceMixin rules.",
        "schematic Format: date" .

governanceduo:researchSpecificRestrictions a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "researchSpecificRestrictions" ;
    skos:definition "Research-specific restrictions associated with the access requirement." ;
    skos:inScheme governanceduo:mixins ;
    skos:note "Required when dataUseModifiers contains DUO:0000012 — see GovernanceMixin rules." .

governanceduo:source a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "source" ;
    skos:definition "The system this grant/association was derived from, e.g. \"Synapse\"." ;
    skos:exactMatch dcterms:source ;
    skos:inScheme governanceduo:governance_graph .

governanceduo:timeLimitOnUse a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "timeLimitOnUse" ;
    rdfs:range linkml:Float ;
    skos:definition "Time limit on the use of the data associated with the access requirement." ;
    skos:inScheme governanceduo:mixins ;
    skos:note "Required when dataUseModifiers contains DUO:0000025 — see GovernanceMixin rules." .

governanceduo:userSpecificRestriction a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "userSpecificRestriction" ;
    skos:definition "The user-specific restrictions associated with the access requirement." ;
    skos:inScheme governanceduo:mixins ;
    skos:note "Required when dataUseModifiers contains DUO:0000026 — see GovernanceMixin rules." .

governanceduo:SynapseEntity a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "SynapseEntity" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:createdBy ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:currentRevNum ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:createdOn ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:maxRevNum ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty governanceduo:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:alias ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:nodeType ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^syn\\d+$" ] ) ] ;
            owl:onProperty governanceduo:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:parentId ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:etag ],
        governanceduo:BaseEntity ;
    skos:closeMatch prov:Entity ;
    skos:definition "A concrete Synapse entity (project, folder, file, etc.) that ACLs and Access Requirements attach to. Mirrors the NODE table. Deliberately separate from the Resource class: Resource represents a reusable resource-*type* pattern (e.g. \"mc2Res1\"), not a concrete entity instance with real parent/child structure." ;
    skos:exactMatch sagegov:SynapseEntity ;
    skos:inScheme governanceduo:governance_graph .

governanceduo:createdBy a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "createdBy" ;
    rdfs:range linkml:Integer ;
    skos:definition "Synapse numeric user id of the record's creator. Shared the same way as `name` above. Distinct from ContributionMixin's contributorName, which is this repo's own free-text curator-provenance field, not Synapse's own numeric CREATED_BY column — both coexist on AccessRequirement without collision." ;
    skos:exactMatch dcterms:creator ;
    skos:inScheme governanceduo:mixins ;
    skos:note "scripts/build_governance_graph.py emits this integer two different ways depending on which class it's on: as an IRI reference to a gov:Principal node (gov:createdBy) on DataAccessSubmission -- since a submission's creator can be looked up as a first-class Principal individual -- but as a plain literal (gov:createdByUserId, a distinct predicate, not gov:createdBy) on SynapseEntity, which has no corresponding Principal record to link to. This divergence is deliberate and documented in shapes/governance_graph.owl.ttl, not a schema/export mismatch to fix." .

governanceduo:AccessRequirement a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "AccessRequirement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty governanceduo:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^access_requirement\\.\\d+$" ] ) ] ;
            owl:onProperty governanceduo:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^syn\\d+$" ] ) ] ;
            owl:onProperty governanceduo:entityIdList ],
        governanceduo:BaseEntity,
        governanceduo:ContributionMixin,
        governanceduo:GovernanceMixin,
        governanceduo:PolicyFabricMixin,
        governanceduo:SynapseAccessRequirementMixin ;
    skos:definition "Representation of a Synapse Access Requirement and its relationships to entities, grants, and projects." ;
    skos:inScheme governanceduo:access_requirement .

governanceduo:allowedPurposes a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "allowedPurposes" ;
    skos:definition "Research purpose term(s) for which use is allowed. Added to close a Policy Fabric gap: genetic-studies-only, health-or-medical-or-biomedical-research, population-origins-or-ancestry-research-only, and research-specific-restrictions all key their Reference Values Schema on a multivalued allowedPurposes list; the existing researchSpecificRestrictions slot is free text and not multivalued, so this is a new, distinct slot rather than a reinterpretation of it (the two can coexist — one is a human-readable narrative, this one is the structured, machine-checkable list Policy Fabric's Rego logic actually reads)." ;
    skos:inScheme governanceduo:mixins ;
    skos:note "Required when dataUseModifiers contains DUO:0000016, DUO:0000006, DUO:0000011, or DUO:0000012 — see GovernanceMixin rules." .

governanceduo:synapseId a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "synapseId" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^syn\\d+$" ] ) ] ;
    skos:definition "A Synapse entity id. Reused across contexts that reference one specific Synapse entity: an AssetBinding registering it as a Policy Fabric Asset (this file), or a DrsObjectMapping crosswalking it to a DRS DrsObject (drs_alignment.yaml)." ;
    skos:inScheme governanceduo:mixins .

governanceduo:ApprovalStateEnum a owl:Class,
        linkml:EnumDefinition ;
    rdfs:label "ApprovalStateEnum" ;
    owl:unionOf ( <https://w3id.org/sage-bionetworks/governance-duo/ApprovalStateEnum#APPROVED> <https://w3id.org/sage-bionetworks/governance-duo/ApprovalStateEnum#REVOKED> ) ;
    skos:definition "Synapse's real AccessApproval state values (org.sagebionetworks.repo.model.ApprovalState), verified directly against the OpenAPI spec -- APPROVED/REVOKED only. A distinct, smaller enum from SubmissionStateEnum above; do not conflate the two even though both happen to include \"APPROVED\"." ;
    skos:inScheme governanceduo:governance_graph ;
    linkml:permissible_values <https://w3id.org/sage-bionetworks/governance-duo/ApprovalStateEnum#APPROVED>,
        <https://w3id.org/sage-bionetworks/governance-duo/ApprovalStateEnum#REVOKED> .

governanceduo:BindingTypeEnum a owl:Class,
        linkml:EnumDefinition ;
    rdfs:label "BindingTypeEnum" ;
    owl:unionOf ( <https://w3id.org/sage-bionetworks/governance-duo/BindingTypeEnum#Direct> <https://w3id.org/sage-bionetworks/governance-duo/BindingTypeEnum#Inherited> ) ;
    skos:definition "Whether a governance relationship (an AccessGrant or AccessRequirementAssociation) applies directly to a resource or is inherited from a parent (e.g. a file inheriting its parent study's Access Requirement) — from the design doc's own `gov:bindingType gov:Inherited` example. Not a Synapse database column; ACCESS_REQUIREMENT_PROJECT and the ACL tables record only the direct binding, so inheritance has to be resolved (via SynapseEntity.parentId) and recorded explicitly, per the design doc's \"Direct and Inherited Governance\" section." ;
    skos:inScheme governanceduo:governance_graph ;
    linkml:permissible_values <https://w3id.org/sage-bionetworks/governance-duo/BindingTypeEnum#Direct>,
        <https://w3id.org/sage-bionetworks/governance-duo/BindingTypeEnum#Inherited> .

governanceduo:PrincipalTypeEnum a owl:Class,
        linkml:EnumDefinition ;
    rdfs:label "PrincipalTypeEnum" ;
    owl:unionOf ( <https://w3id.org/sage-bionetworks/governance-duo/PrincipalTypeEnum#User> <https://w3id.org/sage-bionetworks/governance-duo/PrincipalTypeEnum#Team> ) ;
    skos:definition "Whether a Principal is an individual user or a team — from the design doc: \"Principals may represent either individual users or teams.\" ACL_RESOURCE_ACCESS.GROUP_ID itself doesn't distinguish the two; Synapse resolves that from the id's own type at runtime, so this is recorded explicitly here rather than inferred." ;
    skos:inScheme governanceduo:governance_graph ;
    linkml:permissible_values <https://w3id.org/sage-bionetworks/governance-duo/PrincipalTypeEnum#Team>,
        <https://w3id.org/sage-bionetworks/governance-duo/PrincipalTypeEnum#User> .

governanceduo:createdOn a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "createdOn" ;
    rdfs:range linkml:Integer ;
    skos:definition "When the record was created (epoch milliseconds in the source Synapse tables). Shared the same way as `name` above. Distinct from ContributionMixin's contributionDate for the same reason as createdBy above." ;
    skos:exactMatch dcterms:created ;
    skos:inScheme governanceduo:mixins .

governanceduo:etag a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "etag" ;
    skos:definition "Entity tag for optimistic concurrency control (a 36-character UUID). Shared the same way as `name` above, by SynapseAccessRequirementMixin (ACCESS_REQUIREMENT.ETAG) and SynapseEntity/DataAccessSubmission (NODE.ETAG/DATA_ACCESS_SUBMISSION.ETAG) in governance_graph.yaml." ;
    skos:inScheme governanceduo:mixins .

governanceduo:prohibitedPurposes a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "prohibitedPurposes" ;
    skos:definition "Research purpose term(s) for which use is explicitly disallowed. Added to close a Policy Fabric gap: health-or-medical-or-biomedical-research, no-general-methods-research, non-commercial-use-only, not-for-profit-non-commercial-use-only, and population-origins-or-ancestry-research-prohibited all key their Reference Values Schema on a multivalued prohibitedPurposes list, which no existing slot held." ;
    skos:inScheme governanceduo:mixins ;
    skos:note "Required when dataUseModifiers contains DUO:0000006, DUO:0000015, DUO:0000046, DUO:0000018, or DUO:0000044 — see GovernanceMixin rules." .

governanceduo:requiredAgreementDocumentId a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "requiredAgreementDocumentId" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^did:[a-z0-9]+:.+$" ] ) ] ;
    skos:definition "DID of the terms/agreement document the requester must accept before this access requirement's data use modifiers are satisfied. Added to close a Policy Fabric (https://github.com/hasan7n/tmp-policies) gap: its general-research-use, publication-moratorium, return-to-database-or-resource, and time-limit-on-use policy_cards all key their Reference Values Schema on a single requiredDocumentID, which no existing slot held — publicationMoratorium and timeLimitOnUse hold a date/duration, not a document identifier, so this is a new, distinct slot rather than a reinterpretation of either." ;
    skos:inScheme governanceduo:mixins ;
    skos:note "Required when dataUseModifiers contains DUO:0000042, DUO:0000024, DUO:0000029, or DUO:0000025 — see GovernanceMixin rules." .

governanceduo:DataPermissionEnum a owl:Class,
        linkml:EnumDefinition ;
    rdfs:label "DataPermissionEnum" ;
    owl:unionOf ( <https://w3id.org/sage-bionetworks/governance-duo/DataPermissionEnum#Agreement> <https://w3id.org/sage-bionetworks/governance-duo/DataPermissionEnum#Attestation> <https://w3id.org/sage-bionetworks/governance-duo/DataPermissionEnum#Award> <https://w3id.org/sage-bionetworks/governance-duo/DataPermissionEnum#Other> ) ;
    skos:inScheme governanceduo:mixins ;
    linkml:permissible_values <https://w3id.org/sage-bionetworks/governance-duo/DataPermissionEnum#Agreement>,
        <https://w3id.org/sage-bionetworks/governance-duo/DataPermissionEnum#Attestation>,
        <https://w3id.org/sage-bionetworks/governance-duo/DataPermissionEnum#Award>,
        <https://w3id.org/sage-bionetworks/governance-duo/DataPermissionEnum#Other> .

governanceduo:DataTierEnum a owl:Class,
        linkml:EnumDefinition ;
    rdfs:label "DataTierEnum" ;
    owl:unionOf ( <https://w3id.org/sage-bionetworks/governance-duo/DataTierEnum#Anonymous> <https://w3id.org/sage-bionetworks/governance-duo/DataTierEnum#Open> <https://w3id.org/sage-bionetworks/governance-duo/DataTierEnum#Controlled> <https://w3id.org/sage-bionetworks/governance-duo/DataTierEnum#Private> ) ;
    skos:inScheme governanceduo:mixins ;
    linkml:permissible_values <https://w3id.org/sage-bionetworks/governance-duo/DataTierEnum#Anonymous>,
        <https://w3id.org/sage-bionetworks/governance-duo/DataTierEnum#Controlled>,
        <https://w3id.org/sage-bionetworks/governance-duo/DataTierEnum#Open>,
        <https://w3id.org/sage-bionetworks/governance-duo/DataTierEnum#Private> .

governanceduo:DrsAuthTypeEnum a owl:Class,
        linkml:EnumDefinition ;
    rdfs:label "DrsAuthTypeEnum" ;
    owl:unionOf ( <https://w3id.org/sage-bionetworks/governance-duo/DrsAuthTypeEnum#None> <https://w3id.org/sage-bionetworks/governance-duo/DrsAuthTypeEnum#BasicAuth> <https://w3id.org/sage-bionetworks/governance-duo/DrsAuthTypeEnum#BearerAuth> <https://w3id.org/sage-bionetworks/governance-duo/DrsAuthTypeEnum#PassportAuth> ) ;
    skos:definition "Mirrors DRS's Authorizations.supported_types enum (https://ga4gh.github.io/data-repository-service-schemas/docs/). More than one can be supported and tried in sequence, per the DRS spec." ;
    skos:inScheme governanceduo:drs_alignment ;
    linkml:permissible_values <https://w3id.org/sage-bionetworks/governance-duo/DrsAuthTypeEnum#BasicAuth>,
        <https://w3id.org/sage-bionetworks/governance-duo/DrsAuthTypeEnum#BearerAuth>,
        <https://w3id.org/sage-bionetworks/governance-duo/DrsAuthTypeEnum#None>,
        <https://w3id.org/sage-bionetworks/governance-duo/DrsAuthTypeEnum#PassportAuth> .

governanceduo:StudyIndexDateEnum a owl:Class,
        linkml:EnumDefinition ;
    rdfs:label "StudyIndexDateEnum" ;
    owl:unionOf ( <https://w3id.org/sage-bionetworks/governance-duo/StudyIndexDateEnum#Diagnosis%20Date> <https://w3id.org/sage-bionetworks/governance-duo/StudyIndexDateEnum#Enrollment%20Date> <https://w3id.org/sage-bionetworks/governance-duo/StudyIndexDateEnum#Collection%20Date> <https://w3id.org/sage-bionetworks/governance-duo/StudyIndexDateEnum#Birth%20Date> ) ;
    skos:inScheme governanceduo:study ;
    linkml:permissible_values <https://w3id.org/sage-bionetworks/governance-duo/StudyIndexDateEnum#Birth%20Date>,
        <https://w3id.org/sage-bionetworks/governance-duo/StudyIndexDateEnum#Collection%20Date>,
        <https://w3id.org/sage-bionetworks/governance-duo/StudyIndexDateEnum#Diagnosis%20Date>,
        <https://w3id.org/sage-bionetworks/governance-duo/StudyIndexDateEnum#Enrollment%20Date> .

governanceduo:SubmissionStateEnum a owl:Class,
        linkml:EnumDefinition ;
    rdfs:label "SubmissionStateEnum" ;
    owl:unionOf ( <https://w3id.org/sage-bionetworks/governance-duo/SubmissionStateEnum#SUBMITTED> <https://w3id.org/sage-bionetworks/governance-duo/SubmissionStateEnum#APPROVED> <https://w3id.org/sage-bionetworks/governance-duo/SubmissionStateEnum#REJECTED> <https://w3id.org/sage-bionetworks/governance-duo/SubmissionStateEnum#CANCELLED> ) ;
    skos:definition "Synapse's real DataAccessSubmissionState values, verified via Sage-Bionetworks/SynapseWebClient source (ACTDataAccessSubmissionWidget.java's exhaustive state switch) — the \"sagebrain governance graph ACL_AR data - AR table schemas.csv\" only says DATA_ACCESS_SUBMISSION_STATUS.STATE is TEXT, with no NOTES-column value list." ;
    skos:inScheme governanceduo:governance_graph ;
    linkml:permissible_values <https://w3id.org/sage-bionetworks/governance-duo/SubmissionStateEnum#APPROVED>,
        <https://w3id.org/sage-bionetworks/governance-duo/SubmissionStateEnum#CANCELLED>,
        <https://w3id.org/sage-bionetworks/governance-duo/SubmissionStateEnum#REJECTED>,
        <https://w3id.org/sage-bionetworks/governance-duo/SubmissionStateEnum#SUBMITTED> .

governanceduo:BaseEntity a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "BaseEntity" ;
    rdfs:subClassOf [ owl:unionOf ( governanceduo:AccessApproval governanceduo:AccessGrant governanceduo:AccessRequirement governanceduo:AccessRequirementAssociation governanceduo:DataAccessSubmission governanceduo:ResearchProject governanceduo:Resource governanceduo:Schema governanceduo:Study governanceduo:SynapseEntity ) ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty governanceduo:id ] ;
    skos:definition "Abstract root shared by every governanceDUO class." ;
    skos:inScheme governanceduo:base_entity .

governanceduo:AccessRequirementConcreteTypeEnum a owl:Class,
        linkml:EnumDefinition ;
    rdfs:label "AccessRequirementConcreteTypeEnum" ;
    owl:unionOf ( <https://w3id.org/sage-bionetworks/governance-duo/AccessRequirementConcreteTypeEnum#TermsOfUseAccessRequirement> <https://w3id.org/sage-bionetworks/governance-duo/AccessRequirementConcreteTypeEnum#SelfSignAccessRequirement> <https://w3id.org/sage-bionetworks/governance-duo/AccessRequirementConcreteTypeEnum#ACTAccessRequirement> <https://w3id.org/sage-bionetworks/governance-duo/AccessRequirementConcreteTypeEnum#ManagedACTAccessRequirement> <https://w3id.org/sage-bionetworks/governance-duo/AccessRequirementConcreteTypeEnum#LockAccessRequirement> ) ;
    skos:definition "Synapse's real AccessRequirement subclasses, verified via Sage-Bionetworks/Synapse-Repository-Services's AccessRequirementType.java (lib/jdomodels/.../org/sagebionetworks/repo/model/ar/AccessRequirementType.java). Permissible values use the short Java class name; the actual ACCESS_REQUIREMENT.CONCRETE_TYPE column stores the fully-qualified name (e.g. \"org.sagebionetworks.repo.model.ManagedACTAccessRequirement\")." ;
    skos:inScheme governanceduo:mixins ;
    linkml:permissible_values <https://w3id.org/sage-bionetworks/governance-duo/AccessRequirementConcreteTypeEnum#ACTAccessRequirement>,
        <https://w3id.org/sage-bionetworks/governance-duo/AccessRequirementConcreteTypeEnum#LockAccessRequirement>,
        <https://w3id.org/sage-bionetworks/governance-duo/AccessRequirementConcreteTypeEnum#ManagedACTAccessRequirement>,
        <https://w3id.org/sage-bionetworks/governance-duo/AccessRequirementConcreteTypeEnum#SelfSignAccessRequirement>,
        <https://w3id.org/sage-bionetworks/governance-duo/AccessRequirementConcreteTypeEnum#TermsOfUseAccessRequirement> .

governanceduo:DeidentificationTypeEnum a owl:Class,
        linkml:EnumDefinition ;
    rdfs:label "DeidentificationTypeEnum" ;
    owl:unionOf ( <https://w3id.org/sage-bionetworks/governance-duo/DeidentificationTypeEnum#HIPPA_LDS> <https://w3id.org/sage-bionetworks/governance-duo/DeidentificationTypeEnum#SafeHarbor> <https://w3id.org/sage-bionetworks/governance-duo/DeidentificationTypeEnum#ExpertDetermination> <https://w3id.org/sage-bionetworks/governance-duo/DeidentificationTypeEnum#Pseudonymized> <https://w3id.org/sage-bionetworks/governance-duo/DeidentificationTypeEnum#Anonymized> <https://w3id.org/sage-bionetworks/governance-duo/DeidentificationTypeEnum#Other> ) ;
    skos:definition "De-identification method categories. Shared by Study.studyDeidentificationType and the shared/GovernanceMixin deidentificationType slot (DUOPlus3) — the source CSV duplicated this same value list under both attributes; this schema keeps one enum and points both slots at it." ;
    skos:inScheme governanceduo:props ;
    linkml:permissible_values <https://w3id.org/sage-bionetworks/governance-duo/DeidentificationTypeEnum#Anonymized>,
        <https://w3id.org/sage-bionetworks/governance-duo/DeidentificationTypeEnum#ExpertDetermination>,
        <https://w3id.org/sage-bionetworks/governance-duo/DeidentificationTypeEnum#HIPPA_LDS>,
        <https://w3id.org/sage-bionetworks/governance-duo/DeidentificationTypeEnum#Other>,
        <https://w3id.org/sage-bionetworks/governance-duo/DeidentificationTypeEnum#Pseudonymized>,
        <https://w3id.org/sage-bionetworks/governance-duo/DeidentificationTypeEnum#SafeHarbor> .

governanceduo:resource a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "resource" ;
    rdfs:range governanceduo:SynapseEntity ;
    skos:definition "The SynapseEntity this grant/association applies to." ;
    skos:inScheme governanceduo:governance_graph .

governanceduo:id a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "id" ;
    skos:definition "A unique identifier for this record. Narrowed per class via `slot_usage` in access_requirement.yaml/resource.yaml/schema.yaml/study.yaml/governance_graph.yaml (SynapseEntity/AccessGrant/AccessRequirementAssociation/DataAccessSubmission). The schematic CSV source (../model/*.model.csv) keeps class-prefixed attribute names (AccessRequirement_id, Resource_id, Schema_id, Study_id) instead: schematic's model CSV has one flat, global Attribute namespace with no per-class scoping equivalent to slot_usage, so four classes cannot share a bare \"id\" attribute there without colliding." ;
    skos:inScheme governanceduo:base_entity .

governanceduo:LicenseEnum a owl:Class,
        linkml:EnumDefinition ;
    rdfs:label "LicenseEnum" ;
    owl:unionOf ( <https://w3id.org/sage-bionetworks/governance-duo/LicenseEnum#CC0> <https://w3id.org/sage-bionetworks/governance-duo/LicenseEnum#CC_BY> <https://w3id.org/sage-bionetworks/governance-duo/LicenseEnum#CC_BY_NC> <https://w3id.org/sage-bionetworks/governance-duo/LicenseEnum#CC_BY_ND> <https://w3id.org/sage-bionetworks/governance-duo/LicenseEnum#CC_BY_SA> <https://w3id.org/sage-bionetworks/governance-duo/LicenseEnum#CC_BY_NC_ND> <https://w3id.org/sage-bionetworks/governance-duo/LicenseEnum#CC_BY_NC_SA> <https://w3id.org/sage-bionetworks/governance-duo/LicenseEnum#Apache_2.0> <https://w3id.org/sage-bionetworks/governance-duo/LicenseEnum#MIT> <https://w3id.org/sage-bionetworks/governance-duo/LicenseEnum#GPL_3.0> <https://w3id.org/sage-bionetworks/governance-duo/LicenseEnum#BSD_3_Clause> ) ;
    skos:definition "model/shared.model.csv's license Valid Values list Apache_2.0/GPL_3.0; the standalone CV reference model/valid_values.csv previously documented Apache_2/GPL_3 (no \".0\"/\"3.0\" suffix) for the same two licenses -- that mismatch has been fixed (valid_values.csv now matches shared.model.csv's spelling, the attribute's actual schematic Valid Values)." ;
    skos:inScheme governanceduo:mixins ;
    linkml:permissible_values <https://w3id.org/sage-bionetworks/governance-duo/LicenseEnum#Apache_2.0>,
        <https://w3id.org/sage-bionetworks/governance-duo/LicenseEnum#BSD_3_Clause>,
        <https://w3id.org/sage-bionetworks/governance-duo/LicenseEnum#CC0>,
        <https://w3id.org/sage-bionetworks/governance-duo/LicenseEnum#CC_BY>,
        <https://w3id.org/sage-bionetworks/governance-duo/LicenseEnum#CC_BY_NC>,
        <https://w3id.org/sage-bionetworks/governance-duo/LicenseEnum#CC_BY_NC_ND>,
        <https://w3id.org/sage-bionetworks/governance-duo/LicenseEnum#CC_BY_NC_SA>,
        <https://w3id.org/sage-bionetworks/governance-duo/LicenseEnum#CC_BY_ND>,
        <https://w3id.org/sage-bionetworks/governance-duo/LicenseEnum#CC_BY_SA>,
        <https://w3id.org/sage-bionetworks/governance-duo/LicenseEnum#GPL_3.0>,
        <https://w3id.org/sage-bionetworks/governance-duo/LicenseEnum#MIT> .

governanceduo:CredentialTypeEnum a owl:Class,
        linkml:EnumDefinition ;
    rdfs:label "CredentialTypeEnum" ;
    owl:unionOf ( <https://w3id.org/sage-bionetworks/governance-duo/CredentialTypeEnum#AffiliationCredential> <https://w3id.org/sage-bionetworks/governance-duo/CredentialTypeEnum#LocationCredential> <https://w3id.org/sage-bionetworks/governance-duo/CredentialTypeEnum#publicKeyCredential> <https://w3id.org/sage-bionetworks/governance-duo/CredentialTypeEnum#AgreementCredential> <https://w3id.org/sage-bionetworks/governance-duo/CredentialTypeEnum#ComputeEnvironmentCredential> <https://w3id.org/sage-bionetworks/governance-duo/CredentialTypeEnum#EmailCredential> <https://w3id.org/sage-bionetworks/governance-duo/CredentialTypeEnum#EthicsCommitteeAccreditationCredential> <https://w3id.org/sage-bionetworks/governance-duo/CredentialTypeEnum#IRBApprovalCredential> <https://w3id.org/sage-bionetworks/governance-duo/CredentialTypeEnum#IntendedDataUseCredential> <https://w3id.org/sage-bionetworks/governance-duo/CredentialTypeEnum#LegalDesignationCredential> <https://w3id.org/sage-bionetworks/governance-duo/CredentialTypeEnum#ProjectOwnershipCredential> <https://w3id.org/sage-bionetworks/governance-duo/CredentialTypeEnum#ScopedAgreementCredential> <https://w3id.org/sage-bionetworks/governance-duo/CredentialTypeEnum#TeamCredential> <https://w3id.org/sage-bionetworks/governance-duo/CredentialTypeEnum#UserPlatformCredential> <https://w3id.org/sage-bionetworks/governance-duo/CredentialTypeEnum#WalletVerifyingKeyCredential> ) ;
    skos:definition "The 15 Verifiable Credential types defined in tmp-policies/credentials/*.schema.json." ;
    skos:inScheme governanceduo:policy_fabric ;
    linkml:permissible_values <https://w3id.org/sage-bionetworks/governance-duo/CredentialTypeEnum#AffiliationCredential>,
        <https://w3id.org/sage-bionetworks/governance-duo/CredentialTypeEnum#AgreementCredential>,
        <https://w3id.org/sage-bionetworks/governance-duo/CredentialTypeEnum#ComputeEnvironmentCredential>,
        <https://w3id.org/sage-bionetworks/governance-duo/CredentialTypeEnum#EmailCredential>,
        <https://w3id.org/sage-bionetworks/governance-duo/CredentialTypeEnum#EthicsCommitteeAccreditationCredential>,
        <https://w3id.org/sage-bionetworks/governance-duo/CredentialTypeEnum#IRBApprovalCredential>,
        <https://w3id.org/sage-bionetworks/governance-duo/CredentialTypeEnum#IntendedDataUseCredential>,
        <https://w3id.org/sage-bionetworks/governance-duo/CredentialTypeEnum#LegalDesignationCredential>,
        <https://w3id.org/sage-bionetworks/governance-duo/CredentialTypeEnum#LocationCredential>,
        <https://w3id.org/sage-bionetworks/governance-duo/CredentialTypeEnum#ProjectOwnershipCredential>,
        <https://w3id.org/sage-bionetworks/governance-duo/CredentialTypeEnum#ScopedAgreementCredential>,
        <https://w3id.org/sage-bionetworks/governance-duo/CredentialTypeEnum#TeamCredential>,
        <https://w3id.org/sage-bionetworks/governance-duo/CredentialTypeEnum#UserPlatformCredential>,
        <https://w3id.org/sage-bionetworks/governance-duo/CredentialTypeEnum#WalletVerifyingKeyCredential>,
        <https://w3id.org/sage-bionetworks/governance-duo/CredentialTypeEnum#publicKeyCredential> .

governanceduo:dataUseModifiers a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "dataUseModifiers" ;
    rdfs:range governanceduo:DataUseModifierEnum ;
    skos:definition "A list of data use modifiers that apply to the access requirement. Includes real Data Use Ontology (DUO) terms plus Sage-local DUOPlus1-7 extensions (see README) and the literal value \"Pending Annotation\"." ;
    skos:inScheme governanceduo:mixins .

governanceduo:AccessTypeEnum a owl:Class,
        linkml:EnumDefinition ;
    rdfs:label "AccessTypeEnum" ;
    owl:unionOf ( <https://w3id.org/sage-bionetworks/governance-duo/AccessTypeEnum#CREATE> <https://w3id.org/sage-bionetworks/governance-duo/AccessTypeEnum#READ> <https://w3id.org/sage-bionetworks/governance-duo/AccessTypeEnum#UPDATE> <https://w3id.org/sage-bionetworks/governance-duo/AccessTypeEnum#DELETE> <https://w3id.org/sage-bionetworks/governance-duo/AccessTypeEnum#CHANGE_PERMISSIONS> <https://w3id.org/sage-bionetworks/governance-duo/AccessTypeEnum#DOWNLOAD> <https://w3id.org/sage-bionetworks/governance-duo/AccessTypeEnum#UPLOAD> <https://w3id.org/sage-bionetworks/governance-duo/AccessTypeEnum#PARTICIPATE> <https://w3id.org/sage-bionetworks/governance-duo/AccessTypeEnum#SUBMIT> <https://w3id.org/sage-bionetworks/governance-duo/AccessTypeEnum#READ_PRIVATE_SUBMISSION> <https://w3id.org/sage-bionetworks/governance-duo/AccessTypeEnum#UPDATE_SUBMISSION> <https://w3id.org/sage-bionetworks/governance-duo/AccessTypeEnum#DELETE_SUBMISSION> <https://w3id.org/sage-bionetworks/governance-duo/AccessTypeEnum#TEAM_MEMBERSHIP_UPDATE> <https://w3id.org/sage-bionetworks/governance-duo/AccessTypeEnum#SEND_MESSAGE> <https://w3id.org/sage-bionetworks/governance-duo/AccessTypeEnum#CHANGE_SETTINGS> <https://w3id.org/sage-bionetworks/governance-duo/AccessTypeEnum#MODERATE> <https://w3id.org/sage-bionetworks/governance-duo/AccessTypeEnum#REVIEW_SUBMISSIONS> <https://w3id.org/sage-bionetworks/governance-duo/AccessTypeEnum#EXEMPTION_ELIGIBLE> ) ;
    skos:definition "Synapse's real ACCESS_TYPE values, verified live via rest-docs.synapse.org (not inferred from the \"sagebrain governance graph ACL_AR data\" CSVs alone, which only name a handful of these as examples in a free-text NOTES column). Shared by AccessGrant.permission (an ACL grant's permission — ACL_RESOURCE_ACCESS_TYPE.STRING_ELE) in governance_graph.yaml and this file's own accessType slot (ACCESS_REQUIREMENT.ACCESS_TYPE) — the same underlying Synapse type in both places." ;
    skos:inScheme governanceduo:mixins ;
