governanceduo:SchemaKey a owl:DatatypeProperty ;
    rdfs:label "SchemaKey" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^schema\\.[A-Za-z0-9_-]+$" ] ) ] ;
    skos:definition "The Schema id corresponding to a registered JSON schema that describes the access conditions relevant to this Resource." ;
    skos:inScheme governanceduo:governance_duo ;
    skos:note "Untyped string, not range: Schema -- see props.yaml's AccessRequirementKey comment for why (this file cannot import schema.yaml without risking a cycle). The pattern below (matching Schema.id's own slot_usage pattern in schema.yaml) is the cycle-free substitute. See plans/identifier_update.md." ;
    governanceduo:foreign_key true .

governanceduo:SourceSystemEnum a owl:Class ;
    rdfs:label "SourceSystemEnum" ;
    skos:definition "The system a governance relationship (AccessGrant, AccessRequirementAssociation) was derived from. Each value's meaning: is the gov: IRI scripts/build_governance_graph.py emits for gov:source, so this schema describes the graph as built. Only values the sync and examples actually produce are listed; the design doc's gov:SynapseACL (an ACL-specific source) is not used by this repo's pipeline and isn't declared." ;
    skos:inScheme governanceduo:governance_duo ;
    linkml:permissible_values sagegov:Synapse .

governanceduo:assetDid a owl:DatatypeProperty ;
    rdfs:label "assetDid" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^did:[a-z0-9]+:.+$" ] ) ] ;
    skos:definition "The Policy Fabric Asset-registry DID for synapseId." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:createdBy a owl:DatatypeProperty ;
    rdfs:label "createdBy" ;
    rdfs:range xsd:integer ;
    skos:definition "Synapse numeric user id of the record's creator. Shared the same way as `name` above. Distinct from ContributionMixin's contributorName, which is this repo's own free-text curator-provenance field, not Synapse's own numeric CREATED_BY column — both coexist on AccessRequirement without collision." ;
    skos:exactMatch dcterms:creator ;
    skos:inScheme governanceduo:governance_duo ;
    skos:note "scripts/build_governance_graph.py emits this integer two different ways depending on which class it's on: as an IRI reference to a gov:Principal node (gov:createdBy) on DataAccessSubmission -- since a submission's creator can be looked up as a first-class Principal individual -- but as a plain literal (gov:createdByUserId, a distinct predicate, not gov:createdBy) on SynapseEntity, which has no corresponding Principal record to link to. This divergence is deliberate and documented in shapes/governance_graph.owl.ttl, not a schema/export mismatch to fix." .

governanceduo:dataUseModifier a owl:ObjectProperty ;
    rdfs:label "dataUseModifier" ;
    rdfs:range governanceduo:DataUseModifierEnum ;
    skos:definition "The DUO code (or Sage DUOPlus extension) this binding documents." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:drsSelfUri a owl:DatatypeProperty ;
    rdfs:label "drsSelfUri" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^drs://.+$" ] ) ] ;
    skos:definition "The DRS DrsObject.self_uri — a hostname-based `drs://<hostname>/<drsId>` URI (DRS's other addressing style, compact-identifier URIs resolved via identifiers.org/n2t.net, is not used here since Synapse ids already resolve directly against a Synapse-operated DRS host)." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:etag a owl:DatatypeProperty ;
    rdfs:label "etag" ;
    skos:definition "Entity tag for optimistic concurrency control (a 36-character UUID). Shared the same way as `name` above, by SynapseAccessRequirementMixin (ACCESS_REQUIREMENT.ETAG) and SynapseEntity/DataAccessSubmission (NODE.ETAG/DATA_ACCESS_SUBMISSION.ETAG) in governance_graph.yaml." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:modifiedBy a owl:DatatypeProperty ;
    rdfs:label "modifiedBy" .

governanceduo:policyContractDid a owl:DatatypeProperty ;
    rdfs:label "policyContractDid" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^did:[a-z0-9]+:.+$" ] ) ] ;
    skos:definition "The DID of the deployed rego_policy_agent/rego_token contract pair once this AccessRequirement's selected DUO codes have been \"exposed\" as a policy in Policy Fabric. Mirrors Asset.metadata.policy_contract." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:referencedRequirementId a owl:DatatypeProperty ;
    rdfs:label "referencedRequirementId" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                        owl:onDatatype xsd:string ;
                        owl:withRestrictions ( [ xsd:pattern "^access_requirement\\.\\d+$" ] ) ] ) ] ;
    skos:definition "The id of the real AccessRequirement record this gov:AR-<n> stub stands in for (e.g. access_requirement.42) -- the stub's key. As a LinkML identifier it names the node rather than adding a triple: scripts/build_governance_graph.py mints the stub's IRI from it via gov_id() (access_requirement.42 -> gov:AR-42) and bridges it to the real record with sameAs." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:requiredAgreementDocumentId a owl:DatatypeProperty ;
    rdfs:label "requiredAgreementDocumentId" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^did:[a-z0-9]+:.+$" ] ) ] ;
    skos:definition "DID of the terms/agreement document the requester must accept before this access requirement's data use modifiers are satisfied. Added to close a Policy Fabric (https://github.com/hasan7n/tmp-policies) gap: its general-research-use, publication-moratorium, return-to-database-or-resource, and time-limit-on-use policy_cards all key their Reference Values Schema on a single requiredDocumentID, which no existing slot held — publicationMoratorium and timeLimitOnUse hold a date/duration, not a document identifier, so this is a new, distinct slot rather than a reinterpretation of either." ;
    skos:inScheme governanceduo:governance_duo ;
    skos:note "Required when dataUseModifiers contains DUO:0000042, DUO:0000024, DUO:0000029, or DUO:0000025 — see GovernanceMixin rules." .

xsd:float a rdfs:Datatype .

sagegov:Program a owl:Class ;
    rdfs:label "Program" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sagegov:name ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dcterms:identifier ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^program\\.[A-Za-z0-9_-]+$" ] ) ] ;
            owl:onProperty dcterms:identifier ],
        governanceduo:BaseEntity ;
    skos:definition "A multi-site research consortium (e.g. AD Knowledge Portal, NF-OSI). **Honest grounding note**: no real Synapse or repo data source exists for Program-level grouping -- ships as structural capability with one clearly-illustrative example instance, the same treatment thomasyu888's own PR #54 comment gave its illustrative ex:program-adkp/ex:site-jhu data (the whole PR is explicitly a concept/PoC). Do not conflate this with the existing, real governanceduo:Study class, which models a single research study one level more granular than a Program -- see IRBRequirement's studyId description. `is_a: BaseEntity` for a synthetic dotted id, same reasoning as AccessRequirementTemplate above. See plans/governance_graph_open_questions.md Section C.2." ;
    skos:exactMatch governanceduo:Program ;
    skos:inScheme governanceduo:governance_duo .

sagegov:SynapseEntity a owl:Class ;
    rdfs:label "SynapseEntity" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sagegov:parentId ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sagegov:currentRevNum ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sagegov:createdByUserId ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sagegov:nodeType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sagegov:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sagegov:maxRevNum ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dcterms:identifier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sagegov:createdOn ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^syn\\d+$" ] ) ] ;
            owl:onProperty dcterms:identifier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sagegov:alias ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sagegov:etag ],
        governanceduo:BaseEntity ;
    skos:closeMatch prov:Entity ;
    skos:definition "A concrete Synapse entity (project, folder, file, etc.) that ACLs and Access Requirements attach to. Mirrors the NODE table. Deliberately separate from the Resource class: Resource represents a reusable resource-*type* pattern (e.g. \"mc2Res1\"), not a concrete entity instance with real parent/child structure." ;
    skos:exactMatch governanceduo:SynapseEntity ;
    skos:inScheme governanceduo:governance_duo .

sagegov:modifiedOn a owl:DatatypeProperty ;
    rdfs:label "modifiedOn" ;
    rdfs:range xsd:integer ;
    skos:definition "When this record was last modified (epoch milliseconds). On DataAccessSubmissionStatus this is emitted under the distinct gov:statusModifiedOn predicate instead (a bare constant in build_governance_graph.py, not resolved via this slot_uri -- see that class's own description); DataAccessRequest resolves it via this slot's own sagegov:modifiedOn directly." ;
    skos:exactMatch dcterms:modified ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:AccessRequirementKey a owl:DatatypeProperty ;
    rdfs:label "AccessRequirementKey" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^access_requirement\\.\\d+$" ] ) ] ;
    skos:definition "The Access Requirement id(s) associated with this object. Provide multiple values as a comma-separated list." ;
    skos:inScheme governanceduo:governance_duo ;
    skos:note "Deliberately an untyped string, not range: AccessRequirement: giving it a real typed range would require importing access_requirement.yaml into this file, but this file (like mixins.yaml) is a leaf that imports only linkml:types specifically so it can never import an entity file and risk an import cycle (see the schema-level description above). governance_graph.yaml can afford real typed ranges for its own cross-references (e.g. accessRequirement: range: AccessRequirement) because it is a single, later-loaded file that already imports everything it references -- this file cannot follow that pattern without breaking its own leaf-file guarantee. Same rationale applies to StudyKey below and to ResourceKey (schema.yaml)/SchemaKey (resource.yaml). The pattern above (matching AccessRequirement.id's own slot_usage pattern in access_requirement.yaml) is the cycle-free substitute: it catches a malformed id without needing a typed range at all -- the same approach already used for entityIdList in that same file. See plans/identifier_update.md." ;
    governanceduo:foreign_key true .

governanceduo:ApprovalStateEnum a owl:Class ;
    rdfs:label "ApprovalStateEnum" ;
    owl:oneOf ( sagegov:APPROVED sagegov:REVOKED ) ;
    skos:definition "Synapse's real AccessApproval state values (org.sagebionetworks.repo.model.ApprovalState), verified directly against the OpenAPI spec -- APPROVED/REVOKED only. A distinct, smaller enum from SubmissionStateEnum above. Each value's meaning: is the gov: IRI scripts/build_governance_graph.py emits for gov:status. The two enums' APPROVED share one IRI, gov:APPROVED, as the graph has always written it; the predicate (gov:status on an AccessApproval, gov:state on a DataAccessSubmission) tells them apart. Should they ever need different definitions, or the enums be declared disjoint, APPROVED needs a distinct IRI per enum (plans/enum_values_match_owl.md)." ;
    skos:inScheme governanceduo:governance_duo ;
    linkml:permissible_values sagegov:APPROVED,
        sagegov:REVOKED .

governanceduo:BindingTypeEnum a owl:Class ;
    rdfs:label "BindingTypeEnum" ;
    owl:oneOf ( sagegov:Direct sagegov:Inherited ) ;
    skos:definition "Whether a governance relationship (an AccessGrant or AccessRequirementAssociation) applies directly to a resource or is inherited from a parent (e.g. a file inheriting its parent study's Access Requirement) — from the design doc's own `gov:bindingType gov:Inherited` example. Not a Synapse database column; ACCESS_REQUIREMENT_PROJECT and the ACL tables record only the direct binding, so inheritance has to be resolved (via SynapseEntity.parentId) and recorded explicitly, per the design doc's \"Direct and Inherited Governance\" section. Each value's meaning: is the gov: IRI scripts/build_governance_graph.py emits for gov:bindingType." ;
    skos:inScheme governanceduo:governance_duo ;
    linkml:permissible_values sagegov:Direct,
        sagegov:Inherited .

governanceduo:GovernanceMixin a owl:Class ;
    rdfs:label "GovernanceMixin" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:populationType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:researchSpecificRestrictions ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:notAfter ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "MONDO:\\d{7}" ] ) ] ;
            owl:onProperty governanceduo:diseaseSpecificResearch ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:attribution ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:publicationMoratorium ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "ROR:[a-z0-9]{9}" ] ) ] ;
            owl:onProperty governanceduo:institutionSpecificRestriction ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^did:[a-z0-9]+:.+$" ] ) ] ;
            owl:onProperty governanceduo:approvedProjects ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:userSpecificRestriction ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:timeLimitOnUse ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:collaborationRequired ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^did:[a-z0-9]+:.+$" ] ) ] ;
            owl:onProperty governanceduo:institutionDids ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:requiredAgreementDocumentId ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^did:[a-z0-9]+:.+$" ] ) ] ;
            owl:onProperty governanceduo:requiredAgreementDocumentId ] ;
    skos:definition "DUO-based data-use-modifier vocabulary and its conditional-requirement rules, shared by every class whose schematic DependsOn list includes dataUseModifiers (AccessRequirement, Resource, Study — confirmed against the generated (now archived) archive/sage-ar-model/*.json, which resolves the full field set via schematic's own dependency expansion)." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:PrincipalTypeEnum a owl:Class ;
    rdfs:label "PrincipalTypeEnum" ;
    owl:unionOf ( sagegov:User sagegov:Team ) ;
    skos:definition "Whether a Principal is an individual user or a team — from the design doc: \"Principals may represent either individual users or teams.\" ACL_RESOURCE_ACCESS.GROUP_ID itself doesn't distinguish the two; Synapse resolves that from the id's own type at runtime, so this is recorded explicitly here rather than inferred. Each value's meaning: is the gov: class scripts/build_governance_graph.py asserts on the Principal (rdf:type gov:User/gov:Team)." ;
    skos:inScheme governanceduo:governance_duo ;
    linkml:permissible_values sagegov:Team,
        sagegov:User .

governanceduo:StudyKey a owl:DatatypeProperty ;
    rdfs:label "StudyKey" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^study\\.[A-Za-z0-9_-]+$" ] ) ] ;
    skos:definition "The Study id(s) associated with this object. Provide multiple values as a comma-separated list." ;
    skos:inScheme governanceduo:governance_duo ;
    governanceduo:foreign_key true .

sagegov:APPROVED a owl:NamedIndividual,
        governanceduo:ApprovalStateEnum,
        governanceduo:SubmissionStateEnum ;
    rdfs:label "APPROVED" .

sagegov:CHANGE_PERMISSIONS a owl:NamedIndividual,
        governanceduo:AccessTypeEnum,
        governanceduo:GrantPermissionEnum ;
    rdfs:label "CHANGE_PERMISSIONS" ;
    skos:definition "Permission to change access permissions for the entity or resource." .

sagegov:CHANGE_SETTINGS a owl:NamedIndividual,
        governanceduo:AccessTypeEnum,
        governanceduo:GrantPermissionEnum ;
    rdfs:label "CHANGE_SETTINGS" ;
    skos:definition "Permission to change settings or configuration for the entity or resource." .

sagegov:CREATE a owl:NamedIndividual,
        governanceduo:AccessTypeEnum,
        governanceduo:GrantPermissionEnum ;
    rdfs:label "CREATE" ;
    skos:definition "Permission to create a new entity or resource." .

sagegov:DELETE a owl:NamedIndividual,
        governanceduo:AccessTypeEnum,
        governanceduo:GrantPermissionEnum ;
    rdfs:label "DELETE" ;
    skos:definition "Permission to delete the entity or resource." .

sagegov:DELETE_SUBMISSION a owl:NamedIndividual,
        governanceduo:AccessTypeEnum,
        governanceduo:GrantPermissionEnum ;
    rdfs:label "DELETE_SUBMISSION" ;
    skos:definition "Permission to delete a submission." .

sagegov:DOWNLOAD a owl:NamedIndividual,
        governanceduo:AccessTypeEnum,
        governanceduo:GrantPermissionEnum ;
    rdfs:label "DOWNLOAD" ;
    skos:definition "Permission to download files or data from the entity or resource." .

sagegov:EXEMPTION_ELIGIBLE a owl:NamedIndividual,
        governanceduo:AccessTypeEnum,
        governanceduo:GrantPermissionEnum ;
    rdfs:label "EXEMPTION_ELIGIBLE" ;
    skos:definition "Qualifies for exemption when granted on Access Requirement ACLs." .

sagegov:MODERATE a owl:NamedIndividual,
        governanceduo:AccessTypeEnum,
        governanceduo:GrantPermissionEnum ;
    rdfs:label "MODERATE" ;
    skos:definition "Permission to moderate content or activity related to the entity or resource." .

sagegov:PARTICIPATE a owl:NamedIndividual,
        governanceduo:AccessTypeEnum,
        governanceduo:GrantPermissionEnum ;
    rdfs:label "PARTICIPATE" ;
    skos:definition "Permission to participate in activities related to the entity, such as discussions or challenges." .

sagegov:READ a owl:NamedIndividual,
        governanceduo:AccessTypeEnum,
        governanceduo:GrantPermissionEnum ;
    rdfs:label "READ" ;
    skos:definition "Permission to read or view the entity or resource." .

sagegov:READ_PRIVATE_SUBMISSION a owl:NamedIndividual,
        governanceduo:AccessTypeEnum,
        governanceduo:GrantPermissionEnum ;
    rdfs:label "READ_PRIVATE_SUBMISSION" ;
    skos:definition "Permission to read private submissions associated with the entity." .

sagegov:REVIEW_SUBMISSIONS a owl:NamedIndividual,
        governanceduo:AccessTypeEnum,
        governanceduo:GrantPermissionEnum ;
    rdfs:label "REVIEW_SUBMISSIONS" ;
    skos:definition "Enables reviewing submission groups (e.g., on Access Requirements) for specified objects." .

sagegov:SEND_MESSAGE a owl:NamedIndividual,
        governanceduo:AccessTypeEnum,
        governanceduo:GrantPermissionEnum ;
    rdfs:label "SEND_MESSAGE" ;
    skos:definition "Permission to send messages related to the entity or resource." .

sagegov:SUBMIT a owl:NamedIndividual,
        governanceduo:AccessTypeEnum,
        governanceduo:GrantPermissionEnum ;
    rdfs:label "SUBMIT" ;
    skos:definition "Permission to submit content or data to the entity or resource." .

sagegov:TEAM_MEMBERSHIP_UPDATE a owl:NamedIndividual,
        governanceduo:AccessTypeEnum,
        governanceduo:GrantPermissionEnum ;
    rdfs:label "TEAM_MEMBERSHIP_UPDATE" ;
    skos:definition "Permission to update team membership, such as adding or removing members." .

sagegov:UPDATE a owl:NamedIndividual,
        governanceduo:AccessTypeEnum,
        governanceduo:GrantPermissionEnum ;
    rdfs:label "UPDATE" ;
    skos:definition "Permission to modify or update the entity or resource." .

sagegov:UPDATE_SUBMISSION a owl:NamedIndividual,
        governanceduo:AccessTypeEnum,
        governanceduo:GrantPermissionEnum ;
    rdfs:label "UPDATE_SUBMISSION" ;
    skos:definition "Permission to update or modify a submission." .

sagegov:UPLOAD a owl:NamedIndividual,
        governanceduo:AccessTypeEnum,
        governanceduo:GrantPermissionEnum ;
    rdfs:label "UPLOAD" ;
    skos:definition "Deprecated; adding this to an ACL has no effect." ;
    governanceduo:deprecated true .

sagegov:accessRequirement a owl:ObjectProperty ;
    rdfs:label "accessRequirement",
        "accessRequirementId" ;
    rdfs:range sagegov:AccessRequirement ;
    skos:closeMatch dcterms:requires ;
    skos:definition "The AccessRequirement this association binds to the resource. range is AccessRequirementReference (the gov:AR-<n> stub), not the real AccessRequirement itself -- see that class's own description.",
        "The AccessRequirement this submission is an application against (DATA_ACCESS_SUBMISSION.ACCESS_REQUIREMENT_ID). range is AccessRequirementReference (the gov:AR-<n> stub), not the real AccessRequirement itself -- see that class's own description." ;
    skos:inScheme governanceduo:governance_duo ;
    skos:note "slot_uri intentionally reuses sagegov:accessRequirement, the same predicate AccessRequirementAssociation.accessRequirement uses, even though this is a differently-named LinkML slot -- so \"what AccessRequirement does this concern?\" is a uniform gov:accessRequirement query regardless of subject class. See scripts/build_governance_graph.py." .

sagegov:createdBy a owl:ObjectProperty ;
    rdfs:label "createdBy" ;
    rdfs:range sagegov:Principal .

sagegov:institution a owl:DatatypeProperty ;
    rdfs:label "institution" ;
    skos:definition "Institution/company name, verbatim from Synapse (ResearchProject.institution / DataAccessRequest.institution -- both real fields hold the same free-text shape as UserProfile.company above). On ResearchProject/DataAccessRequest, consumed by site_node_for() to derive a gov:affiliatedWith edge, not independently re-emitted; on Site itself, this is the node's own display name and IS emitted directly." ;
    skos:inScheme governanceduo:governance_duo .

sagegov:name a owl:DatatypeProperty ;
    rdfs:label "name" .

governanceduo:DataTierEnum a rdfs:Datatype ;
    rdfs:label "DataTierEnum" ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:oneOf ( "Anonymous" "Open" "Controlled" "Private" "Unclassified" ) ] ;
    skos:inScheme governanceduo:governance_duo ;
    linkml:permissible_values "Anonymous",
        "Controlled",
        "Open",
        "Private",
        "Unclassified" .

governanceduo:synapseId a owl:DatatypeProperty ;
    rdfs:label "synapseId" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^syn\\d+$" ] ) ] ;
    skos:definition "A Synapse entity id. Reused across contexts that reference one specific Synapse entity: an AssetBinding registering it as a Policy Fabric Asset (this file), or a DrsObjectMapping crosswalking it to a DRS DrsObject (drs_alignment.yaml)." ;
    skos:inScheme governanceduo:governance_duo .

xsd:boolean a rdfs:Datatype .

sagegov:etag a owl:DatatypeProperty ;
    rdfs:label "etag" .

governanceduo:SubmissionStateEnum a owl:Class ;
    rdfs:label "SubmissionStateEnum" ;
    owl:oneOf ( sagegov:SUBMITTED sagegov:APPROVED sagegov:REJECTED sagegov:CANCELLED ) ;
    skos:definition "Synapse's real DataAccessSubmissionState values, verified via Sage-Bionetworks/SynapseWebClient source (ACTDataAccessSubmissionWidget.java's exhaustive state switch) — the \"sagebrain governance graph ACL_AR data - AR table schemas.csv\" only says DATA_ACCESS_SUBMISSION_STATUS.STATE is TEXT, with no NOTES-column value list. Each value's meaning: is the gov: IRI scripts/build_governance_graph.py emits for gov:state (APPROVED is shared with ApprovalStateEnum -- see that enum)." ;
    skos:inScheme governanceduo:governance_duo ;
    linkml:permissible_values sagegov:APPROVED,
        sagegov:CANCELLED,
        sagegov:REJECTED,
        sagegov:SUBMITTED .

sagegov:createdOn a owl:DatatypeProperty ;
    rdfs:label "createdOn" .

sagegov:Principal a owl:Class ;
    rdfs:label "Principal" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty governanceduo:principalType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sagegov:company ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sagegov:principalId ] ;
    skos:closeMatch prov:Agent ;
    skos:definition """A Synapse user or team being granted access via an ACL. Mirrors ACL_RESOURCE_ACCESS.GROUP_ID (the id of the user or team being granted access) with an explicit type discriminator, since a bare GROUP_ID doesn't distinguish the two on its own. Deliberately not `is_a: BaseEntity`, and for a different reason than DataAccessSubmissionStatus's (see that class's own description): unlike AccessGrant/AccessRequirementAssociation/ DataAccessSubmission -- which mint a *synthetic* BaseEntity id specifically because their underlying Synapse tables have no single natural key for the merged, first-class thing being modeled -- GROUP_ID already *is* a real, unambiguous, already-existing natural key (Synapse's own numeric Principal/UserGroup id), so there's nothing to synthesize. It's also an integer, not a string, so reusing BaseEntity's generically string-typed `id` slot would require both a range override and renaming this attribute from principalId to literally `id` (slot_usage overrides a slot's attributes; it can't let a differently-named slot stand in for it) -- sacrificing the direct principalId <-> ACL_RESOURCE_ACCESS.GROUP_ID column traceability this schema preserves everywhere else (see SynapseAccessRequirementMixin's real-column-name convention).
`company` mirrors Synapse's real UserProfile.company field ("This person's current affiliation") -- a genuine per-Principal institution signal, verified directly against the OpenAPI spec, resolving the target ontology's gov:affiliatedWith (Principal -> Site) as real data, not just an aspiration (see plans/governance_graph_open_questions.md Section C). Only meaningful for `principalType: User`: Synapse's real Team object has no institution/affiliation field of its own.""" ;
    skos:exactMatch governanceduo:Principal ;
    skos:inScheme governanceduo:governance_duo .

xsd:integer a rdfs:Datatype .

governanceduo:BaseEntity a owl:Class ;
    rdfs:label "BaseEntity" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dcterms:identifier ],
        [ owl:unionOf ( sagegov:AccessApproval sagegov:AccessGrant governanceduo:AccessRequirement sagegov:AccessRequirementAssociation sagegov:AccessRequirementTemplate prov:Activity sagegov:DataAccessRequest sagegov:DataAccessSubmission sagegov:DerivationReview governanceduo:DerivationRule sagegov:IRBRequirement sagegov:Program sagegov:ResearchProject governanceduo:Resource governanceduo:Schema governanceduo:Study sagegov:SynapseEntity ) ] ;
    skos:definition "Abstract root shared by every governanceDUO class." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:AccessTypeEnum a owl:Class ;
    rdfs:label "AccessTypeEnum" ;
    owl:oneOf ( sagegov:CREATE sagegov:READ sagegov:UPDATE sagegov:DELETE sagegov:CHANGE_PERMISSIONS sagegov:DOWNLOAD sagegov:UPLOAD sagegov:PARTICIPATE sagegov:SUBMIT sagegov:READ_PRIVATE_SUBMISSION sagegov:UPDATE_SUBMISSION sagegov:DELETE_SUBMISSION sagegov:TEAM_MEMBERSHIP_UPDATE sagegov:SEND_MESSAGE sagegov:CHANGE_SETTINGS sagegov:MODERATE sagegov:REVIEW_SUBMISSIONS sagegov:EXEMPTION_ELIGIBLE ) ;
    skos:definition "Synapse's real ACCESS_TYPE values, verified live via rest-docs.synapse.org (not inferred from the \"sagebrain governance graph ACL_AR data\" CSVs alone, which only name a handful of these as examples in a free-text NOTES column). Shared by AccessGrant.permission (an ACL grant's permission — ACL_RESOURCE_ACCESS_TYPE.STRING_ELE) in governance_graph.yaml and this file's own accessType slot (ACCESS_REQUIREMENT.ACCESS_TYPE) — the same underlying Synapse type in both places. Each value's meaning: is the gov: IRI scripts/build_governance_graph.py emits for gov:permission." ;
    skos:inScheme governanceduo:governance_duo ;
    linkml:permissible_values sagegov:CHANGE_PERMISSIONS,
        sagegov:CHANGE_SETTINGS,
        sagegov:CREATE,
        sagegov:DELETE,
        sagegov:DELETE_SUBMISSION,
        sagegov:DOWNLOAD,
        sagegov:EXEMPTION_ELIGIBLE,
        sagegov:MODERATE,
        sagegov:PARTICIPATE,
        sagegov:READ,
        sagegov:READ_PRIVATE_SUBMISSION,
        sagegov:REVIEW_SUBMISSIONS,
        sagegov:SEND_MESSAGE,
        sagegov:SUBMIT,
        sagegov:TEAM_MEMBERSHIP_UPDATE,
        sagegov:UPDATE,
        sagegov:UPDATE_SUBMISSION,
        sagegov:UPLOAD .

governanceduo:GrantPermissionEnum a owl:Class ;
    rdfs:label "GrantPermissionEnum" ;
    owl:oneOf ( sagegov:CREATE sagegov:READ sagegov:UPDATE sagegov:DELETE sagegov:CHANGE_PERMISSIONS sagegov:DOWNLOAD sagegov:UPLOAD sagegov:PARTICIPATE sagegov:SUBMIT sagegov:READ_PRIVATE_SUBMISSION sagegov:UPDATE_SUBMISSION sagegov:DELETE_SUBMISSION sagegov:TEAM_MEMBERSHIP_UPDATE sagegov:SEND_MESSAGE sagegov:CHANGE_SETTINGS sagegov:MODERATE sagegov:REVIEW_SUBMISSIONS sagegov:EXEMPTION_ELIGIBLE sagegov:ACCESS ) ;
    skos:definition "The permissions an AccessGrant's gov:permission can carry: every AccessTypeEnum value (Synapse's ACCESS_TYPE, same meaning: IRIs), plus ACCESS, which scripts/build_governance_graph.py derives on every grant carrying DOWNLOAD for sagebrain-infra's authorizer. AccessTypeEnum stays a pure mirror of Synapse (plans/sagebrain_contract_and_owl_dl_fixes.md D8), so AccessRequirement.accessType can't take ACCESS. The Synapse values are listed again rather than via `inherits:`, which linkml-validate, gen-owl and gen-shacl don't expand; scripts/check_enum_sync.py keeps the two lists identical (plans/enum_values_match_owl.md)." ;
    skos:inScheme governanceduo:governance_duo ;
    linkml:permissible_values sagegov:ACCESS,
        sagegov:CHANGE_PERMISSIONS,
        sagegov:CHANGE_SETTINGS,
        sagegov:CREATE,
        sagegov:DELETE,
        sagegov:DELETE_SUBMISSION,
        sagegov:DOWNLOAD,
        sagegov:EXEMPTION_ELIGIBLE,
        sagegov:MODERATE,
        sagegov:PARTICIPATE,
        sagegov:READ,
        sagegov:READ_PRIVATE_SUBMISSION,
        sagegov:REVIEW_SUBMISSIONS,
        sagegov:SEND_MESSAGE,
        sagegov:SUBMIT,
        sagegov:TEAM_MEMBERSHIP_UPDATE,
        sagegov:UPDATE,
        sagegov:UPDATE_SUBMISSION,
        sagegov:UPLOAD .

dcterms:identifier a owl:DatatypeProperty ;
    rdfs:label "id" ;
    skos:definition "A unique identifier for this record. Narrowed per class via `slot_usage` in access_requirement.yaml/resource.yaml/schema.yaml/study.yaml/governance_graph.yaml (SynapseEntity/AccessGrant/AccessRequirementAssociation/DataAccessSubmission). The schematic CSV source (../model/*.model.csv) keeps class-prefixed attribute names (AccessRequirement_id, Resource_id, Schema_id, Study_id) instead: schematic's model CSV has one flat, global Attribute namespace with no per-class scoping equivalent to slot_usage, so four classes cannot share a bare \"id\" attribute there without colliding." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:DataUseModifierEnum a owl:Class ;
    rdfs:label "DataUseModifierEnum" ;
    owl:unionOf ( DUO:0000042 DUO:0000027 DUO:0000016 DUO:0000029 DUO:0000043 DUO:0000015 DUO:0000004 DUO:0000045 DUO:0000017 DUO:0000011 DUO:0000046 DUO:0000018 DUO:0000044 DUO:0000021 DUO:0000006 DUO:0000019 DUO:0000026 DUO:0000020 DUO:0000012 DUO:0000025 DUO:0000024 DUO:0000028 DUO:0000022 DUO:0000007 sagegov:DUOPlus1 sagegov:DUOPlus2 sagegov:DUOPlus3 sagegov:DUOPlus4 sagegov:DUOPlus5 sagegov:DUOPlus6 sagegov:DUOPlus7 <https://w3id.org/sage-bionetworks/governance-duo/DataUseModifierEnum#Pending%20Annotation> ) ;
    skos:definition "Data Use Ontology (DUO) modifier codes, plus Sage-local DUOPlus1-7 extensions (see README) and \"Pending Annotation\". Real DUO terms carry `meaning:` pointing at the actual obo:DUO_ IRI (reuse-by-IRI, not re-minting — the same convention sagebrain-model documents for its own external-term reuse). The Sage-local DUOPlus1-7 extensions carry `meaning:` gov: IRIs (sagegov:DUOPlus<n>), declared as individuals in shapes/governance_graph.owl.ttl, so every data-use code in the graph is an IRI -- joinable against sagebrain-model's DUO import -- rather than a mix of IRIs and strings. \"Pending Annotation\" has no meaning: it is a curation state, not a data-use condition." ;
    skos:inScheme governanceduo:governance_duo ;
    linkml:permissible_values DUO:0000004,
        DUO:0000006,
        DUO:0000007,
        DUO:0000011,
        DUO:0000012,
        DUO:0000015,
        DUO:0000016,
        DUO:0000017,
        DUO:0000018,
        DUO:0000019,
        DUO:0000020,
        DUO:0000021,
        DUO:0000022,
        DUO:0000024,
        DUO:0000025,
        DUO:0000026,
        DUO:0000027,
        DUO:0000028,
        DUO:0000029,
        DUO:0000042,
        DUO:0000043,
        DUO:0000044,
        DUO:0000045,
        DUO:0000046,
        sagegov:DUOPlus1,
        sagegov:DUOPlus2,
        sagegov:DUOPlus3,
        sagegov:DUOPlus4,
        sagegov:DUOPlus5,
        sagegov:DUOPlus6,
        sagegov:DUOPlus7,
        <https://w3id.org/sage-bionetworks/governance-duo/DataUseModifierEnum#Pending%20Annotation> .

xsd:string a rdfs:Datatype .

governanceduo:governance_duo a owl:Ontology ;
    rdfs:label "governance_duo" ;
    owl:versionIRI <https://w3id.org/sage-bionetworks/governance-duo/governance_duo/0.1.0> ;
    owl:versionInfo "0.1.0" ;
    skos:definition "LinkML representation of the Sage Bionetworks governanceDUO data model (Access Requirement, Resource, Schema, Study), its Policy Fabric integration (policy_fabric.yaml), its RDF Governance Graph representation (governance_graph.yaml), a Provenance Graph layering real PROV-O structure on top of it (provenance.yaml) plus a Derivation Policy Graph consuming that lineage (derivation_policy.yaml — see plans/prov_o_integration.md), and a design-only GA4GH Data Repository Service (DRS) interoperability crosswalk (drs_alignment.yaml). Architecturally aligned with SageCommonDataModel (https://github.com/Sage-Bionetworks/SageCommonDataModel — one file per entity, a shared BaseEntity + mixins, slot_usage narrowing, prefix/URI discipline). Shaped to interoperate with sagebrain-model (https://github.com/Sage-Bionetworks/sagebrain-model) and the Data Use Ontology (DUO): real DUO terms are reused by IRI via `meaning:` CURIEs rather than re-minted, and the `sagebrain`/`biolink` prefixes below are declared so scripts/build_owl.py's output lines up with sagebrain's own namespaces the moment cross-repo linking is in scope. This is the single entry point — import this file to get the whole model, or import an individual file below for partial use." .

