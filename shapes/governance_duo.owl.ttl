@prefix DUO: <http://purl.obolibrary.org/obo/DUO_> .
@prefix EVORAO: <https://w3id.org/evorao/> .
@prefix NCIT: <http://purl.obolibrary.org/obo/NCIT_> .
@prefix T4FS: <http://purl.obolibrary.org/obo/T4FS_> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dpv: <https://w3id.org/dpv#> .
@prefix ebiswo: <http://www.ebi.ac.uk/swo/SWO_> .
@prefix governanceduo: <https://w3id.org/sage-bionetworks/governance-duo/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sagegov: <https://sagebionetworks.org/governance/> .
@prefix schema1: <http://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

governanceduo:AccessRequirementKey a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "AccessRequirementKey" ;
    skos:definition "The Access Requirement id(s) associated with this object. Provide multiple values as a comma-separated list." ;
    skos:inScheme governanceduo:props ;
    skos:note "Deliberately an untyped string, not range: AccessRequirement: giving it a real typed range would require importing access_requirement.yaml into this file, but this file (like mixins.yaml) is a leaf that imports only linkml:types specifically so it can never import an entity file and risk an import cycle (see the schema-level description above). governance_graph.yaml can afford real typed ranges for its own cross-references (e.g. accessRequirement: range: AccessRequirement) because it is a single, later-loaded file that already imports everything it references -- this file cannot follow that pattern without breaking its own leaf-file guarantee. Same rationale applies to StudyKey below and to ResourceKey (schema.yaml)/SchemaKey (resource.yaml)." ;
    governanceduo:foreign_key true .

governanceduo:Condition a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "Condition" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:conditionType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:duoCode ] ;
    skos:definition "A single DUO-code-backed condition on an AccessRequirement, surfacing GovernanceMixin's dataUseModifiers/companion-slot data -- already present in this repo's AccessRequirement examples -- as a first-class graph node instead of leaving it invisible on the gov:AccessRequirement stub (see scripts/build_governance_graph.py's TYPE(\"AccessRequirement\") comment for why that stub has its own, separate node). Mirrors the shape of a gov:Condition example proposed in review on sagebrain-infra PR #54 (thomasyu888, https://github.com/Sage-Bionetworks-IT/sagebrain-infra/pull/54#discussion_r3926030399), built from real data already in this repo, not a new source of truth -- see plans/rebac_governance_graph_alignment.md for the full rationale. Not `is_a: BaseEntity`: like DataAccessSubmissionStatus, it has no independent identifier of its own in Synapse's schema -- it's keyed structurally by (AccessRequirement, duoCode/conditionType), not a synthesized dotted id." ;
    skos:exactMatch sagegov:Condition ;
    skos:inScheme governanceduo:governance_graph .

governanceduo:DataAccessSubmissionStatus a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "DataAccessSubmissionStatus" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty governanceduo:state ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:modifiedOn ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:rejectedReason ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty governanceduo:submissionId ] ;
    skos:definition """The approval-workflow state of a DataAccessSubmission. Mirrors DATA_ACCESS_SUBMISSION_STATUS, which has no independent identifier of its own in Synapse's schema (only a SUBMISSION_ID foreign key) — modeled here as a plain class keyed by submissionId, not a BaseEntity subclass, for the same reason.
Slots corrected against Synapse's live `SubmissionStatus` REST object (`org.sagebionetworks.repo.model.dataaccess.SubmissionStatus`): it carries only `submissionId`/`submittedBy`/`rejectedReason`/`state`/`modifiedOn` -- no `createdBy`/`createdOn`/`modifiedBy` at all (those were this schema's earlier, DB-table-column-based guess; `modifiedBy` is real but lives on `Submission` itself -- see DataAccessSubmission above). `submittedBy` is intentionally not re-declared here even though the live object carries it: it would be redundant with DataAccessSubmission.submittedBy on the same merged RDF subject (see scripts/build_governance_graph.py's merge design).""" ;
    skos:inScheme governanceduo:governance_graph .

governanceduo:DrsAuthorizationBinding a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "DrsAuthorizationBinding" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty governanceduo:dataUseModifier ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^did:[a-z0-9]+:.+$" ] ) ] ;
            owl:onProperty governanceduo:passportAuthIssuers ] ;
    skos:definition "Crosswalks one DUO code (or Sage DUOPlus extension) to the shape of the DRS Authorizations record a server would return from `OPTIONS /objects/{object_id}` for an object governed by that code. Mirrors PolicyCardBinding (policy_fabric.yaml) — same dataUseModifier axis, different target system's input shape (DRS's Authorizations discovery record vs. Policy Fabric's policy_data_schema.json)." ;
    skos:inScheme governanceduo:drs_alignment .

governanceduo:DrsObjectMapping a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "DrsObjectMapping" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty governanceduo:drsSelfUri ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty governanceduo:drsId ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^drs://.+$" ] ) ] ;
            owl:onProperty governanceduo:drsSelfUri ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty governanceduo:synapseId ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^syn\\d+$" ] ) ] ;
            owl:onProperty governanceduo:synapseId ] ;
    skos:definition "How one Synapse entity maps onto a DRS DrsObject's id/self_uri/aliases. One row per governed Synapse entity, not per AccessRequirement (multiple AccessRequirements can govern the same entity; this mapping is per-entity)." ;
    skos:inScheme governanceduo:drs_alignment .

governanceduo:PolicyCardBindingCollection a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "PolicyCardBindingCollection" ;
    skos:definition "Container class for policy_fabric_bindings.yaml — a plain list wrapper so the data file has a single root class to validate against." ;
    skos:inScheme governanceduo:policy_fabric .

governanceduo:ResourceKey a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "ResourceKey" ;
    skos:definition "The identifier(s) for the Resource(s) associated with this schema. Provide multiple values as a comma-separated list." ;
    skos:inScheme governanceduo:schema ;
    skos:note "Untyped string, not range: Resource -- see props.yaml's AccessRequirementKey comment for why (this file cannot import resource.yaml without risking a cycle)." ;
    governanceduo:foreign_key true .

governanceduo:Site a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "Site" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:institution ] ;
    skos:definition "An institution real Synapse data associates with a ResearchProject or User-type Principal. Synapse never gives a stable Site id, only a free-text institution/company name string (ResearchProject.institution / UserProfile.company -- both real fields hold the same shape), so gov:Site nodes are minted deterministically by slugifying that name (see site_node_for() in build_governance_graph.py) -- the same \"derive a stable node from real but non-id-shaped data\" pattern add_principal() already uses for bare integer ids. Not `is_a: BaseEntity` for the same reason. gov:affiliatedWith (from ResearchProject/Principal to this class) is a derived convenience triple with no governance_graph.yaml slot backing it, same as gov:hasACL/gov:hasAccessRequirement/gov:hasCondition -- it's never present in any source data, only computed by the script. See plans/governance_graph_open_questions.md Section C." ;
    skos:exactMatch sagegov:Site ;
    skos:inScheme governanceduo:governance_graph .

governanceduo:StudyKey a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "StudyKey" ;
    skos:definition "The Study id(s) associated with this object. Provide multiple values as a comma-separated list." ;
    skos:inScheme governanceduo:props ;
    governanceduo:foreign_key true .

governanceduo:aliases a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "aliases" ;
    skos:definition "Secondary/external identifiers for this same Synapse entity, carried in DRS's own sanctioned DrsObject.aliases field — e.g. the governanceDUO dotted id(s) that reference this entity via entityIdList/assetBindings[].synapseId (see access_requirement.yaml/mixins.yaml), and/or the corresponding gov:-namespace SynapseEntity individual (see governance_graph.yaml). This is the DRS-forward-compatible resolution of governanceDUO's three-parallel- identifier-scheme gap (entityIdList / assetBindings.synapseId / SynapseEntity.id): rather than inventing a fourth internal crosswalk, Synapse's own id becomes the canonical DRS id and everything else rides in aliases." ;
    skos:inScheme governanceduo:drs_alignment .

governanceduo:assetBindings a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "assetBindings" ;
    rdfs:range governanceduo:AssetBinding ;
    skos:definition "Policy Fabric Asset-registry DID(s), each paired with the Synapse entity id it registers. Replaces a pair of positionally order-aligned lists (dataUseModifiers-adjacent entityIdList and a since-removed flat assetDids list) with an explicit pairing, so which DID belongs to which Synapse entity is structural rather than convention-only. Each synapseId here should also appear in the containing record's entityIdList (documented, not schema-enforced). GovernanceMixin's own `rules:` are cross-slot too, but only in the simpler \"value X on slot A requires slot B to be present\" sense; this would need the harder kind -- a positional/arity correspondence between two multivalued lists -- which LinkML's `rules:` preconditions/postconditions don't express, so it's left as a documented, not enforced, invariant." ;
    skos:inScheme governanceduo:mixins .

governanceduo:bindings a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "bindings" ;
    rdfs:range governanceduo:PolicyCardBinding ;
    skos:inScheme governanceduo:policy_fabric .

governanceduo:conditionDetail a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "conditionDetail" ;
    skos:definition "Zero or more companion-slot values from the source AccessRequirement, one per GovernanceMixin.rules entry whose precondition matches this condition's duoCode/conditionType and whose postcondition slot is actually populated on the instance (e.g. the geographicalRestriction value(s) for DUO:0000022). Multivalued because GovernanceMixin.rules is genuinely many-to-many -- some codes have multiple companion slots, some companion slots serve multiple codes -- not because any single condition's own detail is inherently list-valued. See scripts/build_governance_graph.py." ;
    skos:inScheme governanceduo:governance_graph .

governanceduo:governance_duo a owl:Ontology ;
    rdfs:label "governance_duo" ;
    owl:versionIRI <https://w3id.org/sage-bionetworks/governance-duo/governance_duo/0.1.0> ;
    owl:versionInfo "0.1.0" ;
    skos:definition "LinkML representation of the Sage Bionetworks governanceDUO data model (Access Requirement, Resource, Schema, Study), its Policy Fabric integration (policy_fabric.yaml), its RDF Governance Graph representation (governance_graph.yaml), and a design-only GA4GH Data Repository Service (DRS) interoperability crosswalk (drs_alignment.yaml). Architecturally aligned with SageCommonDataModel (https://github.com/Sage-Bionetworks/SageCommonDataModel — one file per entity, a shared BaseEntity + mixins, slot_usage narrowing, prefix/URI discipline). Shaped to interoperate with sagebrain-model (https://github.com/Sage-Bionetworks/sagebrain-model) and the Data Use Ontology (DUO): real DUO terms are reused by IRI via `meaning:` CURIEs rather than re-minted, and the `sagebrain`/`biolink` prefixes below are declared so scripts/build_owl.py's output lines up with sagebrain's own namespaces the moment cross-repo linking is in scope. This is the single entry point — import this file to get the whole model, or import an individual file below for partial use." .

governanceduo:grantNumber a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "grantNumber" ;
    skos:definition "The identifier associated with the award funding this study." ;
    skos:exactMatch EVORAO:grantNumber ;
    skos:inScheme governanceduo:study ;
    skos:note "EVORAO:grantNumber, \"A formal reference or agreement number assigned by the funding body\" — verified live and non-obsolete via the OLS4 API." .

governanceduo:notes a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "notes" ;
    skos:definition "Free-text notes — used in particular to record why sourceSlot is left unset (which governanceDUO slot would need to be added, and its required shape) so a gap is documented rather than silently dropped. Reused by drs_alignment.yaml's DrsAuthorizationBinding for the same purpose." ;
    skos:inScheme governanceduo:policy_fabric .

governanceduo:referenceValueKeys a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "referenceValueKeys" ;
    skos:definition "The policy_data_schema.json key(s) this policy_card's Reference Values Schema defines, e.g. \"allowedCountries\". Empty for policy_cards with no reference values at all (pure credential-chain checks, e.g. ethics-approval-required)." ;
    skos:inScheme governanceduo:policy_fabric .

governanceduo:referenceValueSources a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "referenceValueSources" ;
    rdfs:range governanceduo:ReferenceValueSource ;
    skos:inScheme governanceduo:policy_fabric .

governanceduo:requiredCredentials a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "requiredCredentials" ;
    rdfs:range governanceduo:CredentialRequirement ;
    skos:inScheme governanceduo:policy_fabric .

governanceduo:studyDeidentificationType a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "studyDeidentificationType" ;
    rdfs:range governanceduo:DeidentificationTypeEnum ;
    skos:closeMatch T4FS:0000414 ;
    skos:definition "General description of the de-identification method. Maps to DUOPlus3." ;
    skos:inScheme governanceduo:study ;
    skos:note "T4FS:0000414 \"de-identification\" — see GovernanceMixin.deidentificationType for the same close (not exact) mapping and rationale." ;
    governanceduo:cde_id "14576319" .

governanceduo:studyIndexDate a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "studyIndexDate" ;
    rdfs:range governanceduo:StudyIndexDateEnum ;
    skos:definition "The reference event associated with timepoints in this study. One of Diagnosis Date, Enrollment Date, Collection Date, or Birth Date." ;
    skos:inScheme governanceduo:study .

governanceduo:supportedAuthTypes a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "supportedAuthTypes" ;
    rdfs:range governanceduo:DrsAuthTypeEnum ;
    skos:definition "Mirrors DRS's Authorizations.supported_types for objects governed by this DUO code." ;
    skos:inScheme governanceduo:drs_alignment .

governanceduo:AccessApproval a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "AccessApproval" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:createdOn ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty governanceduo:requirementId ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:expiredOn ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty governanceduo:accessorId ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:submitterId ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty governanceduo:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^access_approval\\.\\d+$" ] ) ] ;
            owl:onProperty governanceduo:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:requirementVersion ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty governanceduo:status ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:sourceApprovalId ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:etag ],
        governanceduo:BaseEntity ;
    skos:definition """Records that a Principal has been approved for access under an AccessRequirement. Mirrors Synapse's real AccessApproval REST object (org.sagebionetworks.repo.model.AccessApproval) -- a *separate* object from DataAccessSubmission/DataAccessSubmissionStatus (the workflow/audit trail that produces one), verified directly against rest-docs.synapse.org and the OpenAPI spec. Maps onto the target ontology (proposed in review on sagebrain-infra PR #54) as gov:Approval: gov:satisfies (requirementId), gov:heldBy (accessorId), gov:status (this class's own status slot -- range ApprovalStateEnum, deliberately not the shared "state" slot, which ranges over the unrelated SubmissionStateEnum), gov:expiresAt (expiredOn).
gov:hasApproval (Principal -> AccessRequirement) is re-derived from this class (status == APPROVED) as the primary source going forward -- see add_access_approval() in build_governance_graph.py. The existing DataAccessSubmissionStatus-sourced gov:hasApproval edge is left as-is, not replaced (authorize.py's SPARQL contract touches neither). See plans/governance_graph_open_questions.md Section B.""" ;
    skos:exactMatch sagegov:AccessApproval ;
    skos:inScheme governanceduo:governance_graph .

governanceduo:AccessGrant a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "AccessGrant" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:sourceAclId ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:createdOn ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty governanceduo:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^grant\\.[A-Za-z0-9_-]+$" ] ) ] ;
            owl:onProperty governanceduo:id ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty governanceduo:principal ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty governanceduo:resource ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty governanceduo:bindingType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:source ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:sourceAclResourceAccessId ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty governanceduo:permission ],
        governanceduo:BaseEntity ;
    skos:closeMatch schema1:DigitalDocumentPermissionType,
        dpv:AuthorisationProtocols ;
    skos:definition "A first-class ACL grant: resource, principal, permission(s), source, and whether the grant is direct or inherited. Mirrors ACL + ACL_RESOURCE_ACCESS + ACL_RESOURCE_ACCESS_TYPE. Answers \"who has which permission on this resource?\" — distinct from AccessRequirementAssociation, which answers \"what additional conditions must be satisfied?\" (the design doc's central ACL-vs-AR distinction)." ;
    skos:exactMatch sagegov:AccessGrant ;
    skos:inScheme governanceduo:governance_graph .

governanceduo:AccessRequirementAssociation a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "AccessRequirementAssociation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty governanceduo:bindingType ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty governanceduo:accessRequirement ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^ar_association\\.[A-Za-z0-9_-]+$" ] ) ] ;
            owl:onProperty governanceduo:id ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty governanceduo:resource ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty governanceduo:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:source ],
        governanceduo:BaseEntity ;
    skos:definition "Binds an AccessRequirement to a resource, recording whether the binding is direct or inherited. Mirrors ACCESS_REQUIREMENT_PROJECT, extended with the design doc's explicit direct/inherited distinction — ACCESS_REQUIREMENT_PROJECT itself has no binding-type column; that inheritance concept is this repo's own addition to capture what the design doc calls for (see BindingTypeEnum)." ;
    skos:exactMatch sagegov:AccessRequirementAssociation ;
    skos:inScheme governanceduo:governance_graph .

governanceduo:AssetBinding a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "AssetBinding" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^did:[a-z0-9]+:.+$" ] ) ] ;
            owl:onProperty governanceduo:assetDid ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty governanceduo:synapseId ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^syn\\d+$" ] ) ] ;
            owl:onProperty governanceduo:synapseId ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty governanceduo:assetDid ] ;
    skos:definition "One (Synapse entity id -> Policy Fabric Asset DID) pairing. Mirrors the Django Asset model's `did` field (unique per Asset) in tmp-policies/tools/asset_registry. A plain string, not a typed `range: SynapseEntity`, for synapseId: importing governance_graph.yaml (where SynapseEntity is defined) into this leaf file would create the same import cycle base_entity.yaml/props.yaml/mixins.yaml are designed to avoid (governance_graph.yaml already depends on mixins.yaml transitively, through access_requirement.yaml)." ;
    skos:inScheme governanceduo:mixins .

governanceduo:ContributionMixin a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "ContributionMixin" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty governanceduo:contributorName ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty governanceduo:contributionDate ] ;
    skos:definition "Contribution/authorship tracking. Only AccessRequirement uses this today, but it is factored out here (rather than inlined) so any class that later needs the same fields reuses it instead of duplicating — mirroring SageCommonDataModel's practice of factoring cross-cutting concerns out of individual entity files even before a second consumer exists." ;
    skos:inScheme governanceduo:mixins .

governanceduo:CredentialRequirement a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "CredentialRequirement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty governanceduo:requiredClaims ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty governanceduo:credentialType ] ;
    skos:definition "One credential type a Policy Fabric policy_card requires the requester to present, and the specific claim path(s) it checks — verified from the folder's actual policy.rego, not inferred from the credential's schema alone (a credential type can be required without every one of its claims being read by a given policy)." ;
    skos:inScheme governanceduo:policy_fabric .

governanceduo:PolicyCardBinding a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "PolicyCardBinding" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty governanceduo:dataUseModifier ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty governanceduo:policyCardName ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:capabilityOperation ] ;
    skos:definition "One row per verified tmp-policies policy_cards/<name>/ folder: which DUO code it implements, its Reference Values Schema key(s), which existing (or missing) governanceDUO slot already collects each reference value, and which credentials/claims it requires. A referenceValueKey with no entry in referenceValueSources is intentionally left unmapped (rather than force-fit) wherever governanceDUO has no existing slot of the right shape — see policy_fabric_bindings.yaml's `notes` for any such case." ;
    skos:inScheme governanceduo:policy_fabric .

governanceduo:PolicyFabricMixin a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "PolicyFabricMixin" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:guardianDataSource ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^did:[a-z0-9]+:.+$" ] ) ] ;
            owl:onProperty governanceduo:policyContractDid ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:guardianUrl ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^did:[a-z0-9]+:.+$" ] ) ] ;
            owl:onProperty governanceduo:trustedIssuerDids ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:policyContractDid ] ;
    skos:definition "Fields needed to deploy an AccessRequirement's governed entities into Policy Fabric (https://github.com/hasan7n/tmp-policies) as a registered Asset with an exposed policy. All optional — a governanceDUO record can exist before, or without ever, being deployed into Policy Fabric. Applied only to AccessRequirement: it already carries entityIdList (the concrete Synapse containers governed) and dataUseModifiers (which DUO codes/policy_cards apply), making it the natural analog of Policy Fabric's Asset + exposed-policy pairing — see linkml/policy_fabric.yaml and policy_fabric_bindings.yaml for the per-DUO-code credential/reference-value crosswalk this pairs with." ;
    skos:inScheme governanceduo:mixins .

governanceduo:Principal a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "Principal" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:company ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty governanceduo:principalType ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty governanceduo:principalId ] ;
    skos:closeMatch prov:Agent ;
    skos:definition """A Synapse user or team being granted access via an ACL. Mirrors ACL_RESOURCE_ACCESS.GROUP_ID (the id of the user or team being granted access) with an explicit type discriminator, since a bare GROUP_ID doesn't distinguish the two on its own. Deliberately not `is_a: BaseEntity`, and for a different reason than DataAccessSubmissionStatus's (see that class's own description): unlike AccessGrant/AccessRequirementAssociation/ DataAccessSubmission -- which mint a *synthetic* BaseEntity id specifically because their underlying Synapse tables have no single natural key for the merged, first-class thing being modeled -- GROUP_ID already *is* a real, unambiguous, already-existing natural key (Synapse's own numeric Principal/UserGroup id), so there's nothing to synthesize. It's also an integer, not a string, so reusing BaseEntity's generically string-typed `id` slot would require both a range override and renaming this attribute from principalId to literally `id` (slot_usage overrides a slot's attributes; it can't let a differently-named slot stand in for it) -- sacrificing the direct principalId <-> ACL_RESOURCE_ACCESS.GROUP_ID column traceability this schema preserves everywhere else (see SynapseAccessRequirementMixin's real-column-name convention).
`company` mirrors Synapse's real UserProfile.company field ("This person's current affiliation") -- a genuine per-Principal institution signal, verified directly against the OpenAPI spec, resolving the target ontology's gov:affiliatedWith (Principal -> Site) as real data, not just an aspiration (see plans/governance_graph_open_questions.md Section C). Only meaningful for `principalType: User`: Synapse's real Team object has no institution/affiliation field of its own.""" ;
    skos:exactMatch sagegov:Principal ;
    skos:inScheme governanceduo:governance_graph .

governanceduo:ReferenceValueSource a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "ReferenceValueSource" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty governanceduo:keyIsMultivalued ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty governanceduo:referenceValueKey ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:sourceField ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty governanceduo:sourceSlot ] ;
    skos:definition "One (referenceValueKey -> governanceDUO slot) mapping. A single PolicyCardBinding can need more than one of these — e.g. time-limit-on-use needs both requiredDocumentID and notAfter, sourced from two different slots — so this is its own inlined list on PolicyCardBinding rather than one scalar \"sourceSlot\" field (an earlier version of this schema had exactly that limitation; it could not represent a binding needing 2+ keys from 2+ slots)." ;
    skos:inScheme governanceduo:policy_fabric .

governanceduo:Resource a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "Resource" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:speciesTypeValue ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:SchemaKey ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:speciesTypeKey ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:activationValue ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:dataTypeValue ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:studyAnnotationValue ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:dataTypeKey ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:grantAnnotationValue ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:grantAnnotationKey ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:registeredSchemaUrl ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty governanceduo:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:studyAnnotationKey ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:activatedByAttribute ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^resource\\.[A-Za-z0-9]+$" ] ) ] ;
            owl:onProperty governanceduo:id ],
        governanceduo:BaseEntity,
        governanceduo:GovernanceMixin ;
    skos:definition "Information that is relevant to resource access conditions." ;
    skos:inScheme governanceduo:resource .

governanceduo:Schema a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "Schema" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty governanceduo:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^schema\\.[A-Za-z0-9_-]+$" ] ) ] ;
            owl:onProperty governanceduo:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:schemaUrl ],
        governanceduo:BaseEntity ;
    skos:definition "Information that is relevant to resource access conditions." ;
    skos:inScheme governanceduo:schema .

governanceduo:SchemaKey a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "SchemaKey" ;
    skos:definition "The Schema id corresponding to a registered JSON schema that describes the access conditions relevant to this Resource." ;
    skos:inScheme governanceduo:resource ;
    skos:note "Untyped string, not range: Schema -- see props.yaml's AccessRequirementKey comment for why (this file cannot import schema.yaml without risking a cycle)." ;
    governanceduo:foreign_key true .

governanceduo:Study a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "Study" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:studyDeidentificationMethodSoftware ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty governanceduo:studyInvestigator ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty governanceduo:studyDescription ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty governanceduo:studyName ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^study\\.[A-Za-z0-9_-]+$" ] ) ] ;
            owl:onProperty governanceduo:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:studyDeidentificationMethodDescription ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty governanceduo:studyParticipantNumber ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^syn\\d+$" ] ) ] ;
            owl:onProperty governanceduo:studyProjectIdentifier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:studyDbgapAccessionId ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty governanceduo:studySampleNumber ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty governanceduo:id ],
        governanceduo:BaseEntity,
        governanceduo:GovernanceMixin ;
    skos:definition "Studies associated with a grant." ;
    skos:inScheme governanceduo:study .

governanceduo:SynapseAccessRequirementMixin a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "SynapseAccessRequirementMixin" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:createdBy ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:createdOn ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:accessType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:isTwoFaRequired ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:etag ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:currentRevNum ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:concreteType ] ;
    skos:definition "The real Synapse-native ACCESS_REQUIREMENT row fields (verified against \"sagebrain governance graph ACL_AR data - AR table schemas.csv\" plus the live/source lookups documented on the shared slots and enums above), applied to AccessRequirement alongside GovernanceMixin (the DUO characterization of an AR's conditions) and ContributionMixin (this repo's own curator-provenance fields — distinct from Synapse's own createdBy/ createdOn here, see those slots' descriptions). Part of aligning governanceDUO with the SageBrain Governance Graph design, where an AccessRequirement is a first-class graph entity with its own Synapse identity, not only a DUO-condition record." ;
    skos:inScheme governanceduo:mixins .

governanceduo:accessRequirement a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "accessRequirement" ;
    rdfs:range governanceduo:AccessRequirement ;
    skos:closeMatch dcterms:requires ;
    skos:definition "The AccessRequirement this association binds to the resource." ;
    skos:inScheme governanceduo:governance_graph .

governanceduo:accessRequirementVersion a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "accessRequirementVersion" ;
    rdfs:range linkml:Integer ;
    skos:definition "The version of the AccessRequirement this submission was made against (DATA_ACCESS_SUBMISSION.ACCESS_REQUIREMENT_VERSION)." ;
    skos:inScheme governanceduo:governance_graph .

governanceduo:accessType a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "accessType" ;
    rdfs:range governanceduo:AccessTypeEnum ;
    skos:definition "The kind of access this Access Requirement governs (ACCESS_REQUIREMENT.ACCESS_TYPE). Range is the same AccessTypeEnum used by AccessGrant.permission in governance_graph.yaml — one real Synapse ACCESS_TYPE type backs both an ACL grant's permission and an Access Requirement's own governed access kind." ;
    skos:inScheme governanceduo:mixins .

governanceduo:accessorId a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "accessorId" ;
    rdfs:range linkml:Integer ;
    skos:definition "Synapse numeric id of the Principal approved for access (AccessApproval.accessorId). Emitted as an IRI reference to a sagegov:Principal node, mapping onto the target ontology's gov:heldBy predicate." ;
    skos:inScheme governanceduo:governance_graph .

governanceduo:activatedByAttribute a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "activatedByAttribute" ;
    skos:definition "The name of a Synapse annotation key that will be applied to entities released under this AR. Setting this attribute to activationValue designates that the AR should be active." ;
    skos:inScheme governanceduo:resource .

governanceduo:activationValue a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "activationValue" ;
    skos:definition "The value of Synapse annotation recorded under activatedByAttribute that will be applied to entities released under this AR to indicate the AR should be active." ;
    skos:inScheme governanceduo:resource .

governanceduo:alias a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "alias" ;
    skos:definition "The Synapse entity's alias (NODE.ALIAS), if any." ;
    skos:inScheme governanceduo:governance_graph .

governanceduo:allowedAccountTypes a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "allowedAccountTypes" ;
    skos:definition "Account type(s) permitted to access the data (checked against UserPlatformCredential.accountType). Added to close the same user-specific-restriction gap as approvedUsers." ;
    skos:inScheme governanceduo:mixins ;
    skos:note "Required when dataUseModifiers contains DUO:0000026 — see GovernanceMixin rules." .

governanceduo:approvedUsers a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "approvedUsers" ;
    skos:definition "Identifier(s) of specifically approved users. Added to close a Policy Fabric gap: user-specific-restriction keys part of its Reference Values Schema on a multivalued approvedUsers list, checked against UserPlatformCredential.userId — the existing userSpecificRestriction slot is free text describing the restriction, not a structured list of identifiers, so this is a new, distinct slot (userSpecificRestriction, allowedAccountTypes, and requiredProfileStatuses together cover the three separate keys this one policy_card's Reference Values Schema defines)." ;
    skos:inScheme governanceduo:mixins ;
    skos:note "Required when dataUseModifiers contains DUO:0000026 — see GovernanceMixin rules." .

governanceduo:capabilityOperation a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "capabilityOperation" ;
    skos:definition "The \"name\" field of the Capability Granted this policy_card's Rego emits on success (every one of the 21 verified policy_cards emits \"do_download\" today — Policy Fabric has not yet diversified beyond dataset download)." ;
    skos:inScheme governanceduo:policy_fabric ;
    skos:note "Related to, but intentionally not unified with, mixins.yaml's AccessTypeEnum (used by AccessGrant.permission and AccessRequirement.accessType): both describe \"what operation is being granted,\" but AccessTypeEnum is Synapse's own closed ACL vocabulary while this slot is Policy Fabric's free-string Rego capability-name convention -- the two vocabularies belong to different external systems and may drift independently, so this stays a free string rather than being coerced into AccessTypeEnum." .

governanceduo:company a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "company" ;
    skos:definition "Institution/company name, verbatim from Synapse's real UserProfile.company field (\"This person's current affiliation\"). Consumed by build_governance_graph.py's site_node_for() to derive a gov:affiliatedWith edge to a gov:Site node -- not independently re-emitted as its own literal predicate on the Principal subject. Only meaningful for `principalType: User`." ;
    skos:inScheme governanceduo:governance_graph .

governanceduo:concreteType a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "concreteType" ;
    rdfs:range governanceduo:AccessRequirementConcreteTypeEnum ;
    skos:definition "Which kind of Access Requirement this is (ACCESS_REQUIREMENT.CONCRETE_TYPE). The real Synapse column stores the full Java class name (e.g. \"org.sagebionetworks.repo.model.ManagedACTAccessRequirement\"); this enum uses the short class name for readability." ;
    skos:inScheme governanceduo:mixins .

governanceduo:conditionType a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "conditionType" ;
    skos:definition "A short label for this condition. For the 24 real DUO codes in DataUseModifierEnum, this is that code's own duo_shorthand annotation (e.g. \"GRU\", \"COL\"); the 7 Sage-local DUOPlus1-7 extensions have no duo_shorthand/meaning: CURIE at all, so their bare enum key (e.g. \"DUOPlus1\") is used instead -- see scripts/build_governance_graph.py." ;
    skos:inScheme governanceduo:governance_graph .

governanceduo:contributionDate a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "contributionDate" ;
    skos:closeMatch prov:generatedAtTime ;
    skos:definition "The date on which the access requirement was added." ;
    skos:inScheme governanceduo:mixins ;
    skos:note "prov:generatedAtTime (\"The time at which an entity was completely created and is available for use\") matches this slot's semantics closely, treating the AccessRequirement record itself as the generated prov:Entity.",
        "schematic Format: date" .

governanceduo:contributorName a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "contributorName" ;
    skos:closeMatch prov:wasAttributedTo ;
    skos:definition "The name of the person who added this access requirement." ;
    skos:inScheme governanceduo:mixins ;
    skos:note "prov:wasAttributedTo relates a prov:Entity to a prov:Agent; this slot holds a literal name rather than an Agent reference, so the mapping is close, not exact." .

governanceduo:credentialType a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "credentialType" ;
    rdfs:range governanceduo:CredentialTypeEnum ;
    skos:inScheme governanceduo:policy_fabric .

governanceduo:dataPermission a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "dataPermission" ;
    rdfs:range governanceduo:DataPermissionEnum ;
    skos:definition "The permissions associated with the data under the access requirement. Equivalent to DUOPlus4." ;
    skos:inScheme governanceduo:mixins ;
    skos:note "Required when dataUseModifiers contains DUOPlus4 — see GovernanceMixin rules." .

governanceduo:dataTier a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "dataTier" ;
    rdfs:range governanceduo:DataTierEnum ;
    skos:definition "The tier of data access associated with the access requirement. Equivalent to DUOPlus5." ;
    skos:exactMatch NCIT:C175887 ;
    skos:inScheme governanceduo:mixins ;
    skos:note "NCIT:C175887 \"Open or Controlled Data Access Indicator\" (synonym: \"Data Access Level\") is defined as \"Specifies whether the data in a repository is open access or controlled access\" — a direct match for this slot's Anonymous/Open/Controlled/Private tiers.",
        "Required when dataUseModifiers contains DUOPlus5 — see GovernanceMixin rules." .

governanceduo:dataTypeKey a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "dataTypeKey" ;
    skos:definition "The annotation key applied to a Synapse entity that contains a data type identifier." ;
    skos:inScheme governanceduo:resource .

governanceduo:dataTypeValue a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "dataTypeValue" ;
    skos:definition "The value that will be assigned to the key provided under dataTypeKey. Value should be applied to Synapse entities released with this AR." ;
    skos:inScheme governanceduo:resource .

governanceduo:deidentificationType a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "deidentificationType" ;
    rdfs:range governanceduo:DeidentificationTypeEnum ;
    skos:closeMatch T4FS:0000414 ;
    skos:definition "The type of de-identification applied to the data associated with the access requirement. Equivalent to DUOPlus3." ;
    skos:inScheme governanceduo:mixins ;
    skos:note "Required when dataUseModifiers contains DUOPlus3 — see GovernanceMixin rules.",
        "T4FS:0000414 \"de-identification\" (Terminology for Food Safety, but the term itself is a generic privacy concept) is a close, not exact, match — this slot names one of a specific set of methods (HIPPA_LDS/SafeHarbor/etc.), the OLS term describes the general technique." .

governanceduo:description a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "description" ;
    skos:definition "Human-readable description of this condition, taken directly from DataUseModifierEnum.permissible_values[code]'s own description: text, not re-authored here." ;
    skos:exactMatch dcterms:description ;
    skos:inScheme governanceduo:governance_graph .

governanceduo:drsId a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "drsId" ;
    skos:definition "The DRS DrsObject.id component. Recommended to be identical to synapseId — see this schema's own header comment for why a fourth internal identifier scheme isn't introduced here." ;
    skos:inScheme governanceduo:drs_alignment .

governanceduo:duoCode a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "duoCode" ;
    rdfs:range governanceduo:DataUseModifierEnum ;
    skos:definition "The real DUO CURIE this condition represents, when one exists. Deliberately not required: the 7 Sage-local DUOPlus1-7 extensions in DataUseModifierEnum have no meaning: CURIE at all -- see conditionType above for how those are represented instead." ;
    skos:inScheme governanceduo:governance_graph .

governanceduo:entityIdList a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "entityIdList" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^syn\\d+$" ] ) ] ;
    skos:definition "Synapse ID(s) for Synapse container(s) (e.g. Project, Dataset, Folder, Table, etc.) with which the Access Requirement is expected to be associated. Provide multiple values as a comma-separated list." ;
    skos:inScheme governanceduo:access_requirement .

governanceduo:expiredOn a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "expiredOn" ;
    rdfs:range linkml:Integer ;
    skos:definition "When this approval will expire (epoch milliseconds; AccessApproval.expiredOn in Synapse's live REST API). Maps onto the target ontology's gov:expiresAt -- the real field plans/rebac_governance_graph_alignment.md's first draft was wrong to call an unsourceable gap; see that plan's corrected Grounding section." ;
    skos:inScheme governanceduo:governance_graph .

governanceduo:geographicalRestriction a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "geographicalRestriction" ;
    rdfs:range governanceduo:GeographicalRegionEnum ;
    skos:definition "The specific geographic region(s) to which use is limited by the access requirement." ;
    skos:inScheme governanceduo:mixins ;
    skos:note "Required when dataUseModifiers contains DUO:0000022 — see GovernanceMixin rules." .

governanceduo:grantAnnotationKey a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "grantAnnotationKey" ;
    skos:definition "The annotation key applied to a Synapse entity that contains a grant identifier." ;
    skos:inScheme governanceduo:resource .

governanceduo:grantAnnotationValue a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "grantAnnotationValue" ;
    skos:definition "The value that will be assigned to the key provided under grantAnnotationKey. Value should be applied to Synapse entities released with this AR." ;
    skos:inScheme governanceduo:resource .

governanceduo:guardianDataSource a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "guardianDataSource" ;
    skos:definition "The data path/source configured for this asset's Guardian. Mirrors Asset.metadata.data_source, set by convention (not schema) in tmp-policies/tools/pdo_client at asset-setup time." ;
    skos:inScheme governanceduo:mixins .

governanceduo:guardianUrl a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "guardianUrl" ;
    skos:definition "The deployed Guardian service URL for this asset. Mirrors Asset.metadata.guardian_url, set by the same asset-setup convention." ;
    skos:inScheme governanceduo:mixins .

governanceduo:institutionDids a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "institutionDids" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^did:[a-z0-9]+:.+$" ] ) ] ;
    skos:definition "Institutions with specific restrictions associated with the access requirement, as decentralized identifiers (DIDs) rather than ROR ids. Policy Fabric (https://github.com/hasan7n/tmp-policies)'s institution-specific-restriction policy_card expects its allowedInstitutions reference values, and the AffiliationCredential.isMemberOf claim it checks against them, to both be organization DIDs — not ROR ids. No standard ROR-to-DID resolution exists yet, so this is a separate, companion slot rather than a reinterpretation of institutionSpecificRestriction's existing pattern." ;
    skos:inScheme governanceduo:mixins .

governanceduo:intendedDataUseStatement a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "intendedDataUseStatement" ;
    skos:definition "A few short paragraphs explaining how the controlled data will be used (ResearchProject.intendedDataUseStatement)." ;
    skos:inScheme governanceduo:governance_graph .

governanceduo:isTwoFaRequired a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "isTwoFaRequired" ;
    rdfs:range linkml:Boolean ;
    skos:definition "Whether two-factor authentication is required (ACCESS_REQUIREMENT.IS_TWO_FA_REQUIRED)." ;
    skos:inScheme governanceduo:mixins .

governanceduo:keyIsMultivalued a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "keyIsMultivalued" ;
    rdfs:range linkml:Boolean ;
    skos:definition "True if this referenceValueKey's own policy_data_schema.json documents it as a list (e.g. \"list of strings\"); False if it's a single scalar value (e.g. requiredDocumentID, notAfter, datasetID — each documented as \"DID of ...\"/an ISO-8601 datetime, not a list). This is a property of the Policy Fabric key itself, independent of whether its governanceDUO sourceSlot happens to be multivalued — e.g. datasetID is scalar even though it is sourced from the multivalued assetBindings slot (build_policy_fabric.py takes assetBindings[0].assetDid)." ;
    skos:inScheme governanceduo:policy_fabric .

governanceduo:license a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "license" ;
    rdfs:range governanceduo:LicenseEnum ;
    skos:definition "The license under which the data associated with the access requirement is shared. Equivalent to DUOPlus6." ;
    skos:inScheme governanceduo:mixins ;
    skos:note "Required when dataUseModifiers contains DUOPlus6 — see GovernanceMixin rules." .

governanceduo:maxRevNum a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "maxRevNum" ;
    skos:definition "The maximum revision number of this Synapse entity (NODE.MAX_REV_NUM)." ;
    skos:inScheme governanceduo:governance_graph .

governanceduo:modifiedBy a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "modifiedBy" ;
    rdfs:range linkml:Integer ;
    skos:closeMatch dcterms:contributor ;
    skos:definition "Synapse numeric user id of who last modified this record. On DataAccessSubmission, this is `Submission.modifiedBy` in Synapse's live REST API (moved here from DataAccessSubmissionStatus, which does not carry this field live; see DataAccessSubmissionStatus's own description); on DataAccessRequest, it's `RequestInterface.modifiedBy`. Emitted as an IRI reference to a sagegov:Principal node, not a literal, mirroring submittedBy above." ;
    skos:inScheme governanceduo:governance_graph .

governanceduo:modifiedOn a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "modifiedOn" ;
    rdfs:range linkml:Integer ;
    skos:definition "When this record was last modified (epoch milliseconds). On DataAccessSubmissionStatus this is emitted under the distinct gov:statusModifiedOn predicate instead (a bare constant in build_governance_graph.py, not resolved via this slot_uri -- see that class's own description); DataAccessRequest resolves it via this slot's own sagegov:modifiedOn directly." ;
    skos:exactMatch dcterms:modified ;
    skos:inScheme governanceduo:governance_graph .

governanceduo:nodeType a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "nodeType" ;
    skos:definition "The kind of Synapse entity (NODE.NODE_TYPE), e.g. project, folder, file, table. **Not independently verified** against a canonical enum in this pass — modeled as an open string rather than a fabricated enum, unlike AccessTypeEnum/AccessRequirementConcreteTypeEnum/SubmissionStateEnum above, all three of which were confirmed against a real source. Common Synapse entity types (project/folder/file/link/table/view/dockerrepo) are well known but not cited here as a closed, checked list." ;
    skos:inScheme governanceduo:governance_graph .

governanceduo:parentId a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "parentId" ;
    rdfs:range governanceduo:SynapseEntity ;
    skos:definition "The parent Synapse entity in the containment hierarchy (NODE.PARENT_ID) — used to resolve direct-vs-inherited governance (e.g. a file inheriting its parent study's Access Requirement, per the design doc's \"Direct and Inherited Governance\" section)." ;
    skos:exactMatch dcterms:isPartOf ;
    skos:inScheme governanceduo:governance_graph .

governanceduo:passportAuthIssuers a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "passportAuthIssuers" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^did:[a-z0-9]+:.+$" ] ) ] ;
    skos:definition "Mirrors DRS's Authorizations.passport_auth_issuers — the whitelisted set of Visa `iss` issuers a client must draw from. Not populated here from a fixed value: sourced, per governed AccessRequirement, from that record's own PolicyFabricMixin.trustedIssuerDids (or, for institution-scoped DUO codes, GovernanceMixin.institutionDids) — see mixins.yaml. GA4GH Passport Visa issuers are conventionally identified as DIDs or URLs the same way those slots already are." ;
    skos:inScheme governanceduo:drs_alignment .

governanceduo:permission a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "permission" ;
    rdfs:range governanceduo:AccessTypeEnum ;
    skos:definition "The permission(s) granted (ACL_RESOURCE_ACCESS_TYPE.STRING_ELE). Multivalued: a single ACL_RESOURCE_ACCESS row can carry more than one permission type." ;
    skos:inScheme governanceduo:governance_graph .

governanceduo:policyCardName a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "policyCardName" ;
    skos:definition "The literal tmp-policies policy_cards/<name>/ folder name, e.g. \"geographical-restriction\"." ;
    skos:inScheme governanceduo:policy_fabric .

governanceduo:principal a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "principal" ;
    rdfs:range governanceduo:Principal ;
    skos:closeMatch prov:agent ;
    skos:definition "The user or team this grant applies to." ;
    skos:inScheme governanceduo:governance_graph .

governanceduo:principalId a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "principalId" ;
    rdfs:range linkml:Integer ;
    skos:definition "The Synapse numeric id of the user or team (ACL_RESOURCE_ACCESS.GROUP_ID)." ;
    skos:inScheme governanceduo:governance_graph .

governanceduo:principalType a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "principalType" ;
    rdfs:range governanceduo:PrincipalTypeEnum ;
    skos:inScheme governanceduo:governance_graph .

governanceduo:projectLead a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "projectLead" ;
    skos:definition "The person leading this research project (ResearchProject.projectLead)." ;
    skos:inScheme governanceduo:governance_graph .

governanceduo:referenceValueKey a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "referenceValueKey" ;
    skos:definition "One of the containing binding's referenceValueKeys, e.g. \"allowedCountries\"." ;
    skos:inScheme governanceduo:policy_fabric .

governanceduo:registeredSchemaUrl a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "registeredSchemaUrl" ;
    skos:definition "URL associated with the annotation schema that will be applied to the resource type." ;
    skos:exactMatch dcterms:conformsTo ;
    skos:inScheme governanceduo:resource ;
    skos:note "dcterms:conformsTo, \"An established standard to which the described resource conforms\" — exact match: this URL points at the registered JSON schema the resource must conform to." .

governanceduo:rejectedReason a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "rejectedReason" ;
    skos:definition "The reason this submission was rejected, if it was. Synapse's live API names this field `rejectedReason` (`org.sagebionetworks.repo.model.dataaccess.SubmissionStatus`), not `reason`; stored as DATA_ACCESS_SUBMISSION_STATUS.REASON (a BINARY column) in the underlying table." ;
    skos:inScheme governanceduo:governance_graph .

governanceduo:requestId a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "requestId" ;
    rdfs:range linkml:Integer ;
    skos:definition "The originating data access request id. Synapse's live API names this field `requestId` (`org.sagebionetworks.repo.model.dataaccess.Submission`), not `dataAccessRequestId`; the underlying DB column is DATA_ACCESS_SUBMISSION.DATA_ACCESS_REQUEST_ID." ;
    skos:inScheme governanceduo:governance_graph .

governanceduo:requiredClaims a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "requiredClaims" ;
    skos:definition "Dot-path claim name(s) this policy_card's Rego logic actually reads, e.g. \"locatedAt.country\"." ;
    skos:inScheme governanceduo:policy_fabric .

governanceduo:requiredProfileStatuses a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "requiredProfileStatuses" ;
    skos:definition "Profile status value(s) a requester's account must have (checked against UserPlatformCredential.profileStatus). Added to close the same user-specific-restriction gap as approvedUsers." ;
    skos:inScheme governanceduo:mixins ;
    skos:note "Required when dataUseModifiers contains DUO:0000026 — see GovernanceMixin rules." .

governanceduo:requirementId a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "requirementId" ;
    rdfs:range governanceduo:AccessRequirement ;
    skos:definition "The AccessRequirement this approval satisfies (AccessApproval.requirementId in Synapse's live REST API). Distinct LinkML slot from AccessRequirementAssociation.accessRequirement/ DataAccessSubmission.accessRequirementId (which share sagegov:accessRequirement) -- this one maps onto the target ontology's gov:satisfies predicate instead, since AccessApproval specifically represents *satisfaction* of a requirement, not just a binding or an application against it." ;
    skos:inScheme governanceduo:governance_graph .

governanceduo:requirementVersion a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "requirementVersion" ;
    rdfs:range linkml:Integer ;
    skos:definition "The version of the AccessRequirement this approval satisfies (AccessApproval.requirementVersion)." ;
    skos:inScheme governanceduo:governance_graph .

governanceduo:researchProjectId a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "researchProjectId" ;
    rdfs:range governanceduo:ResearchProject ;
    skos:definition "The research project this submission is associated with (DATA_ACCESS_SUBMISSION.RESEARCH_PROJECT_ID). Range is now `ResearchProject` (was a bare integer literal until that class existed -- see plans/governance_graph_open_questions.md Section C) -- emitted as an IRI reference to the real `gov:research-project-<n>` node." ;
    skos:inScheme governanceduo:governance_graph ;
    skos:note "DATA_ACCESS_SUBMISSION.SUBMISSION_SERIALIZED (a BINARY blob, presumably the full submission form data) is not modeled as a structured field." .

governanceduo:schemaUrl a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "schemaUrl" ;
    skos:definition "The registered URL associated with the access requirement JSON schema." ;
    skos:exactMatch dcterms:conformsTo ;
    skos:inScheme governanceduo:schema ;
    skos:note "dcterms:conformsTo, \"An established standard to which the described resource conforms\" — see resource.yaml's registeredSchemaUrl for the same exact mapping and rationale." .

governanceduo:sourceAclId a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "sourceAclId" ;
    rdfs:range linkml:Integer ;
    skos:definition "Traceability back to the literal ACL.ID row this grant was derived from." ;
    skos:inScheme governanceduo:governance_graph .

governanceduo:sourceAclResourceAccessId a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "sourceAclResourceAccessId" ;
    rdfs:range linkml:Integer ;
    skos:definition "Traceability back to the literal ACL_RESOURCE_ACCESS.ID row this grant was derived from." ;
    skos:inScheme governanceduo:governance_graph .

governanceduo:sourceApprovalId a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "sourceApprovalId" ;
    rdfs:range linkml:Integer ;
    skos:definition "Traceability back to the literal AccessApproval.id row this record was derived from." ;
    skos:inScheme governanceduo:governance_graph .

governanceduo:sourceField a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "sourceField" ;
    skos:definition "When sourceSlot names an inlined class (e.g. PolicyFabricMixin.assetBindings, range AssetBinding), the sub-field of each element to extract — e.g. sourceSlot: assetBindings, sourceField: assetDid pulls AssetBinding.assetDid out of each entry. Unset when sourceSlot is a flat scalar/list slot." ;
    skos:inScheme governanceduo:policy_fabric .

governanceduo:sourceGeography a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "sourceGeography" ;
    rdfs:range governanceduo:GeographicalRegionEnum ;
    skos:definition "The geographical source of the data associated with the access requirement. Equivalent to DUOPlus1." ;
    skos:inScheme governanceduo:mixins ;
    skos:note "Required when dataUseModifiers contains DUOPlus1 — see GovernanceMixin rules." .

governanceduo:sourceSlot a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "sourceSlot" ;
    skos:definition "The name of the governanceDUO slot (on GovernanceMixin, Study, or the PolicyFabricMixin) that collects the value for the paired referenceValueKey." ;
    skos:inScheme governanceduo:policy_fabric .

governanceduo:speciesTypeKey a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "speciesTypeKey" ;
    skos:definition "The annotation key applied to a Synapse entity that contains a species identifier." ;
    skos:inScheme governanceduo:resource .

governanceduo:speciesTypeValue a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "speciesTypeValue" ;
    skos:definition "The value that will be assigned to the key provided under speciesTypeKey. Value should be applied to Synapse entities released with this AR." ;
    skos:inScheme governanceduo:resource .

governanceduo:state a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "state" ;
    rdfs:range governanceduo:SubmissionStateEnum ;
    skos:inScheme governanceduo:governance_graph .

governanceduo:status a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "status" ;
    rdfs:range governanceduo:ApprovalStateEnum ;
    skos:definition "The state of this approval (AccessApproval.state in Synapse's live REST API -- renamed to \"status\" here specifically to avoid colliding with DataAccessSubmission/Status's own \"state\" slot, which ranges over the unrelated SubmissionStateEnum). Maps onto the target ontology's gov:status." ;
    skos:inScheme governanceduo:governance_graph .

governanceduo:studyAnnotationKey a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "studyAnnotationKey" ;
    skos:definition "The annotation key applied to a Synapse entity that contains a study identifier." ;
    skos:inScheme governanceduo:resource .

governanceduo:studyAnnotationValue a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "studyAnnotationValue" ;
    skos:definition "The value that will be assigned to the key provided under studyAnnotationKey. Value should be applied to Synapse entities released with this AR." ;
    skos:inScheme governanceduo:resource .

governanceduo:studyDbgapAccessionId a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "studyDbgapAccessionId" ;
    skos:definition "A stable unique alphanumeric identifier assigned to a study and any objects by the database of Genotypes and Phenotypes (dbGaP). Required for controlled access data being submitted to CDS/CRDC." ;
    skos:exactMatch NCIT:C173940 ;
    skos:inScheme governanceduo:study ;
    skos:note "NCIT:C173940 \"dbGaP Accession Number\" — its OLS definition text is word-for- word this slot's description (the CSV description likely originates from this NCIT term already)." ;
    governanceduo:cde_id "11524544" .

governanceduo:studyDeidentificationMethodDescription a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "studyDeidentificationMethodDescription" ;
    skos:definition "Description of the process of removing potentially identifying data or data elements to render data into a form that does not identify individuals and where identification is not likely to take place." ;
    skos:inScheme governanceduo:study .

governanceduo:studyDeidentificationMethodSoftware a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "studyDeidentificationMethodSoftware" ;
    skos:definition "Software that was used to de-identify the data (if used)." ;
    skos:inScheme governanceduo:study .

governanceduo:studyDescription a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "studyDescription" ;
    skos:definition "Description of the study, including the types of experimental assays, model systems, types of analysis, description of cohort, associated vulnerable populations, special categories of data, rare diseases, etc. Maps to DUOPlus2." ;
    skos:inScheme governanceduo:study ;
    governanceduo:cde_id "03444002" .

governanceduo:studyInvestigator a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "studyInvestigator" ;
    skos:closeMatch NCIT:C19924 ;
    skos:definition "Investigator(s) associated with the project. Multiple names should be provided as a comma-separated list." ;
    skos:inScheme governanceduo:study ;
    skos:note "NCIT:C19924 \"Principal Investigator\" — a role concept, not a name; this slot holds literal investigator name(s), so the mapping is close, not exact." .

governanceduo:studyName a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "studyName" ;
    skos:definition "Name of the study." ;
    skos:inScheme governanceduo:study ;
    governanceduo:cde_id "11459810" .

governanceduo:studyParticipantNumber a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "studyParticipantNumber" ;
    rdfs:range linkml:Float ;
    skos:definition "The number of participant instances associated with systematic investigation into a subject." ;
    skos:inScheme governanceduo:study ;
    governanceduo:cde_id "11555662" .

governanceduo:studyProjectIdentifier a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "studyProjectIdentifier" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^syn\\d+$" ] ) ] ;
    skos:definition "The Synapse Project identifier (synID) with which this Study is related." ;
    skos:inScheme governanceduo:study .

governanceduo:studySampleNumber a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "studySampleNumber" ;
    rdfs:range linkml:Float ;
    skos:definition "The number of specimens associated with systematic investigation into a subject." ;
    skos:inScheme governanceduo:study ;
    governanceduo:cde_id "11555663" .

governanceduo:submissionId a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "submissionId" ;
    rdfs:range governanceduo:DataAccessSubmission ;
    skos:definition "The DataAccessSubmission this status record applies to (DATA_ACCESS_SUBMISSION_STATUS.SUBMISSION_ID)." ;
    skos:inScheme governanceduo:governance_graph .

governanceduo:submittedBy a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "submittedBy" ;
    rdfs:range linkml:Integer ;
    skos:definition "Synapse numeric user id of who submitted this record (`Submission.submittedBy` in Synapse's live REST API). Emitted as an IRI reference to a sagegov:Principal node (looked up by this numeric id), not a literal -- see scripts/build_governance_graph.py." ;
    skos:inScheme governanceduo:governance_graph .

governanceduo:submittedOn a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "submittedOn" ;
    rdfs:range linkml:Integer ;
    skos:definition "When this record was submitted (epoch milliseconds; `Submission.submittedOn` in Synapse's live REST API)." ;
    skos:inScheme governanceduo:governance_graph .

governanceduo:submitterId a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "submitterId" ;
    rdfs:range linkml:Integer ;
    skos:definition "Synapse numeric user id of who performed the actions to gain this approval (AccessApproval.submitterId). Reuses DataAccessSubmission's sagegov:submittedBy predicate -- same real-world concept (who acted on the governance workflow), emitted as an IRI reference to a sagegov:Principal node, not a literal." ;
    skos:inScheme governanceduo:governance_graph .

governanceduo:trustedIssuerDids a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "trustedIssuerDids" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^did:[a-z0-9]+:.+$" ] ) ] ;
    skos:definition "DID(s) of the Verifiable Credential issuer(s) this AccessRequirement's owner trusts to attest the claims its selected DUO codes require (see policy_fabric_bindings.yaml's requiredCredentials per code). Unlike PolicyCardBinding.requiredCredentials (a static, per-DUO-code fact), this varies per AccessRequirement — different owners may trust different institutional VC issuers — so it lives here, not in the policy_fabric.yaml lookup schema." ;
    skos:inScheme governanceduo:mixins .

DUO:0000004 a owl:Class,
        governanceduo:DataUseModifierEnum ;
    rdfs:label "DUO:0000004" ;
    rdfs:subClassOf governanceduo:DataUseModifierEnum ;
    owl:versionInfo "0.1.0" ;
    skos:definition "No Restriction - This data use permission indicates there is no restriction on use." ;
    skos:scopeNote "No Restriction - This data use permission indicates there is no restriction on use." ;
    governanceduo:duo_shorthand "NRES" .

DUO:0000006 a owl:Class,
        governanceduo:DataUseModifierEnum ;
    rdfs:label "DUO:0000006" ;
    rdfs:subClassOf governanceduo:DataUseModifierEnum ;
    owl:versionInfo "0.1.0" ;
    skos:definition "Health or Medical or Biomedical Research - This data use permission indicates that use is allowed for health/medical/biomedical purposes; does not include the study of population origins or ancestry." ;
    skos:scopeNote "Health or Medical or Biomedical Research - This data use permission indicates that use is allowed for health/medical/biomedical purposes; does not include the study of population origins or ancestry." ;
    governanceduo:duo_shorthand "HMB" .

DUO:0000007 a owl:Class,
        governanceduo:DataUseModifierEnum ;
    rdfs:label "DUO:0000007" ;
    rdfs:subClassOf governanceduo:DataUseModifierEnum ;
    owl:versionInfo "0.1.0" ;
    skos:definition "Disease Specific Research - This data use permission indicates that use is allowed provided it is related to the specified disease. If providing this term, please provide the disease MONDO ID(s) in column diseaseSpecificResearch." ;
    skos:scopeNote "Disease Specific Research - This data use permission indicates that use is allowed provided it is related to the specified disease. If providing this term, please provide the disease MONDO ID(s) in column diseaseSpecificResearch." ;
    governanceduo:duo_shorthand "DS" .

DUO:0000011 a owl:Class,
        governanceduo:DataUseModifierEnum ;
    rdfs:label "DUO:0000011" ;
    rdfs:subClassOf governanceduo:DataUseModifierEnum ;
    owl:versionInfo "0.1.0" ;
    skos:definition "Population Origins or Ancestry Research Only - This data use permission indicates that use of the data is limited to the study of population origins or ancestry." ;
    skos:scopeNote "Population Origins or Ancestry Research Only - This data use permission indicates that use of the data is limited to the study of population origins or ancestry." ;
    governanceduo:duo_shorthand "POA" .

DUO:0000012 a owl:Class,
        governanceduo:DataUseModifierEnum ;
    rdfs:label "DUO:0000012" ;
    rdfs:subClassOf governanceduo:DataUseModifierEnum ;
    owl:versionInfo "0.1.0" ;
    skos:definition "Research Specific Restrictions - This data use modifier indicates that use is limited to studies of a certain research type. If providing this term, please note the research type(s) in column researchSpecificRestrictions." ;
    skos:scopeNote "Research Specific Restrictions - This data use modifier indicates that use is limited to studies of a certain research type. If providing this term, please note the research type(s) in column researchSpecificRestrictions." ;
    governanceduo:duo_shorthand "RS" .

DUO:0000015 a owl:Class,
        governanceduo:DataUseModifierEnum ;
    rdfs:label "DUO:0000015" ;
    rdfs:subClassOf governanceduo:DataUseModifierEnum ;
    owl:versionInfo "0.1.0" ;
    skos:definition "No General Methods Research - This data use modifier indicates that use does not allow methods development research (e.g., development of software or algorithms)." ;
    skos:scopeNote "No General Methods Research - This data use modifier indicates that use does not allow methods development research (e.g., development of software or algorithms)." ;
    governanceduo:duo_shorthand "NMDS" .

DUO:0000016 a owl:Class,
        governanceduo:DataUseModifierEnum ;
    rdfs:label "DUO:0000016" ;
    rdfs:subClassOf governanceduo:DataUseModifierEnum ;
    owl:versionInfo "0.1.0" ;
    skos:definition "Geographical Restriction - This data use modifier indicates that use is limited to genetic studies only (i.e., studies that include genotype research alone or both genotype and phenotype research, but not phenotype research exclusively)" ;
    skos:scopeNote "Geographical Restriction - This data use modifier indicates that use is limited to genetic studies only (i.e., studies that include genotype research alone or both genotype and phenotype research, but not phenotype research exclusively)" ;
    governanceduo:duo_shorthand "GSO" .

DUO:0000017 a owl:Class,
        governanceduo:DataUseModifierEnum ;
    rdfs:label "DUO:0000017" ;
    rdfs:subClassOf governanceduo:DataUseModifierEnum ;
    owl:versionInfo "0.1.0" ;
    skos:definition "Data use modifiers indicate additional conditions for use." ;
    skos:scopeNote "Data use modifiers indicate additional conditions for use." ;
    governanceduo:duo_shorthand "DUM" .

DUO:0000018 a owl:Class,
        governanceduo:DataUseModifierEnum ;
    rdfs:label "DUO:0000018" ;
    rdfs:subClassOf governanceduo:DataUseModifierEnum ;
    owl:versionInfo "0.1.0" ;
    skos:definition "Not-for-Profit, Non-Commercial Use Only - This data use modifier indicates that use of the data is limited to not-for-profit organizations and not-for-profit use, non-commercial use." ;
    skos:scopeNote "Not-for-Profit, Non-Commercial Use Only - This data use modifier indicates that use of the data is limited to not-for-profit organizations and not-for-profit use, non-commercial use." ;
    governanceduo:duo_shorthand "NPUNCU" .

DUO:0000019 a owl:Class,
        governanceduo:DataUseModifierEnum ;
    rdfs:label "DUO:0000019" ;
    rdfs:subClassOf governanceduo:DataUseModifierEnum ;
    owl:versionInfo "0.1.0" ;
    skos:definition "Publication Required - This data use modifier indicates that requestor agrees to make results of studies using the data available to the larger scientific community." ;
    skos:scopeNote "Publication Required - This data use modifier indicates that requestor agrees to make results of studies using the data available to the larger scientific community." ;
    governanceduo:duo_shorthand "PUB" .

DUO:0000020 a owl:Class,
        governanceduo:DataUseModifierEnum ;
    rdfs:label "DUO:0000020" ;
    rdfs:subClassOf governanceduo:DataUseModifierEnum ;
    owl:versionInfo "0.1.0" ;
    skos:definition "Collaboration Required - This data use modifier indicates that the requestor must agree to collaboration with the primary study investigator(s). If providing this term, please note the contact email in column collaborationRequired." ;
    skos:scopeNote "Collaboration Required - This data use modifier indicates that the requestor must agree to collaboration with the primary study investigator(s). If providing this term, please note the contact email in column collaborationRequired." ;
    governanceduo:duo_shorthand "COL" .

DUO:0000021 a owl:Class,
        governanceduo:DataUseModifierEnum ;
    rdfs:label "DUO:0000021" ;
    rdfs:subClassOf governanceduo:DataUseModifierEnum ;
    owl:versionInfo "0.1.0" ;
    skos:definition "Ethics Approval Required - This data use modifier indicates that the requestor must provide documentation of local IRB/ERB approval." ;
    skos:scopeNote "Ethics Approval Required - This data use modifier indicates that the requestor must provide documentation of local IRB/ERB approval." ;
    governanceduo:duo_shorthand "IRB" .

DUO:0000022 a owl:Class,
        governanceduo:DataUseModifierEnum ;
    rdfs:label "DUO:0000022" ;
    rdfs:subClassOf governanceduo:DataUseModifierEnum ;
    owl:versionInfo "0.1.0" ;
    skos:definition "Geographical Restriction - This data use modifier indicates that use is limited to within a specific geographic region. If providing this term, please provide the applicable country code(s) in column geographicalRestriction." ;
    skos:scopeNote "Geographical Restriction - This data use modifier indicates that use is limited to within a specific geographic region. If providing this term, please provide the applicable country code(s) in column geographicalRestriction." ;
    governanceduo:duo_shorthand "GS" .

DUO:0000024 a owl:Class,
        governanceduo:DataUseModifierEnum ;
    rdfs:label "DUO:0000024" ;
    rdfs:subClassOf governanceduo:DataUseModifierEnum ;
    owl:versionInfo "0.1.0" ;
    skos:definition "Publication Moratorium - This data use modifier indicates that requestor agrees not to publish results of studies until a specific date. If providing this term, please provide the date in column publicationMoratorium." ;
    skos:scopeNote "Publication Moratorium - This data use modifier indicates that requestor agrees not to publish results of studies until a specific date. If providing this term, please provide the date in column publicationMoratorium." ;
    governanceduo:duo_shorthand "MOR" .

DUO:0000025 a owl:Class,
        governanceduo:DataUseModifierEnum ;
    rdfs:label "DUO:0000025" ;
    rdfs:subClassOf governanceduo:DataUseModifierEnum ;
    owl:versionInfo "0.1.0" ;
    skos:definition "Time Limit on Use - This data use modifier indicates that use is approved for a specific number of months. If providing this term, please provide the number of months in column timeLimitOnUse." ;
    skos:scopeNote "Time Limit on Use - This data use modifier indicates that use is approved for a specific number of months. If providing this term, please provide the number of months in column timeLimitOnUse." ;
    governanceduo:duo_shorthand "TS" .

DUO:0000026 a owl:Class,
        governanceduo:DataUseModifierEnum ;
    rdfs:label "DUO:0000026" ;
    rdfs:subClassOf governanceduo:DataUseModifierEnum ;
    owl:versionInfo "0.1.0" ;
    skos:definition "User Specific Restriction - This data use modifier indicates that use is limited to use by approved users. If providing this term, please describe the restrictions in column userSpecificRestriction." ;
    skos:scopeNote "User Specific Restriction - This data use modifier indicates that use is limited to use by approved users. If providing this term, please describe the restrictions in column userSpecificRestriction." ;
    governanceduo:duo_shorthand "US" .

DUO:0000027 a owl:Class,
