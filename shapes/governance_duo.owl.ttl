@prefix DUO: <http://purl.obolibrary.org/obo/DUO_> .
@prefix EVORAO: <https://w3id.org/evorao/> .
@prefix NCIT: <http://purl.obolibrary.org/obo/NCIT_> .
@prefix T4FS: <http://purl.obolibrary.org/obo/T4FS_> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dpv: <https://w3id.org/dpv#> .
@prefix ebiswo: <http://www.ebi.ac.uk/swo/SWO_> .
@prefix governanceduo: <https://w3id.org/sage-bionetworks/governance-duo/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sagegov: <https://sagebionetworks.org/governance/> .
@prefix schema1: <http://schema.org/> .
@prefix shex: <http://www.w3.org/ns/shex#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

xsd:anyURI a rdfs:Datatype .

xsd:date a rdfs:Datatype .

xsd:dateTime a rdfs:Datatype .

xsd:decimal a rdfs:Datatype .

xsd:double a rdfs:Datatype .

xsd:time a rdfs:Datatype .

skos:closeMatch a owl:AnnotationProperty .

skos:definition a owl:AnnotationProperty .

skos:exactMatch a owl:AnnotationProperty .

skos:inScheme a owl:AnnotationProperty .

skos:note a owl:AnnotationProperty .

skos:scopeNote a owl:AnnotationProperty .

prov:generated a owl:ObjectProperty ;
    rdfs:label "generated" ;
    skos:definition "The SynapseEntities this Activity produced, as syn: CURIEs. Multivalued: Synapse lets one Activity be the generatedBy of several entities (GET /activity/{id}/generated returns a paginated list; PUT /entity/{id}/generatedBy?generatedBy=<activityId> attaches an existing Activity to another entity -- both confirmed against Synapse's OpenAPI spec). range is the untyped uriorcurie, not SynapseEntity itself — see this schema's own description for why (the referenced individual is never asserted in this schema's own example-rdf ABox). The value is an IRI node, so the OWL types this slot owl:ObjectProperty, as W3C PROV-O does." ;
    skos:inScheme governanceduo:governance_duo .

prov:qualifiedUsage a owl:ObjectProperty ;
    rdfs:label "qualifiedUsage" ;
    rdfs:range prov:Usage ;
    skos:definition "The Usage records (mirroring Activity.used) describing what this Activity consumed, and whether each was executed rather than merely used as input data." ;
    skos:inScheme governanceduo:governance_duo .

shex:iri a rdfs:Datatype .

shex:nonLiteral a rdfs:Datatype .

sagegov:conditionDetail a owl:DatatypeProperty ;
    rdfs:label "conditionDetail" ;
    skos:definition "Zero or more companion-slot values from the source AccessRequirement, one per GovernanceMixin.rules entry whose precondition matches this condition's duoCode/conditionType and whose postcondition slot is actually populated on the instance (e.g. the geographicalRestriction value(s) for DUO:0000022). Multivalued because GovernanceMixin.rules is genuinely many-to-many -- some codes have multiple companion slots, some companion slots serve multiple codes -- not because any single condition's own detail is inherently list-valued. See scripts/build_governance_graph.py." ;
    skos:inScheme governanceduo:governance_duo .

sagegov:hasCondition a owl:ObjectProperty ;
    rdfs:label "hasCondition" ;
    rdfs:range sagegov:Condition ;
    skos:definition "The DUO-backed Conditions this attaches to -- gov:Condition individuals add_access_requirement() mints from real dataUseModifiers data (see plans/rebac_governance_graph_alignment.md). Shared by AccessRequirementReference (the AR stub these Conditions are minted onto in the first place) and AccessRequirementTemplate (which reuses the same real Condition nodes)." ;
    skos:inScheme governanceduo:governance_duo .

sagegov:sourceAccessRequirements a owl:ObjectProperty ;
    rdfs:label "sourceAccessRequirements" ;
    skos:definition "Every AccessRequirement contributing to this label's dataTier, across the subject's full derivation ancestry — what lets a later composite-risk check tell whether two ControlLabels trace back to the same AR or to genuinely different ones (the note's paragraph-12 case). range is uriorcurie, not AccessRequirementReference — see this schema's own description. The value is an IRI node, typed owl:ObjectProperty in the OWL." ;
    skos:inScheme governanceduo:governance_duo .

linkml:DateOrDatetime a rdfs:Datatype .

linkml:permissible_values a owl:AnnotationProperty .

governanceduo:DataAccessSubmissionStatus a owl:Class ;
    rdfs:label "DataAccessSubmissionStatus" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty governanceduo:submissionId ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sagegov:modifiedOn ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sagegov:rejectedReason ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sagegov:state ] ;
    skos:definition """The approval-workflow state of a DataAccessSubmission. Mirrors DATA_ACCESS_SUBMISSION_STATUS, which has no independent identifier of its own in Synapse's schema (only a SUBMISSION_ID foreign key) — modeled here as a plain class keyed by submissionId, not a BaseEntity subclass, for the same reason.
Slots corrected against Synapse's live `SubmissionStatus` REST object (`org.sagebionetworks.repo.model.dataaccess.SubmissionStatus`): it carries only `submissionId`/`submittedBy`/`rejectedReason`/`state`/`modifiedOn` -- no `createdBy`/`createdOn`/`modifiedBy` at all (those were this schema's earlier, DB-table-column-based guess; `modifiedBy` is real but lives on `Submission` itself -- see DataAccessSubmission above). `submittedBy` is intentionally not re-declared here even though the live object carries it: it would be redundant with DataAccessSubmission.submittedBy on the same merged RDF subject (see scripts/build_governance_graph.py's merge design).""" ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:DrsAuthorizationBinding a owl:Class ;
    rdfs:label "DrsAuthorizationBinding" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty governanceduo:dataUseModifier ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^did:[a-z0-9]+:.+$" ] ) ] ;
            owl:onProperty governanceduo:passportAuthIssuers ] ;
    skos:definition "Crosswalks one DUO code (or Sage DUOPlus extension) to the shape of the DRS Authorizations record a server would return from `OPTIONS /objects/{object_id}` for an object governed by that code. Mirrors PolicyCardBinding (policy_fabric.yaml) — same dataUseModifier axis, different target system's input shape (DRS's Authorizations discovery record vs. Policy Fabric's policy_data_schema.json)." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:DrsObjectMapping a owl:Class ;
    rdfs:label "DrsObjectMapping" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^drs://.+$" ] ) ] ;
            owl:onProperty governanceduo:drsSelfUri ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty governanceduo:drsSelfUri ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty governanceduo:drsId ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty governanceduo:synapseId ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^syn\\d+$" ] ) ] ;
            owl:onProperty governanceduo:synapseId ] ;
    skos:definition "How one Synapse entity maps onto a DRS DrsObject's id/self_uri/aliases. One row per governed Synapse entity, not per AccessRequirement (multiple AccessRequirements can govern the same entity; this mapping is per-entity)." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:PolicyCardBindingCollection a owl:Class ;
    rdfs:label "PolicyCardBindingCollection" ;
    skos:definition "Container class for policy_fabric_bindings.yaml — a plain list wrapper so the data file has a single root class to validate against." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:aliases a owl:DatatypeProperty ;
    rdfs:label "aliases" ;
    skos:definition "Secondary/external identifiers for this same Synapse entity, carried in DRS's own sanctioned DrsObject.aliases field — e.g. the governanceDUO dotted id(s) that reference this entity via entityIdList/assetBindings[].synapseId (see access_requirement.yaml/mixins.yaml), and/or the corresponding gov:-namespace SynapseEntity individual (see governance_graph.yaml). This is the DRS-forward-compatible resolution of governanceDUO's three-parallel- identifier-scheme gap (entityIdList / assetBindings.synapseId / SynapseEntity.id): rather than inventing a fourth internal crosswalk, Synapse's own id becomes the canonical DRS id and everything else rides in aliases." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:allowedAccountTypes a owl:DatatypeProperty ;
    rdfs:label "allowedAccountTypes" ;
    skos:definition "Account type(s) permitted to access the data (checked against UserPlatformCredential.accountType). Added to close the same user-specific-restriction gap as approvedUsers." ;
    skos:inScheme governanceduo:governance_duo ;
    skos:note "Required when dataUseModifiers contains DUO:0000026 — see GovernanceMixin rules." .

governanceduo:allowedPurposes a owl:DatatypeProperty ;
    rdfs:label "allowedPurposes" ;
    skos:definition "Research purpose term(s) for which use is allowed. Added to close a Policy Fabric gap: genetic-studies-only, health-or-medical-or-biomedical-research, population-origins-or-ancestry-research-only, and research-specific-restrictions all key their Reference Values Schema on a multivalued allowedPurposes list; the existing researchSpecificRestrictions slot is free text and not multivalued, so this is a new, distinct slot rather than a reinterpretation of it (the two can coexist — one is a human-readable narrative, this one is the structured, machine-checkable list Policy Fabric's Rego logic actually reads)." ;
    skos:inScheme governanceduo:governance_duo ;
    skos:note "Required when dataUseModifiers contains DUO:0000016, DUO:0000006, DUO:0000011, or DUO:0000012 — see GovernanceMixin rules." .

governanceduo:approvedUsers a owl:DatatypeProperty ;
    rdfs:label "approvedUsers" ;
    skos:definition "Identifier(s) of specifically approved users. Added to close a Policy Fabric gap: user-specific-restriction keys part of its Reference Values Schema on a multivalued approvedUsers list, checked against UserPlatformCredential.userId — the existing userSpecificRestriction slot is free text describing the restriction, not a structured list of identifiers, so this is a new, distinct slot (userSpecificRestriction, allowedAccountTypes, and requiredProfileStatuses together cover the three separate keys this one policy_card's Reference Values Schema defines)." ;
    skos:inScheme governanceduo:governance_duo ;
    skos:note "Required when dataUseModifiers contains DUO:0000026 — see GovernanceMixin rules." .

governanceduo:assetBindings a owl:ObjectProperty ;
    rdfs:label "assetBindings" ;
    rdfs:range governanceduo:AssetBinding ;
    skos:definition "Policy Fabric Asset-registry DID(s), each paired with the Synapse entity id it registers. Replaces a pair of positionally order-aligned lists (dataUseModifiers-adjacent entityIdList and a since-removed flat assetDids list) with an explicit pairing, so which DID belongs to which Synapse entity is structural rather than convention-only. Each synapseId here should also appear in the containing record's entityIdList (documented, not schema-enforced). GovernanceMixin's own `rules:` are cross-slot too, but only in the simpler \"value X on slot A requires slot B to be present\" sense; this would need the harder kind -- a positional/arity correspondence between two multivalued lists -- which LinkML's `rules:` preconditions/postconditions don't express, so it's left as a documented, not enforced, invariant." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:bindings a owl:ObjectProperty ;
    rdfs:label "bindings" ;
    rdfs:range governanceduo:PolicyCardBinding ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:cde_id a owl:AnnotationProperty .

governanceduo:dataPermission a owl:DatatypeProperty ;
    rdfs:label "dataPermission" ;
    rdfs:range governanceduo:DataPermissionEnum ;
    skos:definition "The permissions associated with the data under the access requirement. Equivalent to DUOPlus4." ;
    skos:inScheme governanceduo:governance_duo ;
    skos:note "Required when dataUseModifiers contains DUOPlus4 — see GovernanceMixin rules." .

governanceduo:dataTier a owl:DatatypeProperty ;
    rdfs:label "dataTier" ;
    rdfs:range governanceduo:DataTierEnum ;
    skos:definition "The tier of data access associated with the access requirement. Equivalent to DUOPlus5." ;
    skos:exactMatch NCIT:C175887 ;
    skos:inScheme governanceduo:governance_duo ;
    skos:note "NCIT:C175887 \"Open or Controlled Data Access Indicator\" (synonym: \"Data Access Level\") is defined as \"Specifies whether the data in a repository is open access or controlled access\" — a direct match for this slot's Anonymous/Open/Controlled/Private tiers.",
        "Required when dataUseModifiers contains DUOPlus5 — see GovernanceMixin rules." .

governanceduo:dataUseModifiers a owl:ObjectProperty ;
    rdfs:label "dataUseModifiers" ;
    rdfs:range governanceduo:DataUseModifierEnum ;
    skos:definition "A list of data use modifiers that apply to the access requirement. Includes real Data Use Ontology (DUO) terms plus Sage-local DUOPlus1-7 extensions (see README) and the literal value \"Pending Annotation\"." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:deidentificationType a owl:DatatypeProperty ;
    rdfs:label "deidentificationType" ;
    rdfs:range governanceduo:DeidentificationTypeEnum ;
    skos:closeMatch T4FS:0000414 ;
    skos:definition "The type of de-identification applied to the data associated with the access requirement. Equivalent to DUOPlus3." ;
    skos:inScheme governanceduo:governance_duo ;
    skos:note "Required when dataUseModifiers contains DUOPlus3 — see GovernanceMixin rules.",
        "T4FS:0000414 \"de-identification\" (Terminology for Food Safety, but the term itself is a generic privacy concept) is a close, not exact, match — this slot names one of a specific set of methods (HIPPA_LDS/SafeHarbor/etc.), the OLS term describes the general technique." .

governanceduo:deprecated a owl:AnnotationProperty .

governanceduo:duo_shorthand a owl:AnnotationProperty .

governanceduo:foreign_key a owl:AnnotationProperty .

governanceduo:geographicalRestriction a owl:DatatypeProperty ;
    rdfs:label "geographicalRestriction" ;
    rdfs:range governanceduo:GeographicalRegionEnum ;
    skos:definition "The specific geographic region(s) to which use is limited by the access requirement." ;
    skos:inScheme governanceduo:governance_duo ;
    skos:note "Required when dataUseModifiers contains DUO:0000022 — see GovernanceMixin rules." .

governanceduo:grantNumber a owl:DatatypeProperty ;
    rdfs:label "grantNumber" ;
    skos:definition "The identifier associated with the award funding this study." ;
    skos:exactMatch EVORAO:grantNumber ;
    skos:inScheme governanceduo:governance_duo ;
    skos:note "EVORAO:grantNumber, \"A formal reference or agreement number assigned by the funding body\" — verified live and non-obsolete via the OLS4 API." .

governanceduo:license a owl:DatatypeProperty ;
    rdfs:label "license" ;
    rdfs:range governanceduo:LicenseEnum ;
    skos:definition "The license under which the data associated with the access requirement is shared. Equivalent to DUOPlus6." ;
    skos:inScheme governanceduo:governance_duo ;
    skos:note "Required when dataUseModifiers contains DUOPlus6 — see GovernanceMixin rules." .

governanceduo:nonprofitLegalForms a owl:DatatypeProperty ;
    rdfs:label "nonprofitLegalForms" ;
    skos:definition "Legal entity form(s) qualifying as not-for-profit, coded per ISO 20275:2017 (Entity Legal Form Code List). Added to close a Policy Fabric gap: not-for-profit-organisation-use-only and not-for-profit-non-commercial-use-only both key their Reference Values Schema on a multivalued nonprofitLegalForms list, which no existing slot held." ;
    skos:inScheme governanceduo:governance_duo ;
    skos:note "Required when dataUseModifiers contains DUO:0000045 or DUO:0000018 — see GovernanceMixin rules." .

governanceduo:notes a owl:DatatypeProperty ;
    rdfs:label "notes" ;
    skos:definition "Free-text notes — used in particular to record why sourceSlot is left unset (which governanceDUO slot would need to be added, and its required shape) so a gap is documented rather than silently dropped. Reused by drs_alignment.yaml's DrsAuthorizationBinding for the same purpose." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:prohibitedPurposes a owl:DatatypeProperty ;
    rdfs:label "prohibitedPurposes" ;
    skos:definition "Research purpose term(s) for which use is explicitly disallowed. Added to close a Policy Fabric gap: health-or-medical-or-biomedical-research, no-general-methods-research, non-commercial-use-only, not-for-profit-non-commercial-use-only, and population-origins-or-ancestry-research-prohibited all key their Reference Values Schema on a multivalued prohibitedPurposes list, which no existing slot held." ;
    skos:inScheme governanceduo:governance_duo ;
    skos:note "Required when dataUseModifiers contains DUO:0000006, DUO:0000015, DUO:0000046, DUO:0000018, or DUO:0000044 — see GovernanceMixin rules." .

governanceduo:referenceValueKeys a owl:DatatypeProperty ;
    rdfs:label "referenceValueKeys" ;
    skos:definition "The policy_data_schema.json key(s) this policy_card's Reference Values Schema defines, e.g. \"allowedCountries\". Empty for policy_cards with no reference values at all (pure credential-chain checks, e.g. ethics-approval-required)." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:referenceValueSources a owl:ObjectProperty ;
    rdfs:label "referenceValueSources" ;
    rdfs:range governanceduo:ReferenceValueSource ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:requiredCredentials a owl:ObjectProperty ;
    rdfs:label "requiredCredentials" ;
    rdfs:range governanceduo:CredentialRequirement ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:requiredProfileStatuses a owl:DatatypeProperty ;
    rdfs:label "requiredProfileStatuses" ;
    skos:definition "Profile status value(s) a requester's account must have (checked against UserPlatformCredential.profileStatus). Added to close the same user-specific-restriction gap as approvedUsers." ;
    skos:inScheme governanceduo:governance_duo ;
    skos:note "Required when dataUseModifiers contains DUO:0000026 — see GovernanceMixin rules." .

governanceduo:sage_extension a owl:AnnotationProperty .

governanceduo:sourceGeography a owl:DatatypeProperty ;
    rdfs:label "sourceGeography" ;
    rdfs:range governanceduo:GeographicalRegionEnum ;
    skos:definition "The geographical source of the data associated with the access requirement. Equivalent to DUOPlus1." ;
    skos:inScheme governanceduo:governance_duo ;
    skos:note "Required when dataUseModifiers contains DUOPlus1 — see GovernanceMixin rules." .

governanceduo:studyDeidentificationType a owl:DatatypeProperty ;
    rdfs:label "studyDeidentificationType" ;
    rdfs:range governanceduo:DeidentificationTypeEnum ;
    skos:closeMatch T4FS:0000414 ;
    skos:definition "General description of the de-identification method. Maps to DUOPlus3." ;
    skos:inScheme governanceduo:governance_duo ;
    skos:note "T4FS:0000414 \"de-identification\" — see GovernanceMixin.deidentificationType for the same close (not exact) mapping and rationale." ;
    governanceduo:cde_id "14576319" .

governanceduo:studyIndexDate a owl:DatatypeProperty ;
    rdfs:label "studyIndexDate" ;
    rdfs:range governanceduo:StudyIndexDateEnum ;
    skos:definition "The reference event associated with timepoints in this study. One of Diagnosis Date, Enrollment Date, Collection Date, or Birth Date." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:supportedAuthTypes a owl:DatatypeProperty ;
    rdfs:label "supportedAuthTypes" ;
    rdfs:range governanceduo:DrsAuthTypeEnum ;
    skos:definition "Mirrors DRS's Authorizations.supported_types for objects governed by this DUO code." ;
    skos:inScheme governanceduo:governance_duo .

prov:Activity a owl:Class ;
    rdfs:label "Activity" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:modifiedBy ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:createdBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^activity\\.[A-Za-z0-9_-]+$" ] ) ] ;
            owl:onProperty dcterms:identifier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sagegov:modifiedOn ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty governanceduo:modifiedBy ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sagegov:name ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dcterms:identifier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sagegov:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sagegov:createdOn ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:etag ],
        governanceduo:BaseEntity ;
    skos:definition "Mirrors Synapse's real Activity object (org.sagebionetworks.repo.model.provenance.Activity — id/name/description/ etag/createdOn/modifiedOn/createdBy/modifiedBy/used — verified directly against rest-docs.synapse.org). Returned by GET /entity/{id}/generatedBy and GET /entity/{id}/version/{versionNumber}/generatedBy (both confirmed to exist, both OAuth `view` scope — the same auth tier scripts/sync_governance_graph.py already requires, no new credential type needed). See plans/prov_o_integration.md Section 1." ;
    skos:exactMatch governanceduo:Activity ;
    skos:inScheme governanceduo:governance_duo .

prov:Usage a owl:Class ;
    rdfs:label "Usage" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty prov:entity ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sagegov:entityVersionNumber ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sagegov:url ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sagegov:name ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sagegov:wasExecuted ] ;
    skos:definition "Flattens Synapse's real Used interface and its two implementations — UsedEntity (+ reference.targetId/targetVersionNumber) and UsedURL (+ url/name), both verified against rest-docs.synapse.org — into one class, the same flattening governance_graph.yaml's DataAccessRequest already does for principalInvestigator/signingOfficial (neither branch has an independent identifier, and nothing else in this graph needs to reference one individually; only one branch is populated per instance). Not `is_a: BaseEntity`: keyed structurally by its parent Activity's qualifiedUsage list, same reasoning as Condition/DataAccessSubmissionStatus. Maps onto PROV-O's own qualification pattern: prov:Usage is a real PROV-O class for exactly this \"Activity used this Entity, plus extra detail\" shape (prov:qualifiedUsage / prov:entity), not an invented parallel structure." ;
    skos:exactMatch governanceduo:Usage ;
    skos:inScheme governanceduo:governance_duo .

prov:entity a owl:ObjectProperty ;
    rdfs:label "entity" ;
    skos:definition "The SynapseEntity referenced by this Usage, as a syn: CURIE, when Used.concreteType is UsedEntity (Used.reference.targetId). range is uriorcurie, not SynapseEntity — same cross-ABox reasoning as Activity.generated above. Absent when this Usage instead carries url/name (a UsedURL). The value is an IRI node, so the OWL types this slot owl:ObjectProperty, as W3C PROV-O does." ;
    skos:inScheme governanceduo:governance_duo .

sagegov:AccessApproval a owl:Class ;
    rdfs:label "AccessApproval" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^access_approval\\.\\d+$" ] ) ] ;
            owl:onProperty dcterms:identifier ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sagegov:heldBy ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sagegov:requirementVersion ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sagegov:status ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sagegov:submittedBy ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dcterms:identifier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sagegov:createdOn ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sagegov:satisfies ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sagegov:sourceApprovalId ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sagegov:expiresAt ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sagegov:etag ],
        governanceduo:BaseEntity ;
    skos:definition """Records that a Principal has been approved for access under an AccessRequirement. Mirrors Synapse's real AccessApproval REST object (org.sagebionetworks.repo.model.AccessApproval) -- a *separate* object from DataAccessSubmission/DataAccessSubmissionStatus (the workflow/audit trail that produces one), verified directly against rest-docs.synapse.org and the OpenAPI spec. Maps onto the target ontology (proposed in review on sagebrain-infra PR #54) as gov:Approval: gov:satisfies (requirementId), gov:heldBy (accessorId), gov:status (this class's own status slot -- range ApprovalStateEnum, deliberately not the shared "state" slot, which ranges over the unrelated SubmissionStateEnum), gov:expiresAt (expiredOn).
gov:hasApproval (Principal -> AccessRequirement) is derived only from this class, while the approval holds: status == APPROVED and expiredOn absent or later than the build's as-of time -- see add_access_approval() in build_governance_graph.py. It is no longer derived from DataAccessSubmissionStatus: a once-APPROVED Submission says nothing about whether access still holds (plans/pre_pr_review_fixes.md, finding 9; authorize.py's SPARQL contract touches neither). See plans/governance_graph_open_questions.md Section B.""" ;
    skos:exactMatch governanceduo:AccessApproval ;
    skos:inScheme governanceduo:governance_duo .

sagegov:AccessGrant a owl:Class ;
    rdfs:label "AccessGrant" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sagegov:source ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sagegov:principal ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dcterms:identifier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sagegov:createdOn ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sagegov:bindingType ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sagegov:resource ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^grant\\.[A-Za-z0-9_-]+$" ] ) ] ;
            owl:onProperty dcterms:identifier ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sagegov:permission ],
        governanceduo:BaseEntity ;
    skos:closeMatch schema1:DigitalDocumentPermissionType,
        dpv:AuthorisationProtocols ;
    skos:definition "A first-class ACL grant: resource, principal, permission(s), source, and whether the grant is direct or inherited. Mirrors ACL + ACL_RESOURCE_ACCESS + ACL_RESOURCE_ACCESS_TYPE. Answers \"who has which permission on this resource?\" — distinct from AccessRequirementAssociation, which answers \"what additional conditions must be satisfied?\" (the design doc's central ACL-vs-AR distinction)." ;
    skos:exactMatch governanceduo:AccessGrant ;
    skos:inScheme governanceduo:governance_duo .

sagegov:AccessRequirementAssociation a owl:Class ;
    rdfs:label "AccessRequirementAssociation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sagegov:source ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^ar_association\\.[A-Za-z0-9_-]+$" ] ) ] ;
            owl:onProperty dcterms:identifier ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sagegov:accessRequirement ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dcterms:identifier ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sagegov:bindingType ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sagegov:resource ],
        governanceduo:BaseEntity ;
    skos:definition "Binds an AccessRequirement to a resource, recording whether the binding is direct or inherited. Mirrors ACCESS_REQUIREMENT_PROJECT, extended with the design doc's explicit direct/inherited distinction — ACCESS_REQUIREMENT_PROJECT itself has no binding-type column; that inheritance concept is this repo's own addition to capture what the design doc calls for (see BindingTypeEnum)." ;
    skos:exactMatch governanceduo:AccessRequirementAssociation ;
    skos:inScheme governanceduo:governance_duo .

sagegov:Condition a owl:Class ;
    rdfs:label "Condition" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sagegov:conditionType ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sagegov:duoCode ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sagegov:description ] ;
    skos:definition "A single DUO-code-backed condition on an AccessRequirement, surfacing GovernanceMixin's dataUseModifiers/companion-slot data -- already present in this repo's AccessRequirement examples -- as a first-class graph node instead of leaving it invisible on the gov:AccessRequirement stub (see scripts/build_governance_graph.py's TYPE(\"AccessRequirement\") comment for why that stub has its own, separate node). Mirrors the shape of a gov:Condition example proposed in review on sagebrain-infra PR #54 (thomasyu888, https://github.com/Sage-Bionetworks-IT/sagebrain-infra/pull/54#discussion_r3926030399), built from real data already in this repo, not a new source of truth -- see plans/rebac_governance_graph_alignment.md for the full rationale. Not `is_a: BaseEntity`: like DataAccessSubmissionStatus, it has no independent identifier of its own in Synapse's schema -- it's keyed structurally by (AccessRequirement, duoCode/conditionType), not a synthesized dotted id." ;
    skos:exactMatch governanceduo:Condition ;
    skos:inScheme governanceduo:governance_duo .

sagegov:ControlLabel a owl:Class ;
    rdfs:label "ControlLabel" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sagegov:subject ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sagegov:computedFrom ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sagegov:computedOn ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sagegov:dataTier ] ;
    skos:definition "A precomputed, per-SynapseEntity sensitivity label — the max DataTierEnum rank across an entity's full derivation ancestry, computed once when the entity is created/derived rather than re-walked live on every query (the note's own paragraph-18 design: \"a control label computed once... stored as an attribute on the node, not recomputed live on every query\"). Not `is_a: BaseEntity`: has no independent Synapse-sourced identifier of its own, same reasoning as Condition — like Condition, scripts/build_derivation_policy.py mints a real, stable per-subject IRI node for it at the script level even though the LinkML schema itself has no `id` slot to hang one off of." ;
    skos:exactMatch governanceduo:ControlLabel ;
    skos:inScheme governanceduo:governance_duo .

sagegov:DerivationReview a owl:Class ;
    rdfs:label "DerivationReview" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sagegov:reviewedBy ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sagegov:activity ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sagegov:reviewedOn ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sagegov:reviewStatus ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dcterms:identifier ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^derivation_review\\.[A-Za-z0-9_-]+$" ] ) ] ;
            owl:onProperty dcterms:identifier ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sagegov:inputLabels ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sagegov:reviewNotes ],
        governanceduo:BaseEntity ;
    skos:definition "An auditable record minted whenever a derivation Activity's inputs carry ControlLabels citing disjoint sourceAccessRequirements sets — the note's own paragraph-12 \"composite risk from independent grants\" case, flagged by pattern (scripts/build_derivation_policy.py) rather than inferred, and its own proposed storage mechanism (paragraph 21): \"the access rule could then be stored as a node in the graph for later review/retrieval.\"" ;
    skos:exactMatch governanceduo:DerivationReview ;
    skos:inScheme governanceduo:governance_duo .

sagegov:IRBRequirement a owl:Class ;
    rdfs:label "IRBRequirement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sagegov:extendsTemplate ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^irb_requirement\\.[A-Za-z0-9_-]+$" ] ) ] ;
            owl:onProperty dcterms:identifier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sagegov:language ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sagegov:forStudy ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sagegov:scopedToSite ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sagegov:arType ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dcterms:identifier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sagegov:scopedToProgram ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sagegov:institution ],
        governanceduo:BaseEntity ;
    skos:definition "A site/program-specific instantiation of an AccessRequirementTemplate, per the target ontology proposed in review on sagebrain-infra PR #54 (thomasyu888, https://github.com/Sage-Bionetworks-IT/sagebrain-infra/pull/54#discussion_r3926030399). studyId (sagegov:forStudy) relates it to this repo's existing, *real* governanceduo:Study class -- Study has a real example (study.mc2-jax-5xfad) and a real AccessRequirementKey link to an AccessRequirement, so this is a genuine integration point, not an invented one. `institution` (reusing ResearchProject/DataAccessRequest's own slot) drives `scopedToSite` the same way it drives `gov:affiliatedWith` elsewhere -- not independently re-emitted. `is_a: BaseEntity` for a synthetic dotted id, same reasoning as AccessRequirementTemplate above. See plans/governance_graph_open_questions.md Section C.2." ;
    skos:exactMatch governanceduo:IRBRequirement ;
    skos:inScheme governanceduo:governance_duo .

sagegov:Site a owl:Class ;
    rdfs:label "Site" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sagegov:participatesIn ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sagegov:institution ] ;
    skos:definition "An institution real Synapse data associates with a ResearchProject, DataAccessRequest, or User-type Principal. Synapse never gives a stable Site id, only a free-text institution/company name string (ResearchProject.institution / DataAccessRequest.institution / UserProfile.company -- all three real fields hold the same shape), so gov:Site nodes are minted deterministically by slugifying that name (see site_node_for() in build_governance_graph.py) -- the same \"derive a stable node from real but non-id-shaped data\" pattern add_principal() already uses for bare integer ids. Not `is_a: BaseEntity` for the same reason. gov:affiliatedWith (from ResearchProject/DataAccessRequest/Principal to this class) is a derived convenience triple with no governance_graph.yaml slot backing it, same as gov:hasACL/gov:hasAccessRequirement/gov:hasCondition -- it's never present in any source data, only computed by the script. See plans/governance_graph_open_questions.md Section C." ;
    skos:exactMatch governanceduo:Site ;
    skos:inScheme governanceduo:governance_duo .

sagegov:Synapse a owl:Class ;
    rdfs:label "Synapse" ;
    rdfs:subClassOf governanceduo:SourceSystemEnum ;
    skos:definition "Derived from Synapse's own ACL or AccessRequirement records." .

sagegov:activity a owl:ObjectProperty ;
    rdfs:label "activity" ;
    skos:definition "The derivation Activity being reviewed. range is uriorcurie, not Activity — see this schema's own description. The value is an IRI node, typed owl:ObjectProperty in the OWL." ;
    skos:inScheme governanceduo:governance_duo .

sagegov:alias a owl:DatatypeProperty ;
    rdfs:label "alias" ;
    skos:definition "The Synapse entity's alias (NODE.ALIAS), if any." ;
    skos:inScheme governanceduo:governance_duo .

sagegov:arType a owl:DatatypeProperty ;
    rdfs:label "arType" ;
    skos:definition "Free-text access requirement type, e.g. \"IRB\"." ;
    skos:inScheme governanceduo:governance_duo .

sagegov:company a owl:DatatypeProperty ;
    rdfs:label "company" ;
    skos:definition "Institution/company name, verbatim from Synapse's real UserProfile.company field (\"This person's current affiliation\"). Consumed by build_governance_graph.py's site_node_for() to derive a gov:affiliatedWith edge to a gov:Site node -- not independently re-emitted as its own literal predicate on the Principal subject. Only meaningful for `principalType: User`." ;
    skos:inScheme governanceduo:governance_duo .

sagegov:computedFrom a owl:ObjectProperty ;
    rdfs:label "computedFrom" ;
    skos:definition "The Activity this label was (re)computed from. range is uriorcurie, not Activity — see this schema's own description. Also the staleness signal Section 7 of plans/prov_o_integration.md relies on: if an AR named in sourceAccessRequirements is later revoked, any label computed before that point is provably stale. The value is an IRI node, typed owl:ObjectProperty in the OWL." ;
    skos:inScheme governanceduo:governance_duo .

sagegov:computedOn a owl:DatatypeProperty ;
    rdfs:label "computedOn" ;
    rdfs:range xsd:integer ;
    skos:definition "When this ControlLabel was (re)computed (epoch milliseconds)." ;
    skos:inScheme governanceduo:governance_duo .

sagegov:conditionType a owl:DatatypeProperty ;
    rdfs:label "conditionType" ;
    skos:definition "A short label for this condition. For the 24 real DUO codes in DataUseModifierEnum, this is that code's own duo_shorthand annotation (e.g. \"GRU\", \"COL\"); the 7 Sage-local DUOPlus1-7 extensions have no duo_shorthand/meaning: CURIE at all, so their bare enum key (e.g. \"DUOPlus1\") is used instead -- see scripts/build_governance_graph.py." ;
    skos:inScheme governanceduo:governance_duo .

sagegov:createdByUserId a owl:DatatypeProperty ;
    rdfs:label "createdBy" .

sagegov:currentRevNum a owl:DatatypeProperty ;
    rdfs:label "currentRevNum" .

sagegov:dataTier a owl:DatatypeProperty ;
    rdfs:label "dataTier" ;
    rdfs:range governanceduo:DataTierEnum .

sagegov:domain a owl:DatatypeProperty ;
    rdfs:label "domain" ;
    skos:definition "Free-text research domain this template applies to, e.g. \"genomics\"." ;
    skos:inScheme governanceduo:governance_duo .

sagegov:duoCode a owl:ObjectProperty ;
    rdfs:label "duoCode" ;
    rdfs:range governanceduo:DataUseModifierEnum ;
    skos:definition "The IRI of the data-use code this condition represents, from DataUseModifierEnum's meaning: obo:DUO_<n> for real DUO codes (the same IRIs sagebrain-model imports), sagegov:DUOPlus<n> for the Sage-local extensions. Emitted as an IRI, never a string, by scripts/build_governance_graph.py. Every Condition has one: a dataUseModifiers value with no meaning (\"Pending Annotation\", a curation state) mints no Condition at all." ;
    skos:inScheme governanceduo:governance_duo .

sagegov:entityVersionNumber a owl:DatatypeProperty ;
    rdfs:label "entityVersionNumber" ;
    rdfs:range xsd:integer ;
    skos:definition "Mirrors UsedEntity.reference.targetVersionNumber. No PROV-O equivalent: PROV-O does not version-scope entities the way Synapse does." ;
    skos:inScheme governanceduo:governance_duo .

sagegov:expiresAt a owl:DatatypeProperty ;
    rdfs:label "expiredOn" ;
    rdfs:range xsd:integer ;
    skos:definition "When this approval will expire (epoch milliseconds; AccessApproval.expiredOn in Synapse's live REST API). Maps onto the target ontology's gov:expiresAt -- the real field plans/rebac_governance_graph_alignment.md's first draft was wrong to call an unsourceable gap; see that plan's corrected Grounding section." ;
    skos:inScheme governanceduo:governance_duo .

sagegov:extendsTemplate a owl:ObjectProperty ;
    rdfs:label "extendsTemplate" ;
    rdfs:range sagegov:AccessRequirementTemplate ;
    skos:definition "The AccessRequirementTemplate this IRBRequirement extends." ;
    skos:inScheme governanceduo:governance_duo .

sagegov:forStudy a owl:ObjectProperty ;
    rdfs:label "studyId" ;
    skos:definition "The Study (this repo's real governanceduo:Study class, study.yaml) this IRBRequirement's language was authored for. A plain relation, not owl:sameAs: the IRB requirement is not the Study, and a co-reference would give the Study every IRBRequirement property and merge two IRB requirements authored for the same study into one individual (plans/pre_pr_review_fixes.md, finding 4). range is the untyped uriorcurie, not Study itself: the referenced Study individual is never asserted (type or otherwise) in this ABox -- its full definition lives only in the separately-built linkml/examples/rdf/ graph -- so an sh:class Study constraint would fail against this graph alone even when the reference is entirely correct." ;
    skos:inScheme governanceduo:governance_duo .

sagegov:heldBy a owl:ObjectProperty ;
    rdfs:label "accessorId" ;
    rdfs:range sagegov:Principal ;
    skos:definition "Synapse numeric id of the Principal approved for access (AccessApproval.accessorId). Emitted as an IRI reference to a sagegov:Principal node, mapping onto the target ontology's gov:heldBy predicate. range Principal (keyed by its integer principalId), so records still carry the raw Synapse id while the schema -- and the OWL generated from it -- describe the Principal reference the graph actually contains." ;
    skos:inScheme governanceduo:governance_duo .

sagegov:inputLabels a owl:ObjectProperty ;
    rdfs:label "inputLabels" ;
    rdfs:range sagegov:ControlLabel ;
    skos:definition "The ControlLabels (one per input entity of the Activity above) whose disjoint sourceAccessRequirements triggered this review. Inlined, not referenced by id — ControlLabel has no independent identifier of its own (see that class's own description), so embedding is the only option, not a cross-ABox concern the way Activity/SynapseEntity references are." ;
    skos:inScheme governanceduo:governance_duo .

sagegov:intendedDataUseStatement a owl:DatatypeProperty ;
    rdfs:label "intendedDataUseStatement" ;
    skos:definition "A few short paragraphs explaining how the controlled data will be used (ResearchProject.intendedDataUseStatement)." ;
    skos:inScheme governanceduo:governance_duo .

sagegov:language a owl:DatatypeProperty ;
    rdfs:label "language" ;
    skos:definition "Free-text consent/IRB language for this requirement." ;
    skos:inScheme governanceduo:governance_duo .

sagegov:maxRevNum a owl:DatatypeProperty ;
    rdfs:label "maxRevNum" ;
    skos:definition "The maximum revision number of this Synapse entity (NODE.MAX_REV_NUM)." ;
    skos:inScheme governanceduo:governance_duo .

sagegov:nodeType a owl:DatatypeProperty ;
    rdfs:label "nodeType" ;
    skos:definition "The kind of Synapse entity (NODE.NODE_TYPE), e.g. project, folder, file, table. **Not independently verified** against a canonical enum in this pass — modeled as an open string rather than a fabricated enum, unlike AccessTypeEnum/AccessRequirementConcreteTypeEnum/SubmissionStateEnum above, all three of which were confirmed against a real source. Common Synapse entity types (project/folder/file/link/table/view/dockerrepo) are well known but not cited here as a closed, checked list." ;
    skos:inScheme governanceduo:governance_duo .

sagegov:parentId a owl:ObjectProperty ;
    rdfs:label "parentId" ;
    rdfs:range sagegov:SynapseEntity ;
    skos:definition "The parent Synapse entity in the containment hierarchy (NODE.PARENT_ID) — used to resolve direct-vs-inherited governance (e.g. a file inheriting its parent study's Access Requirement, per the design doc's \"Direct and Inherited Governance\" section)." ;
    skos:exactMatch dcterms:isPartOf ;
    skos:inScheme governanceduo:governance_duo .

sagegov:participatesIn a owl:ObjectProperty ;
    rdfs:label "participatesIn" ;
    rdfs:range sagegov:Program ;
    skos:definition "The Program a Site participates in. Illustrative-only -- see Program's own description." ;
    skos:inScheme governanceduo:governance_duo .

sagegov:permission a owl:ObjectProperty ;
    rdfs:label "permission" ;
    rdfs:range governanceduo:GrantPermissionEnum ;
    skos:definition "The permission(s) granted (ACL_RESOURCE_ACCESS_TYPE.STRING_ELE). Multivalued: a single ACL_RESOURCE_ACCESS row can carry more than one permission type. Also carries the derived ACCESS (see GrantPermissionEnum)." ;
    skos:inScheme governanceduo:governance_duo .

sagegov:principal a owl:ObjectProperty ;
    rdfs:label "principal" ;
    rdfs:range sagegov:Principal ;
    skos:closeMatch prov:agent ;
    skos:definition "The user or team this grant applies to." ;
    skos:inScheme governanceduo:governance_duo .

sagegov:principalId a owl:DatatypeProperty ;
    rdfs:label "principalId" ;
    rdfs:range xsd:integer ;
    skos:definition "The Synapse numeric id of the user or team (ACL_RESOURCE_ACCESS.GROUP_ID)." ;
    skos:inScheme governanceduo:governance_duo .

sagegov:projectLead a owl:DatatypeProperty ;
    rdfs:label "projectLead" ;
    skos:definition "The person leading this research project (ResearchProject.projectLead)." ;
    skos:inScheme governanceduo:governance_duo .

sagegov:publication a owl:DatatypeProperty ;
    rdfs:label "publication" ;
    skos:definition "Link(s) to publications that used the controlled data (Renewal.publication in Synapse's live REST API). Only present on renewal instances (requestConcreteType == \"Renewal\")." ;
    skos:inScheme governanceduo:governance_duo .

sagegov:rejectedReason a owl:DatatypeProperty ;
    rdfs:label "rejectedReason" ;
    skos:definition "The reason this submission was rejected, if it was. Synapse's live API names this field `rejectedReason` (`org.sagebionetworks.repo.model.dataaccess.SubmissionStatus`), not `reason`; stored as DATA_ACCESS_SUBMISSION_STATUS.REASON (a BINARY column) in the underlying table." ;
    skos:inScheme governanceduo:governance_duo .

sagegov:requestConcreteType a owl:DatatypeProperty ;
    rdfs:label "requestConcreteType" ;
    skos:definition "Which kind of request this is -- literally \"Request\" or \"Renewal\" (RequestInterface.concreteType in Synapse's live REST API). Deliberately not named/typed the same as AccessRequirement's own concreteType slot (mixins.yaml, range AccessRequirementConcreteTypeEnum) -- these are two unrelated real Synapse concreteType fields on two different objects." ;
    skos:inScheme governanceduo:governance_duo .

sagegov:requestId a owl:ObjectProperty ;
    rdfs:label "requestId" ;
    rdfs:range sagegov:DataAccessRequest ;
    skos:definition "The originating data access request. Synapse's live API names this field `requestId` (`org.sagebionetworks.repo.model.dataaccess.Submission`), not `dataAccessRequestId`; the underlying DB column is DATA_ACCESS_SUBMISSION.DATA_ACCESS_REQUEST_ID. Range is now `DataAccessRequest` (was a bare integer literal until that class existed -- see plans/governance_graph_open_questions.md Section C.1) -- emitted as an IRI reference to the real `gov:DataAccessRequest-<n>` node." ;
    skos:inScheme governanceduo:governance_duo .

sagegov:requestPrincipalInvestigatorEmail a owl:DatatypeProperty ;
    rdfs:label "requestPrincipalInvestigatorEmail" ;
    skos:definition "Flattened from the live API's nested principalInvestigator.institutionalEmail." ;
    skos:inScheme governanceduo:governance_duo .

sagegov:requestPrincipalInvestigatorName a owl:DatatypeProperty ;
    rdfs:label "requestPrincipalInvestigatorName" ;
    skos:definition "Flattened from the live API's nested principalInvestigator.name (org.sagebionetworks.repo.model.dataaccess.PrincipalInvestigator) -- see DataAccessRequest's own class description for why this is flattened rather than given a nested class." ;
    skos:inScheme governanceduo:governance_duo .

sagegov:requestSigningOfficialEmail a owl:DatatypeProperty ;
    rdfs:label "requestSigningOfficialEmail" ;
    skos:definition "Flattened from the live API's nested signingOfficial.institutionalEmail." ;
    skos:inScheme governanceduo:governance_duo .

sagegov:requestSigningOfficialName a owl:DatatypeProperty ;
    rdfs:label "requestSigningOfficialName" ;
    skos:definition "Flattened from the live API's nested signingOfficial.name (org.sagebionetworks.repo.model.dataaccess.SigningOfficial)." ;
    skos:inScheme governanceduo:governance_duo .

sagegov:requirementVersion a owl:DatatypeProperty ;
    rdfs:label "requirementVersion" ;
    rdfs:range xsd:integer ;
    skos:definition "The version of the AccessRequirement this approval satisfies (AccessApproval.requirementVersion)." ;
    skos:inScheme governanceduo:governance_duo .

sagegov:reviewNotes a owl:DatatypeProperty ;
    rdfs:label "reviewNotes" ;
    skos:definition "Free-text notes from the reviewer." ;
    skos:inScheme governanceduo:governance_duo .

sagegov:reviewStatus a owl:DatatypeProperty ;
    rdfs:label "reviewStatus" ;
    rdfs:range governanceduo:DerivationReviewStatusEnum ;
    skos:definition "This review's workflow state. Deliberately not named `status`: that slot name is already bound to ApprovalStateEnum on AccessApproval in governance_graph.yaml — a distinct, unrelated enum; do not conflate." ;
    skos:inScheme governanceduo:governance_duo .

sagegov:reviewedBy a owl:DatatypeProperty ;
    rdfs:label "reviewedBy" ;
    rdfs:range xsd:integer ;
    skos:definition "Synapse numeric user id of who recorded reviewStatus, when it is Reviewed/Approved/Denied. range integer, mirroring createdBy/modifiedBy/submittedBy's own raw-id convention rather than a typed Principal reference — see provenance.yaml's own description for why." ;
    skos:inScheme governanceduo:governance_duo .

sagegov:reviewedOn a owl:DatatypeProperty ;
    rdfs:label "reviewedOn" ;
    rdfs:range xsd:integer ;
    skos:definition "When reviewStatus was last recorded (epoch milliseconds)." ;
    skos:inScheme governanceduo:governance_duo .

sagegov:satisfies a owl:ObjectProperty ;
    rdfs:label "requirementId" ;
    rdfs:range sagegov:AccessRequirement ;
    skos:definition "The AccessRequirement this approval satisfies (AccessApproval.requirementId in Synapse's live REST API). Distinct LinkML slot from AccessRequirementAssociation.accessRequirement/ DataAccessSubmission.accessRequirementId (which share sagegov:accessRequirement) -- this one maps onto the target ontology's gov:satisfies predicate instead, since AccessApproval specifically represents *satisfaction* of a requirement, not just a binding or an application against it. range is AccessRequirementReference (the gov:AR-<n> stub), not the real AccessRequirement itself -- see that class's own description." ;
    skos:inScheme governanceduo:governance_duo .

sagegov:scopedToProgram a owl:ObjectProperty ;
    rdfs:label "scopedToProgram" ;
    rdfs:range sagegov:Program ;
    skos:definition "The Program this IRBRequirement is scoped to. Illustrative-only -- see Program's own description." ;
    skos:inScheme governanceduo:governance_duo .

sagegov:scopedToSite a owl:ObjectProperty ;
    rdfs:label "scopedToSite" ;
    rdfs:range sagegov:Site ;
    skos:definition "The Site this IRBRequirement is scoped to." ;
    skos:inScheme governanceduo:governance_duo .

sagegov:sourceApprovalId a owl:DatatypeProperty ;
    rdfs:label "sourceApprovalId" ;
    rdfs:range xsd:integer ;
    skos:definition "Traceability back to the literal AccessApproval.id row this record was derived from." ;
    skos:inScheme governanceduo:governance_duo .

sagegov:state a owl:ObjectProperty ;
    rdfs:label "state" ;
    rdfs:range governanceduo:SubmissionStateEnum ;
    skos:inScheme governanceduo:governance_duo .

sagegov:status a owl:ObjectProperty ;
    rdfs:label "status" ;
    rdfs:range governanceduo:ApprovalStateEnum ;
    skos:definition "The state of this approval (AccessApproval.state in Synapse's live REST API -- renamed to \"status\" here specifically to avoid colliding with DataAccessSubmission/Status's own \"state\" slot, which ranges over the unrelated SubmissionStateEnum). Maps onto the target ontology's gov:status." ;
    skos:inScheme governanceduo:governance_duo .

sagegov:subject a owl:ObjectProperty ;
    rdfs:label "subject" ;
    skos:definition "The SynapseEntity this ControlLabel labels. range is uriorcurie, not SynapseEntity — see this schema's own description. The value is an IRI node, typed owl:ObjectProperty in the OWL." ;
    skos:inScheme governanceduo:governance_duo .

sagegov:submittedOn a owl:DatatypeProperty ;
    rdfs:label "submittedOn" ;
    rdfs:range xsd:integer ;
    skos:definition "When this record was submitted (epoch milliseconds; `Submission.submittedOn` in Synapse's live REST API)." ;
    skos:inScheme governanceduo:governance_duo .

sagegov:summaryOfUse a owl:DatatypeProperty ;
    rdfs:label "summaryOfUse" ;
    skos:definition "Summary of how the data has been used (Renewal.summaryOfUse in Synapse's live REST API). Only present on renewal instances (requestConcreteType == \"Renewal\")." ;
    skos:inScheme governanceduo:governance_duo .

sagegov:url a owl:DatatypeProperty ;
    rdfs:label "url" ;
    skos:definition "The external URL used, when Used.concreteType is UsedURL (UsedURL.url — \"The external URL of the file that was used\"). Absent when this Usage instead carries entity/entityVersionNumber (a UsedEntity). Usage.name (UsedURL.name — the same field description, verbatim, despite the field being named `name`) reuses the shared display-name slot (mixins.yaml), mapped to sagegov:name via slot_usage -- the same predicate the governance graph uses for SynapseEntity/Program names." ;
    skos:inScheme governanceduo:governance_duo .

sagegov:wasExecuted a owl:DatatypeProperty ;
    rdfs:label "wasExecuted" ;
    rdfs:range xsd:boolean ;
    skos:definition "Mirrors Used.wasExecuted verbatim (\"The enclosed entity was used and also executed in the Activity\") — a Synapse-specific boolean flag distinguishing code/workflow inputs from data inputs within one qualifiedUsage list, with no exact PROV-O predicate equivalent found; left as a repo-local predicate rather than forced onto e.g. prov:hadRole, same as other slots this repo leaves unmapped when no confident match exists (see README's OLS-verification table)." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:AccessRequirement a owl:Class ;
    rdfs:label "AccessRequirement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^access_requirement\\.\\d+$" ] ) ] ;
            owl:onProperty dcterms:identifier ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dcterms:identifier ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^study\\.[A-Za-z0-9_-]+$" ] ) ] ;
            owl:onProperty governanceduo:StudyKey ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^syn\\d+$" ] ) ] ;
            owl:onProperty governanceduo:entityIdList ],
        governanceduo:BaseEntity,
        governanceduo:ContributionMixin,
        governanceduo:GovernanceMixin,
        governanceduo:PolicyFabricMixin,
        governanceduo:SynapseAccessRequirementMixin ;
    skos:definition "Representation of a Synapse Access Requirement and its relationships to entities, grants, and projects." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:AccessRequirementConcreteTypeEnum a rdfs:Datatype ;
    rdfs:label "AccessRequirementConcreteTypeEnum" ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:oneOf ( "TermsOfUseAccessRequirement" "SelfSignAccessRequirement" "ACTAccessRequirement" "ManagedACTAccessRequirement" "LockAccessRequirement" ) ] ;
    skos:definition "Synapse's real AccessRequirement subclasses, verified via Sage-Bionetworks/Synapse-Repository-Services's AccessRequirementType.java (lib/jdomodels/.../org/sagebionetworks/repo/model/ar/AccessRequirementType.java). Permissible values use the short Java class name; the actual ACCESS_REQUIREMENT.CONCRETE_TYPE column stores the fully-qualified name (e.g. \"org.sagebionetworks.repo.model.ManagedACTAccessRequirement\")." ;
    skos:inScheme governanceduo:governance_duo ;
    linkml:permissible_values "ACTAccessRequirement",
        "LockAccessRequirement",
        "ManagedACTAccessRequirement",
        "SelfSignAccessRequirement",
        "TermsOfUseAccessRequirement" .

governanceduo:AssetBinding a owl:Class ;
    rdfs:label "AssetBinding" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty governanceduo:assetDid ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty governanceduo:synapseId ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^did:[a-z0-9]+:.+$" ] ) ] ;
            owl:onProperty governanceduo:assetDid ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^syn\\d+$" ] ) ] ;
            owl:onProperty governanceduo:synapseId ] ;
    skos:definition "One (Synapse entity id -> Policy Fabric Asset DID) pairing. Mirrors the Django Asset model's `did` field (unique per Asset) in tmp-policies/tools/asset_registry. A plain string, not a typed `range: SynapseEntity`, for synapseId: importing governance_graph.yaml (where SynapseEntity is defined) into this leaf file would create the same import cycle base_entity.yaml/props.yaml/mixins.yaml are designed to avoid (governance_graph.yaml already depends on mixins.yaml transitively, through access_requirement.yaml)." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:ContributionMixin a owl:Class ;
    rdfs:label "ContributionMixin" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty governanceduo:contributorName ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty governanceduo:contributionDate ] ;
    skos:definition "Contribution/authorship tracking. Only AccessRequirement uses this today, but it is factored out here (rather than inlined) so any class that later needs the same fields reuses it instead of duplicating — mirroring SageCommonDataModel's practice of factoring cross-cutting concerns out of individual entity files even before a second consumer exists." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:CredentialRequirement a owl:Class ;
    rdfs:label "CredentialRequirement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty governanceduo:requiredClaims ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty governanceduo:credentialType ] ;
    skos:definition "One credential type a Policy Fabric policy_card requires the requester to present, and the specific claim path(s) it checks — verified from the folder's actual policy.rego, not inferred from the credential's schema alone (a credential type can be required without every one of its claims being read by a given policy)." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:CredentialTypeEnum a rdfs:Datatype ;
    rdfs:label "CredentialTypeEnum" ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:oneOf ( "AffiliationCredential" "LocationCredential" "publicKeyCredential" "AgreementCredential" "ComputeEnvironmentCredential" "EmailCredential" "EthicsCommitteeAccreditationCredential" "IRBApprovalCredential" "IntendedDataUseCredential" "LegalDesignationCredential" "ProjectOwnershipCredential" "ScopedAgreementCredential" "TeamCredential" "UserPlatformCredential" "WalletVerifyingKeyCredential" ) ] ;
    skos:definition "The 15 Verifiable Credential types defined in tmp-policies/credentials/*.schema.json." ;
    skos:inScheme governanceduo:governance_duo ;
    linkml:permissible_values "AffiliationCredential",
        "AgreementCredential",
        "ComputeEnvironmentCredential",
        "EmailCredential",
        "EthicsCommitteeAccreditationCredential",
        "IRBApprovalCredential",
        "IntendedDataUseCredential",
        "LegalDesignationCredential",
        "LocationCredential",
        "ProjectOwnershipCredential",
        "ScopedAgreementCredential",
        "TeamCredential",
        "UserPlatformCredential",
        "WalletVerifyingKeyCredential",
        "publicKeyCredential" .

governanceduo:DataPermissionEnum a rdfs:Datatype ;
    rdfs:label "DataPermissionEnum" ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:oneOf ( "Agreement" "Attestation" "Award" "Other" ) ] ;
    skos:inScheme governanceduo:governance_duo ;
    linkml:permissible_values "Agreement",
        "Attestation",
        "Award",
        "Other" .

governanceduo:DerivationReviewStatusEnum a rdfs:Datatype ;
    rdfs:label "DerivationReviewStatusEnum" ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:oneOf ( "Flagged" "Reviewed" "Approved" "Denied" ) ] ;
    skos:definition "Workflow state of a DerivationReview — the same enum-per-workflow-state convention ApprovalStateEnum/SubmissionStateEnum already use in governance_graph.yaml, deliberately a distinct enum from both (do not conflate)." ;
    skos:inScheme governanceduo:governance_duo ;
    linkml:permissible_values "Approved",
        "Denied",
        "Flagged",
        "Reviewed" .

governanceduo:DrsAuthTypeEnum a rdfs:Datatype ;
    rdfs:label "DrsAuthTypeEnum" ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:oneOf ( "None" "BasicAuth" "BearerAuth" "PassportAuth" ) ] ;
    skos:definition "Mirrors DRS's Authorizations.supported_types enum (https://ga4gh.github.io/data-repository-service-schemas/docs/). More than one can be supported and tried in sequence, per the DRS spec." ;
    skos:inScheme governanceduo:governance_duo ;
    linkml:permissible_values "BasicAuth",
        "BearerAuth",
        "None",
        "PassportAuth" .

governanceduo:LicenseEnum a rdfs:Datatype ;
    rdfs:label "LicenseEnum" ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:oneOf ( "CC0" "CC_BY" "CC_BY_NC" "CC_BY_ND" "CC_BY_SA" "CC_BY_NC_ND" "CC_BY_NC_SA" "Apache_2.0" "MIT" "GPL_3.0" "BSD_3_Clause" ) ] ;
    skos:definition "model/shared.model.csv's license Valid Values list Apache_2.0/GPL_3.0; the standalone CV reference model/valid_values.csv previously documented Apache_2/GPL_3 (no \".0\"/\"3.0\" suffix) for the same two licenses -- that mismatch has been fixed (valid_values.csv now matches shared.model.csv's spelling, the attribute's actual schematic Valid Values)." ;
    skos:inScheme governanceduo:governance_duo ;
    linkml:permissible_values "Apache_2.0",
        "BSD_3_Clause",
        "CC0",
        "CC_BY",
        "CC_BY_NC",
        "CC_BY_NC_ND",
        "CC_BY_NC_SA",
        "CC_BY_ND",
        "CC_BY_SA",
        "GPL_3.0",
        "MIT" .

governanceduo:PolicyCardBinding a owl:Class ;
    rdfs:label "PolicyCardBinding" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty governanceduo:dataUseModifier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:capabilityOperation ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty governanceduo:policyCardName ] ;
    skos:definition "One row per verified tmp-policies policy_cards/<name>/ folder: which DUO code it implements, its Reference Values Schema key(s), which existing (or missing) governanceDUO slot already collects each reference value, and which credentials/claims it requires. A referenceValueKey with no entry in referenceValueSources is intentionally left unmapped (rather than force-fit) wherever governanceDUO has no existing slot of the right shape — see policy_fabric_bindings.yaml's `notes` for any such case." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:PolicyFabricMixin a owl:Class ;
    rdfs:label "PolicyFabricMixin" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^did:[a-z0-9]+:.+$" ] ) ] ;
            owl:onProperty governanceduo:trustedIssuerDids ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:policyContractDid ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:guardianDataSource ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:guardianUrl ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^did:[a-z0-9]+:.+$" ] ) ] ;
            owl:onProperty governanceduo:policyContractDid ] ;
    skos:definition "Fields needed to deploy an AccessRequirement's governed entities into Policy Fabric (https://github.com/hasan7n/tmp-policies) as a registered Asset with an exposed policy. All optional — a governanceDUO record can exist before, or without ever, being deployed into Policy Fabric. Applied only to AccessRequirement: it already carries entityIdList (the concrete Synapse containers governed) and dataUseModifiers (which DUO codes/policy_cards apply), making it the natural analog of Policy Fabric's Asset + exposed-policy pairing — see linkml/policy_fabric.yaml and policy_fabric_bindings.yaml for the per-DUO-code credential/reference-value crosswalk this pairs with." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:ReferenceValueSource a owl:Class ;
    rdfs:label "ReferenceValueSource" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty governanceduo:sourceSlot ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:sourceField ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty governanceduo:keyIsMultivalued ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty governanceduo:referenceValueKey ] ;
    skos:definition "One (referenceValueKey -> governanceDUO slot) mapping. A single PolicyCardBinding can need more than one of these — e.g. time-limit-on-use needs both requiredDocumentID and notAfter, sourced from two different slots — so this is its own inlined list on PolicyCardBinding rather than one scalar \"sourceSlot\" field (an earlier version of this schema had exactly that limitation; it could not represent a binding needing 2+ keys from 2+ slots)." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:Resource a owl:Class ;
    rdfs:label "Resource" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^study\\.[A-Za-z0-9_-]+$" ] ) ] ;
            owl:onProperty governanceduo:StudyKey ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:speciesTypeKey ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:speciesTypeValue ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:studyAnnotationKey ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:grantAnnotationKey ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:registeredSchemaUrl ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:dataTypeValue ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:SchemaKey ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:activationValue ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^schema\\.[A-Za-z0-9_-]+$" ] ) ] ;
            owl:onProperty governanceduo:SchemaKey ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dcterms:identifier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:grantAnnotationValue ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:studyAnnotationValue ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:dataTypeKey ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:activatedByAttribute ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^resource\\.[A-Za-z0-9]+$" ] ) ] ;
            owl:onProperty dcterms:identifier ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^access_requirement\\.\\d+$" ] ) ] ;
            owl:onProperty governanceduo:AccessRequirementKey ],
        governanceduo:BaseEntity,
        governanceduo:GovernanceMixin ;
    skos:definition "Information that is relevant to resource access conditions." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:ResourceKey a owl:DatatypeProperty ;
    rdfs:label "ResourceKey" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^resource\\.[A-Za-z0-9]+$" ] ) ] ;
    skos:definition "The identifier(s) for the Resource(s) associated with this schema. Provide multiple values as a comma-separated list." ;
    skos:inScheme governanceduo:governance_duo ;
    skos:note "Untyped string, not range: Resource -- see props.yaml's AccessRequirementKey comment for why (this file cannot import resource.yaml without risking a cycle). The pattern below (matching Resource.id's own slot_usage pattern in resource.yaml) is the cycle-free substitute. See plans/identifier_update.md." ;
    governanceduo:foreign_key true .

governanceduo:Schema a owl:Class ;
    rdfs:label "Schema" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^study\\.[A-Za-z0-9_-]+$" ] ) ] ;
            owl:onProperty governanceduo:StudyKey ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^access_requirement\\.\\d+$" ] ) ] ;
            owl:onProperty governanceduo:AccessRequirementKey ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^resource\\.[A-Za-z0-9]+$" ] ) ] ;
            owl:onProperty governanceduo:ResourceKey ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:schemaUrl ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dcterms:identifier ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^schema\\.[A-Za-z0-9_-]+$" ] ) ] ;
            owl:onProperty dcterms:identifier ],
        governanceduo:BaseEntity ;
    skos:definition "Information that is relevant to resource access conditions." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:Study a owl:Class ;
    rdfs:label "Study" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty governanceduo:studyParticipantNumber ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^study\\.[A-Za-z0-9_-]+$" ] ) ] ;
            owl:onProperty dcterms:identifier ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty governanceduo:studySampleNumber ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:studyDbgapAccessionId ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty governanceduo:studyInvestigator ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dcterms:identifier ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty governanceduo:studyName ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^syn\\d+$" ] ) ] ;
            owl:onProperty governanceduo:studyProjectIdentifier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:studyDeidentificationMethodDescription ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:studyDeidentificationMethodSoftware ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty governanceduo:studyDescription ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^access_requirement\\.\\d+$" ] ) ] ;
            owl:onProperty governanceduo:AccessRequirementKey ],
        governanceduo:BaseEntity,
        governanceduo:GovernanceMixin ;
    skos:definition "Studies associated with a grant." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:StudyIndexDateEnum a rdfs:Datatype ;
    rdfs:label "StudyIndexDateEnum" ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:oneOf ( "Diagnosis Date" "Enrollment Date" "Collection Date" "Birth Date" ) ] ;
    skos:inScheme governanceduo:governance_duo ;
    linkml:permissible_values "Birth Date",
        "Collection Date",
        "Diagnosis Date",
        "Enrollment Date" .

governanceduo:SynapseAccessRequirementMixin a owl:Class ;
    rdfs:label "SynapseAccessRequirementMixin" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:createdBy ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:concreteType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:isTwoFaRequired ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:currentRevNum ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:etag ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:accessType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:createdOn ] ;
    skos:definition "The real Synapse-native ACCESS_REQUIREMENT row fields (verified against \"sagebrain governance graph ACL_AR data - AR table schemas.csv\" plus the live/source lookups documented on the shared slots and enums above), applied to AccessRequirement alongside GovernanceMixin (the DUO characterization of an AR's conditions) and ContributionMixin (this repo's own curator-provenance fields — distinct from Synapse's own createdBy/ createdOn here, see those slots' descriptions). Part of aligning governanceDUO with the SageBrain Governance Graph design, where an AccessRequirement is a first-class graph entity with its own Synapse identity, not only a DUO-condition record." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:accessRequirementVersion a owl:DatatypeProperty ;
    rdfs:label "accessRequirementVersion" ;
    rdfs:range xsd:integer ;
    skos:definition "The version of the AccessRequirement this submission was made against (DATA_ACCESS_SUBMISSION.ACCESS_REQUIREMENT_VERSION)." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:accessType a owl:ObjectProperty ;
    rdfs:label "accessType" ;
    rdfs:range governanceduo:AccessTypeEnum ;
    skos:definition "The kind of access this Access Requirement governs (ACCESS_REQUIREMENT.ACCESS_TYPE). Range is the same AccessTypeEnum used by AccessGrant.permission in governance_graph.yaml — one real Synapse ACCESS_TYPE type backs both an ACL grant's permission and an Access Requirement's own governed access kind." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:activatedByAttribute a owl:DatatypeProperty ;
    rdfs:label "activatedByAttribute" ;
    skos:definition "The name of a Synapse annotation key that will be applied to entities released under this AR. Setting this attribute to activationValue designates that the AR should be active." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:activationValue a owl:DatatypeProperty ;
    rdfs:label "activationValue" ;
    skos:definition "The value of Synapse annotation recorded under activatedByAttribute that will be applied to entities released under this AR to indicate the AR should be active." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:approvedProjects a owl:DatatypeProperty ;
    rdfs:label "approvedProjects" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^did:[a-z0-9]+:.+$" ] ) ] ;
    skos:definition "DID(s) of project(s) approved to use the data under this access requirement. Added to close a Policy Fabric gap: project-specific-restriction keys its Reference Values Schema on a multivalued approvedProjects list of DIDs, which no existing slot held." ;
    skos:inScheme governanceduo:governance_duo ;
    skos:note "Required when dataUseModifiers contains DUO:0000027 — see GovernanceMixin rules." .

governanceduo:attribution a owl:DatatypeProperty ;
    rdfs:label "attribution" ;
    skos:closeMatch ebiswo:9000006 ;
    skos:definition "The attribution statement for the data associated with the access requirement. Equivalent to DUOPlus7." ;
    skos:inScheme governanceduo:governance_duo ;
    skos:note "Required when dataUseModifiers contains DUOPlus7 — see GovernanceMixin rules.",
        "SWO:9000006 \"Attribution clause\" (Software Ontology term, reused via the mcro ontology) — a license-clause-shaped close mapping; this slot instead holds the free-text statement itself, not the clause concept." .

governanceduo:capabilityOperation a owl:DatatypeProperty ;
    rdfs:label "capabilityOperation" ;
    skos:definition "The \"name\" field of the Capability Granted this policy_card's Rego emits on success (every one of the 21 verified policy_cards emits \"do_download\" today — Policy Fabric has not yet diversified beyond dataset download)." ;
    skos:inScheme governanceduo:governance_duo ;
    skos:note "Related to, but intentionally not unified with, mixins.yaml's AccessTypeEnum (used by AccessGrant.permission and AccessRequirement.accessType): both describe \"what operation is being granted,\" but AccessTypeEnum is Synapse's own closed ACL vocabulary while this slot is Policy Fabric's free-string Rego capability-name convention -- the two vocabularies belong to different external systems and may drift independently, so this stays a free string rather than being coerced into AccessTypeEnum." .

governanceduo:collaborationRequired a owl:DatatypeProperty ;
    rdfs:label "collaborationRequired" ;
    skos:definition "If collaboration is required for the access requirement, provide the PI email address. Provide multiple as a comma-separated list." ;
    skos:exactMatch NCIT:C221739 ;
    skos:inScheme governanceduo:governance_duo ;
    skos:note "NCIT:C221739 \"Consent for Use Requires Collaboration Agreement\" carries the synonyms \"COL\"/\"Collaboration required\", the same shorthand this repo already uses for DUO:0000020 — verified live and non-obsolete via the OLS4 API.",
        "Required when dataUseModifiers contains DUO:0000020 — see GovernanceMixin rules." .

governanceduo:concreteType a owl:DatatypeProperty ;
    rdfs:label "concreteType" ;
    rdfs:range governanceduo:AccessRequirementConcreteTypeEnum ;
    skos:definition "Which kind of Access Requirement this is (ACCESS_REQUIREMENT.CONCRETE_TYPE). The real Synapse column stores the full Java class name (e.g. \"org.sagebionetworks.repo.model.ManagedACTAccessRequirement\"); this enum uses the short class name for readability." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:contributionDate a owl:DatatypeProperty ;
    rdfs:label "contributionDate" ;
    skos:closeMatch prov:generatedAtTime ;
    skos:definition "The date on which the access requirement was added." ;
    skos:inScheme governanceduo:governance_duo ;
    skos:note "prov:generatedAtTime (\"The time at which an entity was completely created and is available for use\") matches this slot's semantics closely, treating the AccessRequirement record itself as the generated prov:Entity.",
        "schematic Format: date" .

governanceduo:contributorName a owl:DatatypeProperty ;
    rdfs:label "contributorName" ;
    skos:closeMatch prov:wasAttributedTo ;
    skos:definition "The name of the person who added this access requirement." ;
    skos:inScheme governanceduo:governance_duo ;
    skos:note "prov:wasAttributedTo relates a prov:Entity to a prov:Agent; this slot holds a literal name rather than an Agent reference, so the mapping is close, not exact." .

governanceduo:createdOn a owl:DatatypeProperty ;
    rdfs:label "createdOn" ;
    rdfs:range xsd:integer ;
    skos:definition "When the record was created (epoch milliseconds in the source Synapse tables). Shared the same way as `name` above. Distinct from ContributionMixin's contributionDate for the same reason as createdBy above." ;
    skos:exactMatch dcterms:created ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:credentialType a owl:DatatypeProperty ;
    rdfs:label "credentialType" ;
    rdfs:range governanceduo:CredentialTypeEnum ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:currentRevNum a owl:DatatypeProperty ;
    rdfs:label "currentRevNum" ;
    rdfs:range xsd:integer ;
    skos:definition "The current revision number of the record. Shared the same way as `name` above, by SynapseAccessRequirementMixin (ACCESS_REQUIREMENT.CURRENT_REV_NUM) and SynapseEntity (NODE.CURRENT_REV_NUM)." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:dataTypeKey a owl:DatatypeProperty ;
    rdfs:label "dataTypeKey" ;
    skos:definition "The annotation key applied to a Synapse entity that contains a data type identifier." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:dataTypeValue a owl:DatatypeProperty ;
    rdfs:label "dataTypeValue" ;
    skos:definition "The value that will be assigned to the key provided under dataTypeKey. Value should be applied to Synapse entities released with this AR." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:diseaseSpecificResearch a owl:DatatypeProperty ;
    rdfs:label "diseaseSpecificResearch" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "MONDO:\\d{7}" ] ) ] ;
    skos:definition "The type(s) of disease research allowed by this access requirement. Provide the MONDO ID in format MONDO:id. Provide multiple values as a comma-separated list. MONDO terms can be found here: https://ols.monarchinitiative.org/ontologies/mondo" ;
    skos:inScheme governanceduo:governance_duo ;
    skos:note "Required when dataUseModifiers contains DUO:0000007 — see GovernanceMixin rules." .

governanceduo:drsId a owl:DatatypeProperty ;
    rdfs:label "drsId" ;
    skos:definition "The DRS DrsObject.id component. Recommended to be identical to synapseId — see this schema's own header comment for why a fourth internal identifier scheme isn't introduced here." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:entityIdList a owl:DatatypeProperty ;
    rdfs:label "entityIdList" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^syn\\d+$" ] ) ] ;
    skos:definition "Synapse ID(s) for Synapse container(s) (e.g. Project, Dataset, Folder, Table, etc.) with which the Access Requirement is expected to be associated. Provide multiple values as a comma-separated list." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:grantAnnotationKey a owl:DatatypeProperty ;
    rdfs:label "grantAnnotationKey" ;
    skos:definition "The annotation key applied to a Synapse entity that contains a grant identifier." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:grantAnnotationValue a owl:DatatypeProperty ;
    rdfs:label "grantAnnotationValue" ;
    skos:definition "The value that will be assigned to the key provided under grantAnnotationKey. Value should be applied to Synapse entities released with this AR." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:guardianDataSource a owl:DatatypeProperty ;
    rdfs:label "guardianDataSource" ;
    skos:definition "The data path/source configured for this asset's Guardian. Mirrors Asset.metadata.data_source, set by convention (not schema) in tmp-policies/tools/pdo_client at asset-setup time." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:guardianUrl a owl:DatatypeProperty ;
    rdfs:label "guardianUrl" ;
    skos:definition "The deployed Guardian service URL for this asset. Mirrors Asset.metadata.guardian_url, set by the same asset-setup convention." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:inputDataTiers a owl:DatatypeProperty ;
    rdfs:label "inputDataTiers" ;
    rdfs:range governanceduo:DataTierEnum ;
    skos:definition "The combination of input DataTierEnum values this rule governs." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:institutionDids a owl:DatatypeProperty ;
    rdfs:label "institutionDids" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^did:[a-z0-9]+:.+$" ] ) ] ;
    skos:definition "Institutions with specific restrictions associated with the access requirement, as decentralized identifiers (DIDs) rather than ROR ids. Policy Fabric (https://github.com/hasan7n/tmp-policies)'s institution-specific-restriction policy_card expects its allowedInstitutions reference values, and the AffiliationCredential.isMemberOf claim it checks against them, to both be organization DIDs — not ROR ids. No standard ROR-to-DID resolution exists yet, so this is a separate, companion slot rather than a reinterpretation of institutionSpecificRestriction's existing pattern." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:institutionSpecificRestriction a owl:DatatypeProperty ;
    rdfs:label "institutionSpecificRestriction" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "ROR:[a-z0-9]{9}" ] ) ] ;
    skos:definition "Institutions with specific restrictions associated with the access requirement. Provide the institution ROR ID in format ROR:id. Provide multiple entries as a comma-separated list. ROR IDs can be found here: https://ror.org/search" ;
    skos:inScheme governanceduo:governance_duo ;
    skos:note "Required when dataUseModifiers contains DUO:0000028 — see GovernanceMixin rules." .

governanceduo:isTwoFaRequired a owl:DatatypeProperty ;
    rdfs:label "isTwoFaRequired" ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether two-factor authentication is required (ACCESS_REQUIREMENT.IS_TWO_FA_REQUIRED)." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:keyIsMultivalued a owl:DatatypeProperty ;
    rdfs:label "keyIsMultivalued" ;
    rdfs:range xsd:boolean ;
    skos:definition "True if this referenceValueKey's own policy_data_schema.json documents it as a list (e.g. \"list of strings\"); False if it's a single scalar value (e.g. requiredDocumentID, notAfter, datasetID — each documented as \"DID of ...\"/an ISO-8601 datetime, not a list). This is a property of the Policy Fabric key itself, independent of whether its governanceDUO sourceSlot happens to be multivalued — e.g. datasetID is scalar even though it is sourced from the multivalued assetBindings slot (build_policy_fabric.py takes assetBindings[0].assetDid)." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:name a owl:DatatypeProperty ;
    rdfs:label "name" ;
    skos:definition "A Synapse-native display name. Shared by SynapseAccessRequirementMixin (ACCESS_REQUIREMENT.NAME) and, via the transitive import chain governance_graph.yaml -> access_requirement.yaml -> mixins.yaml, SynapseEntity (NODE.NAME) in governance_graph.yaml — defined once here rather than in governance_graph.yaml itself, since mixins.yaml cannot import governance_graph.yaml back without creating a cycle (governance_graph.yaml already depends on mixins.yaml through access_requirement.yaml)." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:notAfter a owl:DatatypeProperty ;
    rdfs:label "notAfter" ;
    skos:definition "ISO-8601 datetime after which use is no longer permitted. Added to close a Policy Fabric gap: time-limit-on-use's Reference Values Schema key notAfter is an absolute datetime, whereas the existing timeLimitOnUse slot holds a number of months — a different shape entirely, so this is a new, distinct slot." ;
    skos:inScheme governanceduo:governance_duo ;
    skos:note "Required when dataUseModifiers contains DUO:0000025 — see GovernanceMixin rules." .

governanceduo:passportAuthIssuers a owl:DatatypeProperty ;
    rdfs:label "passportAuthIssuers" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^did:[a-z0-9]+:.+$" ] ) ] ;
    skos:definition "Mirrors DRS's Authorizations.passport_auth_issuers — the whitelisted set of Visa `iss` issuers a client must draw from. Not populated here from a fixed value: sourced, per governed AccessRequirement, from that record's own PolicyFabricMixin.trustedIssuerDids (or, for institution-scoped DUO codes, GovernanceMixin.institutionDids) — see mixins.yaml. GA4GH Passport Visa issuers are conventionally identified as DIDs or URLs the same way those slots already are." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:permitted a owl:DatatypeProperty ;
    rdfs:label "permitted" ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether this combination of inputDataTiers may be joined/derived from together at all." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:policyCardName a owl:DatatypeProperty ;
    rdfs:label "policyCardName" ;
    skos:definition "The literal tmp-policies policy_cards/<name>/ folder name, e.g. \"geographical-restriction\"." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:populationType a owl:DatatypeProperty ;
    rdfs:label "populationType" ;
    skos:definition "The population studied in the research associated with the access requirement. Equivalent to DUOPlus2." ;
    skos:inScheme governanceduo:governance_duo ;
    skos:note "Required when dataUseModifiers contains DUOPlus2 — see GovernanceMixin rules." .

governanceduo:principalType a owl:ObjectProperty ;
    rdfs:label "principalType" ;
    rdfs:range governanceduo:PrincipalTypeEnum ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:publicationMoratorium a owl:DatatypeProperty ;
    rdfs:label "publicationMoratorium" ;
    skos:definition "End date of the publication moratorium associated with the access requirement." ;
    skos:inScheme governanceduo:governance_duo ;
    skos:note "Required when dataUseModifiers contains DUO:0000024 — see GovernanceMixin rules.",
        "schematic Format: date" .

governanceduo:rationale a owl:DatatypeProperty ;
    rdfs:label "rationale" ;
    skos:definition "Free-text justification for this rule's permitted/resultingDataTier values." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:referenceValueKey a owl:DatatypeProperty ;
    rdfs:label "referenceValueKey" ;
    skos:definition "One of the containing binding's referenceValueKeys, e.g. \"allowedCountries\"." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:registeredSchemaUrl a owl:DatatypeProperty ;
    rdfs:label "registeredSchemaUrl" ;
    skos:definition "URL associated with the annotation schema that will be applied to the resource type." ;
    skos:exactMatch dcterms:conformsTo ;
    skos:inScheme governanceduo:governance_duo ;
    skos:note "dcterms:conformsTo, \"An established standard to which the described resource conforms\" — exact match: this URL points at the registered JSON schema the resource must conform to." .

governanceduo:requiredClaims a owl:DatatypeProperty ;
    rdfs:label "requiredClaims" ;
    skos:definition "Dot-path claim name(s) this policy_card's Rego logic actually reads, e.g. \"locatedAt.country\"." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:requiresReview a owl:DatatypeProperty ;
    rdfs:label "requiresReview" ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether this combination is only conditionally permitted, pending a human DerivationReview, rather than flatly permitted/denied." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:researchSpecificRestrictions a owl:DatatypeProperty ;
    rdfs:label "researchSpecificRestrictions" ;
    skos:definition "Research-specific restrictions associated with the access requirement." ;
    skos:inScheme governanceduo:governance_duo ;
    skos:note "Required when dataUseModifiers contains DUO:0000012 — see GovernanceMixin rules." .

governanceduo:resultingDataTier a owl:DatatypeProperty ;
    rdfs:label "resultingDataTier" ;
    rdfs:range governanceduo:DataTierEnum ;
    skos:definition "The DataTierEnum the derived output carries when permitted. Defaults to max(inputDataTiers) per the note's own recommendation, but a rule may explicitly override it for a specific combination (e.g. an aggregation that demonstrably reduces sensitivity below its inputs' max). The override applies to what the output inherits: it never lowers the output below its own direct AccessRequirement bindings." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:schemaUrl a owl:DatatypeProperty ;
    rdfs:label "schemaUrl" ;
    skos:definition "The registered URL associated with the access requirement JSON schema." ;
    skos:exactMatch dcterms:conformsTo ;
    skos:inScheme governanceduo:governance_duo ;
    skos:note "dcterms:conformsTo, \"An established standard to which the described resource conforms\" — see resource.yaml's registeredSchemaUrl for the same exact mapping and rationale." .

governanceduo:sourceField a owl:DatatypeProperty ;
    rdfs:label "sourceField" ;
    skos:definition "When sourceSlot names an inlined class (e.g. PolicyFabricMixin.assetBindings, range AssetBinding), the sub-field of each element to extract — e.g. sourceSlot: assetBindings, sourceField: assetDid pulls AssetBinding.assetDid out of each entry. Unset when sourceSlot is a flat scalar/list slot." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:sourceSlot a owl:DatatypeProperty ;
    rdfs:label "sourceSlot" ;
    skos:definition "The name of the governanceDUO slot (on GovernanceMixin, Study, or the PolicyFabricMixin) that collects the value for the paired referenceValueKey." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:speciesTypeKey a owl:DatatypeProperty ;
    rdfs:label "speciesTypeKey" ;
    skos:definition "The annotation key applied to a Synapse entity that contains a species identifier." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:speciesTypeValue a owl:DatatypeProperty ;
    rdfs:label "speciesTypeValue" ;
    skos:definition "The value that will be assigned to the key provided under speciesTypeKey. Value should be applied to Synapse entities released with this AR." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:studyAnnotationKey a owl:DatatypeProperty ;
    rdfs:label "studyAnnotationKey" ;
    skos:definition "The annotation key applied to a Synapse entity that contains a study identifier." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:studyAnnotationValue a owl:DatatypeProperty ;
    rdfs:label "studyAnnotationValue" ;
    skos:definition "The value that will be assigned to the key provided under studyAnnotationKey. Value should be applied to Synapse entities released with this AR." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:studyDbgapAccessionId a owl:DatatypeProperty ;
    rdfs:label "studyDbgapAccessionId" ;
    skos:definition "A stable unique alphanumeric identifier assigned to a study and any objects by the database of Genotypes and Phenotypes (dbGaP). Required for controlled access data being submitted to CDS/CRDC." ;
    skos:exactMatch NCIT:C173940 ;
    skos:inScheme governanceduo:governance_duo ;
    skos:note "NCIT:C173940 \"dbGaP Accession Number\" — its OLS definition text is word-for- word this slot's description (the CSV description likely originates from this NCIT term already)." ;
    governanceduo:cde_id "11524544" .

governanceduo:studyDeidentificationMethodDescription a owl:DatatypeProperty ;
    rdfs:label "studyDeidentificationMethodDescription" ;
    skos:definition "Description of the process of removing potentially identifying data or data elements to render data into a form that does not identify individuals and where identification is not likely to take place." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:studyDeidentificationMethodSoftware a owl:DatatypeProperty ;
    rdfs:label "studyDeidentificationMethodSoftware" ;
    skos:definition "Software that was used to de-identify the data (if used)." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:studyDescription a owl:DatatypeProperty ;
    rdfs:label "studyDescription" ;
    skos:definition "Description of the study, including the types of experimental assays, model systems, types of analysis, description of cohort, associated vulnerable populations, special categories of data, rare diseases, etc. Maps to DUOPlus2." ;
    skos:inScheme governanceduo:governance_duo ;
    governanceduo:cde_id "03444002" .

governanceduo:studyInvestigator a owl:DatatypeProperty ;
    rdfs:label "studyInvestigator" ;
    skos:closeMatch NCIT:C19924 ;
    skos:definition "Investigator(s) associated with the project. Multiple names should be provided as a comma-separated list." ;
    skos:inScheme governanceduo:governance_duo ;
    skos:note "NCIT:C19924 \"Principal Investigator\" — a role concept, not a name; this slot holds literal investigator name(s), so the mapping is close, not exact." .

governanceduo:studyName a owl:DatatypeProperty ;
    rdfs:label "studyName" ;
    skos:definition "Name of the study." ;
    skos:inScheme governanceduo:governance_duo ;
    governanceduo:cde_id "11459810" .

governanceduo:studyParticipantNumber a owl:DatatypeProperty ;
    rdfs:label "studyParticipantNumber" ;
    rdfs:range xsd:float ;
    skos:definition "The number of participant instances associated with systematic investigation into a subject." ;
    skos:inScheme governanceduo:governance_duo ;
    governanceduo:cde_id "11555662" .

governanceduo:studyProjectIdentifier a owl:DatatypeProperty ;
    rdfs:label "studyProjectIdentifier" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^syn\\d+$" ] ) ] ;
    skos:definition "The Synapse Project identifier (synID) with which this Study is related." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:studySampleNumber a owl:DatatypeProperty ;
    rdfs:label "studySampleNumber" ;
    rdfs:range xsd:float ;
    skos:definition "The number of specimens associated with systematic investigation into a subject." ;
    skos:inScheme governanceduo:governance_duo ;
    governanceduo:cde_id "11555663" .

governanceduo:submissionId a owl:ObjectProperty ;
    rdfs:label "submissionId" ;
    rdfs:range sagegov:DataAccessSubmission ;
    skos:definition "The DataAccessSubmission this status record applies to (DATA_ACCESS_SUBMISSION_STATUS.SUBMISSION_ID)." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:timeLimitOnUse a owl:DatatypeProperty ;
    rdfs:label "timeLimitOnUse" ;
    rdfs:range xsd:float ;
    skos:definition "Time limit on the use of the data associated with the access requirement." ;
    skos:inScheme governanceduo:governance_duo ;
    skos:note "Required when dataUseModifiers contains DUO:0000025 — see GovernanceMixin rules." .

governanceduo:trustedIssuerDids a owl:DatatypeProperty ;
    rdfs:label "trustedIssuerDids" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^did:[a-z0-9]+:.+$" ] ) ] ;
    skos:definition "DID(s) of the Verifiable Credential issuer(s) this AccessRequirement's owner trusts to attest the claims its selected DUO codes require (see policy_fabric_bindings.yaml's requiredCredentials per code). Unlike PolicyCardBinding.requiredCredentials (a static, per-DUO-code fact), this varies per AccessRequirement — different owners may trust different institutional VC issuers — so it lives here, not in the policy_fabric.yaml lookup schema." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:userSpecificRestriction a owl:DatatypeProperty ;
    rdfs:label "userSpecificRestriction" ;
    skos:definition "The user-specific restrictions associated with the access requirement." ;
    skos:inScheme governanceduo:governance_duo ;
    skos:note "Required when dataUseModifiers contains DUO:0000026 — see GovernanceMixin rules." .

DUO:0000004 a owl:Class ;
    rdfs:label "DUO:0000004" ;
    rdfs:subClassOf governanceduo:DataUseModifierEnum ;
    owl:versionInfo "0.1.0" ;
    skos:definition "No Restriction - This data use permission indicates there is no restriction on use." ;
    skos:scopeNote "No Restriction - This data use permission indicates there is no restriction on use." ;
    governanceduo:duo_shorthand "NRES" .

DUO:0000006 a owl:Class ;
    rdfs:label "DUO:0000006" ;
    rdfs:subClassOf governanceduo:DataUseModifierEnum ;
    owl:versionInfo "0.1.0" ;
