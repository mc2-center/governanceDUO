sagegov:DataAccessRequest a owl:Class ;
    rdfs:label "DataAccessRequest" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sagegov:requestConcreteType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sagegov:researchProject ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^data_access_request\\.\\d+$" ] ) ] ;
            owl:onProperty dcterms:identifier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sagegov:requestPrincipalInvestigatorName ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sagegov:modifiedOn ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sagegov:modifiedBy ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sagegov:accessRequirement ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sagegov:requestSigningOfficialEmail ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sagegov:requestPrincipalInvestigatorEmail ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sagegov:summaryOfUse ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sagegov:publication ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dcterms:identifier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sagegov:createdOn ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sagegov:requestSigningOfficialName ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sagegov:institution ],
        [ a owl:Restriction ;
            owl:allValuesFrom sagegov:Principal ;
            owl:onProperty sagegov:createdBy ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sagegov:createdBy ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sagegov:etag ],
        governanceduo:BaseEntity ;
    skos:definition """A user's draft/submitted request against an AccessRequirement, behind a DataAccessSubmission. Mirrors Synapse's real RequestInterface/Request/ Renewal REST objects (org.sagebionetworks.repo.model.dataaccess), verified against the OpenAPI spec directly -- rest-docs.synapse.org's page for this object 403'd, so the spec was the only source (see plans/governance_graph_open_questions.md Section C.1). Field names deliberately differ from DataAccessSubmission's (corrected) ones: RequestInterface genuinely uses createdBy/createdOn/modifiedBy/ modifiedOn, not submittedBy/submittedOn -- these are two different real Synapse objects, not the same field-naming convention applied twice.
`principalInvestigator`/`signingOfficial` are real nested sub-objects in the live API (userId/name/institutionalEmail and name/institutionalEmail respectively), flattened here into literal slots rather than given their own nested classes: neither has an independent identifier of its own, and nothing else in this graph needs to reference them individually. `signingOfficial` in particular is a plausible seed for richer Site-level-authority modeling later, noted as future work rather than built now that Principal.company/ gov:affiliatedWith covers the more general per-Principal case with real data already.""" ;
    skos:exactMatch governanceduo:DataAccessRequest ;
    skos:inScheme governanceduo:governance_duo .

sagegov:DataAccessSubmission a owl:Class ;
    rdfs:label "DataAccessSubmission" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sagegov:researchProject ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sagegov:submittedOn ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sagegov:modifiedBy ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sagegov:accessRequirement ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sagegov:submittedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^data_access_submission\\.\\d+$" ] ) ] ;
            owl:onProperty dcterms:identifier ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dcterms:identifier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sagegov:requestId ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:accessRequirementVersion ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sagegov:etag ],
        governanceduo:BaseEntity ;
    skos:definition """A user's application against an AccessRequirement. Mirrors DATA_ACCESS_SUBMISSION. Represents the design doc's "user satisfaction" side of an Access Requirement (gov:hasSignedAgreement / gov:hasApproval) as an explicit, auditable record rather than a precomputed boolean.
Field names below were corrected to match Synapse's live REST API object (`org.sagebionetworks.repo.model.dataaccess.Submission`, per the OpenAPI spec), not just the original DATA_ACCESS_SUBMISSION table-column guess: the live API names the submitter/timestamp fields `submittedBy`/ `submittedOn` (not `createdBy`/`createdOn`), the originating request `requestId` (not `dataAccessRequestId`), and exposes `modifiedBy` directly on Submission itself -- moved here from DataAccessSubmissionStatus, which does not carry it in the live API (see that class's own description).""" ;
    skos:exactMatch governanceduo:DataAccessSubmission ;
    skos:inScheme governanceduo:governance_duo .

