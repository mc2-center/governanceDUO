governanceduo:GovernanceMixin a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "GovernanceMixin" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:collaborationRequired ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:timeLimitOnUse ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:publicationMoratorium ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^did:[a-z0-9]+:.+$" ] ) ] ;
            owl:onProperty governanceduo:approvedProjects ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:requiredAgreementDocumentId ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:attribution ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^did:[a-z0-9]+:.+$" ] ) ] ;
            owl:onProperty governanceduo:requiredAgreementDocumentId ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^did:[a-z0-9]+:.+$" ] ) ] ;
            owl:onProperty governanceduo:institutionDids ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "MONDO:\\d{7}" ] ) ] ;
            owl:onProperty governanceduo:diseaseSpecificResearch ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "ROR:[a-z0-9]{9}" ] ) ] ;
            owl:onProperty governanceduo:institutionSpecificRestriction ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:userSpecificRestriction ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:populationType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:researchSpecificRestrictions ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:notAfter ] ;
    skos:definition "DUO-based data-use-modifier vocabulary and its conditional-requirement rules, shared by every class whose schematic DependsOn list includes dataUseModifiers (AccessRequirement, Resource, Study — confirmed against the generated sage-ar-model/*.json, which resolves the full field set via schematic's own dependency expansion)." ;
    skos:inScheme governanceduo:mixins .

