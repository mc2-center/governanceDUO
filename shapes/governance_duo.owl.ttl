governanceduo:SchemaKey a owl:DatatypeProperty ;
    rdfs:label "SchemaKey" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^schema\\.[A-Za-z0-9_-]+$" ] ) ] ;
    skos:definition "The Schema id corresponding to a registered JSON schema that describes the access conditions relevant to this Resource." ;
    skos:inScheme governanceduo:governance_duo ;
    skos:note "Untyped string, not range: Schema -- see props.yaml's AccessRequirementKey comment for why (this file cannot import schema.yaml without risking a cycle). The pattern below (matching Schema.id's own slot_usage pattern in schema.yaml) is the cycle-free substitute. See plans/identifier_update.md." ;
    governanceduo:foreign_key true .

governanceduo:assetDid a owl:DatatypeProperty ;
    rdfs:label "assetDid" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^did:[a-z0-9]+:.+$" ] ) ] ;
    skos:definition "The Policy Fabric Asset-registry DID for synapseId." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:dataUseModifier a owl:ObjectProperty ;
    rdfs:label "dataUseModifier" ;
    rdfs:range governanceduo:DataUseModifierEnum ;
    skos:definition "The DUO code (or Sage DUOPlus extension) this binding documents." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:drsSelfUri a owl:DatatypeProperty ;
    rdfs:label "drsSelfUri" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^drs://.+$" ] ) ] ;
    skos:definition "The DRS DrsObject.self_uri — a hostname-based `drs://<hostname>/<drsId>` URI (DRS's other addressing style, compact-identifier URIs resolved via identifiers.org/n2t.net, is not used here since Synapse ids already resolve directly against a Synapse-operated DRS host)." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:policyContractDid a owl:DatatypeProperty ;
    rdfs:label "policyContractDid" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^did:[a-z0-9]+:.+$" ] ) ] ;
    skos:definition "The DID of the deployed rego_policy_agent/rego_token contract pair once this AccessRequirement's selected DUO codes have been \"exposed\" as a policy in Policy Fabric. Mirrors Asset.metadata.policy_contract." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:requiredAgreementDocumentId a owl:DatatypeProperty ;
    rdfs:label "requiredAgreementDocumentId" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^did:[a-z0-9]+:.+$" ] ) ] ;
    skos:definition "DID of the terms/agreement document the requester must accept before this access requirement's data use modifiers are satisfied. Added to close a Policy Fabric (https://github.com/hasan7n/tmp-policies) gap: its general-research-use, publication-moratorium, return-to-database-or-resource, and time-limit-on-use policy_cards all key their Reference Values Schema on a single requiredDocumentID, which no existing slot held — publicationMoratorium and timeLimitOnUse hold a date/duration, not a document identifier, so this is a new, distinct slot rather than a reinterpretation of either." ;
    skos:inScheme governanceduo:governance_duo ;
    skos:note "Required when dataUseModifiers contains DUO:0000042, DUO:0000024, DUO:0000029, or DUO:0000025 — see GovernanceMixin rules." .

xsd:float a rdfs:Datatype .

xsd:integer a rdfs:Datatype .

governanceduo:AccessRequirementKey a owl:DatatypeProperty ;
    rdfs:label "AccessRequirementKey" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^access_requirement\\.\\d+$" ] ) ] ;
    skos:definition "The Access Requirement id(s) associated with this object. Provide multiple values as a comma-separated list." ;
    skos:inScheme governanceduo:governance_duo ;
    skos:note "Deliberately an untyped string, not range: AccessRequirement: giving it a real typed range would require importing access_requirement.yaml into this file, but this file (like mixins.yaml) is a leaf that imports only linkml:types specifically so it can never import an entity file and risk an import cycle (see the schema-level description above). governance_graph.yaml can afford real typed ranges for its own cross-references (e.g. accessRequirement: range: AccessRequirement) because it is a single, later-loaded file that already imports everything it references -- this file cannot follow that pattern without breaking its own leaf-file guarantee. Same rationale applies to StudyKey below and to ResourceKey (schema.yaml)/SchemaKey (resource.yaml). The pattern above (matching AccessRequirement.id's own slot_usage pattern in access_requirement.yaml) is the cycle-free substitute: it catches a malformed id without needing a typed range at all -- the same approach already used for entityIdList in that same file. See plans/identifier_update.md." ;
    governanceduo:foreign_key true .

governanceduo:GovernanceMixin a owl:Class ;
    rdfs:label "GovernanceMixin" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:populationType ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^did:[a-z0-9]+:.+$" ] ) ] ;
            owl:onProperty governanceduo:approvedProjects ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:researchSpecificRestrictions ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:notAfter ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:attribution ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:publicationMoratorium ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^did:[a-z0-9]+:.+$" ] ) ] ;
            owl:onProperty governanceduo:institutionDids ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:userSpecificRestriction ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "ROR:[a-z0-9]{9}" ] ) ] ;
            owl:onProperty governanceduo:institutionSpecificRestriction ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "MONDO:\\d{7}" ] ) ] ;
            owl:onProperty governanceduo:diseaseSpecificResearch ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:timeLimitOnUse ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:collaborationRequired ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^did:[a-z0-9]+:.+$" ] ) ] ;
            owl:onProperty governanceduo:requiredAgreementDocumentId ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty governanceduo:requiredAgreementDocumentId ] ;
    skos:definition "DUO-based data-use-modifier vocabulary and its conditional-requirement rules, shared by every class whose schematic DependsOn list includes dataUseModifiers (AccessRequirement, Resource, Study — confirmed against the generated (now archived) archive/sage-ar-model/*.json, which resolves the full field set via schematic's own dependency expansion)." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:StudyKey a owl:DatatypeProperty ;
    rdfs:label "StudyKey" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^study\\.[A-Za-z0-9_-]+$" ] ) ] ;
    skos:definition "The Study id(s) associated with this object. Provide multiple values as a comma-separated list." ;
    skos:inScheme governanceduo:governance_duo ;
    governanceduo:foreign_key true .

gov:DataTier a owl:Class .

xsd:boolean a rdfs:Datatype .

governanceduo:synapseId a owl:DatatypeProperty ;
    rdfs:label "synapseId" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^syn\\d+$" ] ) ] ;
    skos:definition "A Synapse entity id. Reused across contexts that reference one specific Synapse entity: an AssetBinding registering it as a Policy Fabric Asset (this file), or a DrsObjectMapping crosswalking it to a DRS DrsObject (drs_alignment.yaml)." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:BaseEntity a owl:Class ;
    rdfs:label "BaseEntity" ;
    rdfs:subClassOf [ owl:unionOf ( governanceduo:AccessRequirement governanceduo:DerivationRule governanceduo:Resource governanceduo:Schema governanceduo:Study ) ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dcterms:identifier ] ;
    skos:definition "Abstract root shared by every governanceDUO class." ;
    skos:inScheme governanceduo:governance_duo .

dcterms:identifier a owl:DatatypeProperty ;
    rdfs:label "id" ;
    skos:definition "A unique identifier for this record. Narrowed per class via `slot_usage` in access_requirement.yaml/resource.yaml/schema.yaml/study.yaml/governance_graph.yaml (SynapseEntity/AccessGrant/AccessRequirementAssociation/DataAccessSubmission). The schematic CSV source (../model/*.model.csv) keeps class-prefixed attribute names (AccessRequirement_id, Resource_id, Schema_id, Study_id) instead: schematic's model CSV has one flat, global Attribute namespace with no per-class scoping equivalent to slot_usage, so four classes cannot share a bare \"id\" attribute there without colliding." ;
    skos:inScheme governanceduo:governance_duo .

governanceduo:DataUseModifierEnum a owl:Class ;
    rdfs:label "DataUseModifierEnum" ;
    owl:unionOf ( DUO:0000042 DUO:0000027 DUO:0000016 DUO:0000029 DUO:0000043 DUO:0000015 DUO:0000004 DUO:0000045 DUO:0000017 DUO:0000011 DUO:0000046 DUO:0000018 DUO:0000044 DUO:0000021 DUO:0000006 DUO:0000019 DUO:0000026 DUO:0000020 DUO:0000012 DUO:0000025 DUO:0000024 DUO:0000028 DUO:0000022 DUO:0000007 sagegov:DUOPlus1 sagegov:DUOPlus2 sagegov:DUOPlus3 sagegov:DUOPlus4 sagegov:DUOPlus5 sagegov:DUOPlus6 sagegov:DUOPlus7 <https://w3id.org/sage-bionetworks/governance-duo/DataUseModifierEnum#Pending%20Annotation> ) ;
    skos:definition "Data Use Ontology (DUO) modifier codes, plus Sage-local DUOPlus1-7 extensions (see README) and \"Pending Annotation\". Real DUO terms carry `meaning:` pointing at the actual obo:DUO_ IRI (reuse-by-IRI, not re-minting — the same convention sagebrain-model documents for its own external-term reuse). The Sage-local DUOPlus1-7 extensions carry `meaning:` gov: IRIs (sagegov:DUOPlus<n>), declared as individuals in shapes/governance_graph.owl.ttl, so every data-use code in the graph is an IRI -- joinable against sagebrain-model's DUO import -- rather than a mix of IRIs and strings. \"Pending Annotation\" has no meaning: it is a curation state, not a data-use condition." ;
    skos:inScheme governanceduo:governance_duo ;
    linkml:permissible_values DUO:0000004,
        DUO:0000006,
        DUO:0000007,
        DUO:0000011,
        DUO:0000012,
        DUO:0000015,
        DUO:0000016,
        DUO:0000017,
        DUO:0000018,
        DUO:0000019,
        DUO:0000020,
        DUO:0000021,
        DUO:0000022,
        DUO:0000024,
        DUO:0000025,
        DUO:0000026,
        DUO:0000027,
        DUO:0000028,
        DUO:0000029,
        DUO:0000042,
        DUO:0000043,
        DUO:0000044,
        DUO:0000045,
        DUO:0000046,
        sagegov:DUOPlus1,
        sagegov:DUOPlus2,
        sagegov:DUOPlus3,
        sagegov:DUOPlus4,
        sagegov:DUOPlus5,
        sagegov:DUOPlus6,
        sagegov:DUOPlus7,
        <https://w3id.org/sage-bionetworks/governance-duo/DataUseModifierEnum#Pending%20Annotation> .

xsd:string a rdfs:Datatype .

governanceduo:governance_duo a owl:Ontology ;
    rdfs:label "governance_duo" ;
    owl:versionIRI <https://w3id.org/sage-bionetworks/governance-duo/governance_duo/0.1.0> ;
    owl:versionInfo "0.1.0" ;
    skos:definition "LinkML representation of the Sage Bionetworks governanceDUO data model (Access Requirement, Resource, Schema, Study), its Policy Fabric integration (policy_fabric.yaml), and a design-only GA4GH Data Repository Service (DRS) interoperability crosswalk (drs_alignment.yaml). The graph-layer knowledge graph (ACLs, Access Requirements, provenance, and the derived ControlLabel/ DerivationReview records a DerivationRule -- derivation_policy.yaml, kept here in the record layer -- configures) is a separate schema, linkml/graph/governance.yaml (plans/model_refactor.md), imported by mixins.yaml for its shared vocabularies rather than by this file. Architecturally aligned with SageCommonDataModel (https://github.com/Sage-Bionetworks/SageCommonDataModel — one file per entity, a shared BaseEntity + mixins, slot_usage narrowing, prefix/URI discipline). Shaped to interoperate with sagebrain-model (https://github.com/Sage-Bionetworks/sagebrain-model) and the Data Use Ontology (DUO): real DUO terms are reused by IRI via `meaning:` CURIEs rather than re-minted, and the `sagebrain`/`biolink` prefixes below are declared so scripts/build_owl.py's output lines up with sagebrain's own namespaces the moment cross-repo linking is in scope. This is the single entry point — import this file to get the whole model, or import an individual file below for partial use." .

