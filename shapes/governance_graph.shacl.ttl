## governance_graph.shacl.ttl
##
## Hand-authored SHACL shapes for governance_graph_export/governance_graph.ttl -- the
## gov:/syn:-namespaced ABox scripts/build_governance_graph.py emits. gen-shacl (run
## against governance_graph.yaml, which now declares class_uri/slot_uri under this
## same sagegov: namespace) DOES compile most of these slots' cardinality/datatype
## constraints into shapes/governance_duo.shacl.ttl's sh:path entries directly -- but
## its sh:targetClass stays governanceduo:AccessGrant (etc.), the schema's primary
## class identity, not gov:AccessGrant, and it has no way to express the parts of this
## ABox with no LinkML slot behind them at all: Principal's bare-integer id minting,
## the hasACL/hasAccessRequirement/hasApproval derived triples, or the id-hyphenation
## display convention (see build_governance_graph.py's module docstring). This file
## exists specifically to target gov:-namespaced classes and cover those gaps --
## validating what the script actually emits, not a hypothetical fully-generic
## mapping.
##
## Run via `make governance-graph-validate` (scripts/validate_graph.py, pySHACL,
## inference="none", with shapes/governance_graph.owl.ttl passed as ont_graph so
## gov:Team/gov:User resolve as gov:Principal for PrincipalShape).
##
## Known limitations (documented, not silently ignored):
##   - Subject-IRI id patterns (e.g. SynapseEntity ids matching ^syn\d+$) are not
##     checked here -- these individuals carry no separate literal "id" property to
##     pattern-match against (the id lives entirely in the subject IRI), and SHACL
##     Core has no direct way to constrain a subject IRI's own local name without a
##     SPARQL-based constraint. Out of scope for this pass.

@prefix gov: <https://sagebionetworks.org/governance/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# SynapseEntity
#################################################################

gov:SynapseEntityShape a sh:NodeShape ;
    sh:targetClass gov:SynapseEntity ;
    sh:property
        [ sh:path gov:name ; sh:datatype xsd:string ; sh:maxCount 1 ],
        [ sh:path gov:nodeType ; sh:datatype xsd:string ; sh:maxCount 1 ],
        [ sh:path gov:alias ; sh:datatype xsd:string ; sh:maxCount 1 ],
        [ sh:path gov:currentRevNum ; sh:datatype xsd:integer ; sh:maxCount 1 ],
        [ sh:path gov:maxRevNum ; sh:maxCount 1 ],
        [ sh:path gov:etag ; sh:datatype xsd:string ; sh:maxCount 1 ],
        [ sh:path gov:createdByUserId ; sh:datatype xsd:integer ; sh:maxCount 1 ],
        [ sh:path gov:createdOn ; sh:datatype xsd:long ; sh:maxCount 1 ],
        [ sh:path gov:parentId ; sh:class gov:SynapseEntity ; sh:nodeKind sh:IRI ; sh:maxCount 1 ],
        [ sh:path gov:hasACL ; sh:class gov:AccessGrant ; sh:nodeKind sh:IRI ],
        [ sh:path gov:hasAccessRequirement ; sh:class gov:AccessRequirement ; sh:nodeKind sh:IRI ] .

#################################################################
# AccessGrant
#################################################################

gov:AccessGrantShape a sh:NodeShape ;
    sh:targetClass gov:AccessGrant ;
    sh:property
        [ sh:path gov:resource ; sh:class gov:SynapseEntity ; sh:nodeKind sh:IRI ;
            sh:minCount 1 ; sh:maxCount 1 ],
        [ sh:path gov:principal ; sh:class gov:Principal ; sh:nodeKind sh:IRI ;
            sh:minCount 1 ; sh:maxCount 1 ],
        [ sh:path gov:permission ; sh:nodeKind sh:IRI ; sh:minCount 1 ;
            sh:in ( gov:CREATE gov:READ gov:UPDATE gov:DELETE gov:CHANGE_PERMISSIONS
                    gov:DOWNLOAD gov:UPLOAD gov:PARTICIPATE gov:SUBMIT
                    gov:READ_PRIVATE_SUBMISSION gov:UPDATE_SUBMISSION
                    gov:DELETE_SUBMISSION gov:TEAM_MEMBERSHIP_UPDATE gov:SEND_MESSAGE
                    gov:CHANGE_SETTINGS gov:MODERATE gov:REVIEW_SUBMISSIONS
                    gov:EXEMPTION_ELIGIBLE ) ],
        [ sh:path gov:source ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ],
        [ sh:path gov:bindingType ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;
            sh:in ( gov:Direct gov:Inherited ) ],
        [ sh:path gov:createdOn ; sh:datatype xsd:long ; sh:maxCount 1 ],
        [ sh:path gov:sourceAclId ; sh:datatype xsd:integer ; sh:maxCount 1 ],
        [ sh:path gov:sourceAclResourceAccessId ; sh:datatype xsd:integer ; sh:maxCount 1 ] .

#################################################################
# AccessRequirementAssociation
#################################################################

gov:AccessRequirementAssociationShape a sh:NodeShape ;
    sh:targetClass gov:AccessRequirementAssociation ;
    sh:property
        [ sh:path gov:resource ; sh:class gov:SynapseEntity ; sh:nodeKind sh:IRI ;
            sh:minCount 1 ; sh:maxCount 1 ],
        [ sh:path gov:accessRequirement ; sh:class gov:AccessRequirement ;
            sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ],
        [ sh:path gov:source ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ],
        [ sh:path gov:bindingType ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;
            sh:in ( gov:Direct gov:Inherited ) ] .

#################################################################
# DataAccessSubmission (DataAccessSubmissionStatus's state/rejectedReason/modifiedOn
# fields merge in here -- see governance_graph.yaml's own note that
# DataAccessSubmissionStatus has no independent identifier in Synapse's schema.
# Field names/shapes here were corrected to match Synapse's live Submission/
# SubmissionStatus REST objects -- see governance_graph.yaml's corrected
# descriptions on both classes.)
#################################################################

gov:DataAccessSubmissionShape a sh:NodeShape ;
    sh:targetClass gov:DataAccessSubmission ;
    sh:property
        [ sh:path gov:accessRequirement ; sh:class gov:AccessRequirement ;
            sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;
            sh:description "Sources DataAccessSubmission.accessRequirementId via the same gov:accessRequirement predicate AccessRequirementAssociation uses -- see shapes/governance_graph.owl.ttl." ],
        [ sh:path gov:submittedBy ; sh:class gov:Principal ; sh:nodeKind sh:IRI ;
            sh:minCount 1 ; sh:maxCount 1 ;
            sh:description "An IRI reference to a gov:Principal node, not a literal integer -- governance_graph.yaml declares this slot's range as integer; the ABox deliberately links to the submitter's Principal individual instead. See shapes/governance_graph.owl.ttl." ],
        [ sh:path gov:submittedOn ; sh:datatype xsd:long ; sh:maxCount 1 ],
        [ sh:path gov:modifiedBy ; sh:class gov:Principal ; sh:nodeKind sh:IRI ;
            sh:maxCount 1 ;
            sh:description "Synapse's live Submission REST object carries modifiedBy directly, not DataAccessSubmissionStatus (which has no such field live) -- see shapes/governance_graph.owl.ttl." ],
        [ sh:path gov:researchProject ; sh:class gov:ResearchProject ; sh:nodeKind sh:IRI ;
            sh:maxCount 1 ;
            sh:description "Now a real gov:ResearchProject node (was a bare integer literal)." ],
        [ sh:path gov:state ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;
            sh:in ( gov:SUBMITTED gov:APPROVED gov:REJECTED gov:CANCELLED ) ],
        [ sh:path gov:rejectedReason ; sh:datatype xsd:string ; sh:maxCount 1 ],
        [ sh:path gov:statusModifiedOn ; sh:datatype xsd:long ; sh:maxCount 1 ] .

#################################################################
# Principal (targets gov:Principal; add_principal() asserts this type explicitly on
# every individual, alongside gov:Team/gov:User -- see shapes/governance_graph.owl.ttl)
#################################################################

gov:PrincipalShape a sh:NodeShape ;
    sh:targetClass gov:Principal ;
    sh:property
        [ sh:path gov:principalId ; sh:datatype xsd:integer ; sh:minCount 1 ;
            sh:maxCount 1 ],
        [ sh:path gov:affiliatedWith ; sh:class gov:Site ; sh:nodeKind sh:IRI ;
            sh:maxCount 1 ;
            sh:description "Derived from UserProfile.company (User-type Principals only) -- a derived convenience triple with no governance_graph.yaml slot backing it, same as gov:hasACL/gov:hasCondition. See shapes/governance_graph.owl.ttl." ] .

#################################################################
# AccessRequirement -- a stub reference node in this ABox (see
# shapes/governance_graph.owl.ttl); no properties of its own to constrain beyond type
# and, now, its optional gov:hasCondition edges.
#################################################################

gov:AccessRequirementShape a sh:NodeShape ;
    sh:targetClass gov:AccessRequirement ;
    sh:property
        [ sh:path owl:sameAs ; sh:nodeKind sh:IRI ; sh:maxCount 1 ;
            sh:description "Identity bridge to the corresponding governanceduo:access_requirement.<n> individual -- see shapes/governance_graph.owl.ttl." ],
        [ sh:path gov:hasCondition ; sh:class gov:Condition ; sh:nodeKind sh:IRI ;
            sh:description "Derived convenience triple with no governance_graph.yaml slot backing it, same as gov:hasACL/gov:hasAccessRequirement -- see shapes/governance_graph.owl.ttl." ] .

#################################################################
# Condition -- surfaces GovernanceMixin's DUO-condition data as a first-class node
# (see governance_graph.yaml's Condition class description and
# scripts/build_governance_graph.py's add_access_requirement()).
#################################################################

gov:ConditionShape a sh:NodeShape ;
    sh:targetClass gov:Condition ;
    sh:property
        [ sh:path gov:conditionType ; sh:datatype xsd:string ; sh:minCount 1 ;
            sh:maxCount 1 ],
        [ sh:path gov:duoCode ; sh:datatype xsd:string ; sh:maxCount 1 ;
            sh:description "Absent for the 7 Sage-local DUOPlus1-7 extensions, which have no real DUO CURIE -- see governance_graph.yaml." ],
        [ sh:path gov:description ; sh:datatype xsd:string ; sh:maxCount 1 ],
        [ sh:path gov:conditionDetail ; sh:datatype xsd:string ;
            sh:description "Zero or more companion-slot values -- GovernanceMixin.rules is many-to-many, so cardinality is deliberately unconstrained. See governance_graph.yaml." ] .

#################################################################
# AccessApproval -- a real, separate Synapse object from
# DataAccessSubmission/DataAccessSubmissionStatus (see governance_graph.yaml's
# own class description). gov:hasApproval, re-derived from this class, is
# validated on PrincipalShape below, same treatment as the existing
# DataAccessSubmissionStatus-derived edge.
#################################################################

gov:AccessApprovalShape a sh:NodeShape ;
    sh:targetClass gov:AccessApproval ;
    sh:property
        [ sh:path gov:satisfies ; sh:class gov:AccessRequirement ; sh:nodeKind sh:IRI ;
            sh:minCount 1 ; sh:maxCount 1 ],
        [ sh:path gov:requirementVersion ; sh:datatype xsd:integer ; sh:maxCount 1 ],
        [ sh:path gov:submittedBy ; sh:class gov:Principal ; sh:nodeKind sh:IRI ;
            sh:minCount 1 ; sh:maxCount 1 ;
            sh:description "AccessApproval.submitterId, reusing DataAccessSubmission's sagegov:submittedBy predicate -- see shapes/governance_graph.owl.ttl." ],
        [ sh:path gov:heldBy ; sh:class gov:Principal ; sh:nodeKind sh:IRI ;
            sh:minCount 1 ; sh:maxCount 1 ],
        [ sh:path gov:status ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;
            sh:in ( gov:APPROVED gov:REVOKED ) ;
            sh:description "ApprovalStateEnum -- distinct from DataAccessSubmission's SubmissionStateEnum-valued gov:state, despite sharing the value gov:APPROVED." ],
        [ sh:path gov:expiresAt ; sh:datatype xsd:long ; sh:maxCount 1 ],
        [ sh:path gov:createdOn ; sh:datatype xsd:long ; sh:maxCount 1 ],
        [ sh:path gov:sourceApprovalId ; sh:datatype xsd:integer ; sh:maxCount 1 ],
        [ sh:path gov:etag ; sh:datatype xsd:string ; sh:maxCount 1 ] .

#################################################################
# ResearchProject
#################################################################

gov:ResearchProjectShape a sh:NodeShape ;
    sh:targetClass gov:ResearchProject ;
    sh:property
        [ sh:path gov:accessRequirement ; sh:class gov:AccessRequirement ; sh:nodeKind sh:IRI ;
            sh:minCount 1 ; sh:maxCount 1 ],
        [ sh:path gov:affiliatedWith ; sh:class gov:Site ; sh:nodeKind sh:IRI ;
            sh:maxCount 1 ;
            sh:description "Derived from institution -- not independently re-emitted as a literal on this subject." ],
        [ sh:path gov:projectLead ; sh:datatype xsd:string ; sh:maxCount 1 ],
        [ sh:path gov:intendedDataUseStatement ; sh:datatype xsd:string ; sh:maxCount 1 ],
        [ sh:path gov:createdBy ; sh:class gov:Principal ; sh:nodeKind sh:IRI ; sh:maxCount 1 ],
        [ sh:path gov:createdOn ; sh:datatype xsd:long ; sh:maxCount 1 ],
        [ sh:path gov:etag ; sh:datatype xsd:string ; sh:maxCount 1 ] .

#################################################################
# Site -- minted deterministically from institution/company strings, not a
# real Synapse id (see governance_graph.yaml's Site class description).
#################################################################

gov:SiteShape a sh:NodeShape ;
    sh:targetClass gov:Site ;
    sh:property
        [ sh:path gov:institution ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] .
