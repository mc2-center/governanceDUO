## governance_graph.shacl.ttl
##
## Hand-authored SHACL shapes for governance_graph_export/governance_graph.ttl -- the
## gov:/syn:-namespaced ABox scripts/build_governance_graph.py emits. NOT generated by
## gen-shacl: gen-shacl compiles shapes for governanceduo:-namespaced classes/slots
## straight from governance_graph.yaml, but this ABox deliberately uses a different,
## bespoke namespace and a few predicate choices that diverge from the schema's literal
## slot declarations (documented per-property below and in shapes/governance_graph.owl.ttl)
## to match the "SageBrain-Governance Graph Design" doc's own worked examples. These
## shapes validate what the script actually emits, not a hypothetical fully-generic
## mapping -- consistent with build_governance_graph.py's own "not a generic dump"
## design.
##
## Run via `make governance-graph-validate` (scripts/validate_graph.py, pySHACL,
## inference="none", with shapes/governance_graph.owl.ttl passed as ont_graph so
## gov:Team/gov:User resolve as gov:Principal for PrincipalShape).
##
## Known limitations (documented, not silently ignored):
##   - Subject-IRI id patterns (e.g. SynapseEntity ids matching ^syn\d+$) are not
##     checked here -- these individuals carry no separate literal "id" property to
##     pattern-match against (the id lives entirely in the subject IRI), and SHACL
##     Core has no direct way to constrain a subject IRI's own local name without a
##     SPARQL-based constraint. Out of scope for this pass.

@prefix gov: <https://sagebionetworks.org/governance/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# SynapseEntity
#################################################################

gov:SynapseEntityShape a sh:NodeShape ;
    sh:targetClass gov:SynapseEntity ;
    sh:property
        [ sh:path gov:name ; sh:datatype xsd:string ; sh:maxCount 1 ],
        [ sh:path gov:nodeType ; sh:datatype xsd:string ; sh:maxCount 1 ],
        [ sh:path gov:alias ; sh:datatype xsd:string ; sh:maxCount 1 ],
        [ sh:path gov:currentRevNum ; sh:datatype xsd:integer ; sh:maxCount 1 ],
        [ sh:path gov:maxRevNum ; sh:maxCount 1 ],
        [ sh:path gov:etag ; sh:datatype xsd:string ; sh:maxCount 1 ],
        [ sh:path gov:createdByUserId ; sh:datatype xsd:integer ; sh:maxCount 1 ],
        [ sh:path gov:createdOn ; sh:datatype xsd:long ; sh:maxCount 1 ],
        [ sh:path gov:parentId ; sh:class gov:SynapseEntity ; sh:nodeKind sh:IRI ; sh:maxCount 1 ],
        [ sh:path gov:hasACL ; sh:class gov:AccessGrant ; sh:nodeKind sh:IRI ],
        [ sh:path gov:hasAccessRequirement ; sh:class gov:AccessRequirement ; sh:nodeKind sh:IRI ] .

#################################################################
# AccessGrant
#################################################################

gov:AccessGrantShape a sh:NodeShape ;
    sh:targetClass gov:AccessGrant ;
    sh:property
        [ sh:path gov:resource ; sh:class gov:SynapseEntity ; sh:nodeKind sh:IRI ;
            sh:minCount 1 ; sh:maxCount 1 ],
        [ sh:path gov:principal ; sh:class gov:Principal ; sh:nodeKind sh:IRI ;
            sh:minCount 1 ; sh:maxCount 1 ],
        [ sh:path gov:permission ; sh:nodeKind sh:IRI ; sh:minCount 1 ;
            sh:in ( gov:CREATE gov:READ gov:UPDATE gov:DELETE gov:CHANGE_PERMISSIONS
                    gov:DOWNLOAD gov:UPLOAD gov:PARTICIPATE gov:SUBMIT
                    gov:READ_PRIVATE_SUBMISSION gov:UPDATE_SUBMISSION
                    gov:DELETE_SUBMISSION gov:TEAM_MEMBERSHIP_UPDATE gov:SEND_MESSAGE
                    gov:CHANGE_SETTINGS gov:MODERATE gov:REVIEW_SUBMISSIONS
                    gov:EXEMPTION_ELIGIBLE ) ],
        [ sh:path gov:source ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ],
        [ sh:path gov:bindingType ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;
            sh:in ( gov:Direct gov:Inherited ) ],
        [ sh:path gov:createdOn ; sh:datatype xsd:long ; sh:maxCount 1 ],
        [ sh:path gov:sourceAclId ; sh:datatype xsd:integer ; sh:maxCount 1 ],
        [ sh:path gov:sourceAclResourceAccessId ; sh:datatype xsd:integer ; sh:maxCount 1 ] .

#################################################################
# AccessRequirementAssociation
#################################################################

gov:AccessRequirementAssociationShape a sh:NodeShape ;
    sh:targetClass gov:AccessRequirementAssociation ;
    sh:property
        [ sh:path gov:resource ; sh:class gov:SynapseEntity ; sh:nodeKind sh:IRI ;
            sh:minCount 1 ; sh:maxCount 1 ],
        [ sh:path gov:accessRequirement ; sh:class gov:AccessRequirement ;
            sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ],
        [ sh:path gov:source ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ],
        [ sh:path gov:bindingType ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;
            sh:in ( gov:Direct gov:Inherited ) ] .

#################################################################
# DataAccessSubmission (DataAccessSubmissionStatus's state/reason/audit fields merge
# in here -- see governance_graph.yaml's own note that DataAccessSubmissionStatus has
# no independent identifier in Synapse's schema)
#################################################################

gov:DataAccessSubmissionShape a sh:NodeShape ;
    sh:targetClass gov:DataAccessSubmission ;
    sh:property
        [ sh:path gov:accessRequirement ; sh:class gov:AccessRequirement ;
            sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;
            sh:description "Sources DataAccessSubmission.accessRequirementId via the same gov:accessRequirement predicate AccessRequirementAssociation uses -- see shapes/governance_graph.owl.ttl." ],
        [ sh:path gov:createdBy ; sh:class gov:Principal ; sh:nodeKind sh:IRI ;
            sh:minCount 1 ; sh:maxCount 1 ;
            sh:description "An IRI reference to a gov:Principal node, not a literal integer -- governance_graph.yaml declares this slot's range as integer; the ABox deliberately links to the creator's Principal individual instead. See shapes/governance_graph.owl.ttl." ],
        [ sh:path gov:createdOn ; sh:datatype xsd:long ; sh:maxCount 1 ],
        [ sh:path gov:state ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;
            sh:in ( gov:SUBMITTED gov:APPROVED gov:REJECTED gov:CANCELLED ) ],
        [ sh:path gov:reason ; sh:datatype xsd:string ; sh:maxCount 1 ],
        [ sh:path gov:statusCreatedBy ; sh:class gov:Principal ; sh:nodeKind sh:IRI ;
            sh:maxCount 1 ;
            sh:description "DataAccessSubmissionStatus's own creator -- kept separate from gov:createdBy since the two can legitimately differ (e.g. an ACT reviewer vs. the requester)." ],
        [ sh:path gov:statusModifiedBy ; sh:class gov:Principal ; sh:nodeKind sh:IRI ;
            sh:maxCount 1 ],
        [ sh:path gov:statusCreatedOn ; sh:datatype xsd:long ; sh:maxCount 1 ],
        [ sh:path gov:statusModifiedOn ; sh:datatype xsd:long ; sh:maxCount 1 ] .

#################################################################
# Principal (targets gov:Principal; add_principal() asserts this type explicitly on
# every individual, alongside gov:Team/gov:User -- see shapes/governance_graph.owl.ttl)
#################################################################

gov:PrincipalShape a sh:NodeShape ;
    sh:targetClass gov:Principal ;
    sh:property
        [ sh:path gov:principalId ; sh:datatype xsd:integer ; sh:minCount 1 ;
            sh:maxCount 1 ] .

#################################################################
# AccessRequirement -- a stub reference node in this ABox (see
# shapes/governance_graph.owl.ttl); no properties of its own to constrain beyond type.
#################################################################

gov:AccessRequirementShape a sh:NodeShape ;
    sh:targetClass gov:AccessRequirement .
