    rdfs:range gov:ApprovalStatus .

gov:subject a owl:ObjectProperty ;
    rdfs:label "subject" ;
    rdfs:domain gov:ControlLabel ;
    skos:definition "What the label is about: a Synapse entity, or anything derivation reaches (a sagebrain-model Association, say)." .

gov:submittedBy a owl:ObjectProperty ;
    rdfs:label "submittedBy" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( gov:Approval gov:DataAccessSubmission ) ] ;
    rdfs:range gov:User .

gov:submittedOn a owl:DatatypeProperty ;
    rdfs:label "submittedOn" ;
    rdfs:domain gov:DataAccessSubmission ;
    rdfs:range xsd:dateTime .

gov:summaryOfUse a owl:DatatypeProperty ;
    rdfs:label "summaryOfUse" ;
