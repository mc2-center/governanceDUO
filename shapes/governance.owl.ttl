    rdfs:range xsd:string .

gov:request a owl:ObjectProperty ;
    rdfs:label "request" ;
    rdfs:domain gov:DataAccessSubmission ;
    rdfs:range gov:DataAccessRequest .

gov:requestConcreteType a owl:DatatypeProperty ;
    rdfs:label "requestConcreteType" ;
    rdfs:domain gov:DataAccessRequest ;
