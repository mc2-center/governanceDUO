gov:inputLabels a owl:ObjectProperty ;
    rdfs:label "inputLabels" ;
    rdfs:domain gov:DerivationReview ;
    rdfs:range gov:ControlLabel .

gov:institution a owl:DatatypeProperty ;
    rdfs:label "institution" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( gov:DataAccessRequest gov:ResearchProject gov:Site ) ] ;
    rdfs:range xsd:string ;
    skos:definition "An institution's name, as written." .

gov:intendedDataUseStatement a owl:DatatypeProperty ;
    rdfs:label "intendedDataUseStatement" ;
    rdfs:domain gov:ResearchProject ;
    rdfs:range xsd:string .

gov:language a owl:DatatypeProperty ;
    rdfs:label "language" ;
    rdfs:domain gov:IRBRequirement ;
    rdfs:range xsd:string ;
