<https://w3id.org/synapse/governance> a owl:Ontology ;
    rdfs:label "Sage governance graph" ;
    owl:versionIRI <https://w3id.org/synapse/governance/0.2.0> ;
    owl:versionInfo "0.2.0" ;
    skos:definition """The governance graph layer (plans/model_refactor.md): who may do what to which Synapse entity, under which Access Requirements, and what derived content inherits from controlled inputs. It records facts only. Anything an evaluator needs precomputed (per-entity inherited grants, flattened team grants, "active approval" shortcuts) is a projection built from this graph (projections/).
Conventions. Standard vocabularies are used directly where they fit: W3C Web Access Control for ACL entries (acl:Authorization), vCard for teams (vcard:Group, vcard:hasMember), PROV-O for provenance, SKOS for this layer's own vocabularies (vocabularies.yaml), DUO for data-use terms. The generated OWL makes no axioms about terms outside gov:; constraints on reused classes live in the SHACL. Every node has an IRI (no blank nodes): Synapse's own URLs for entities, users and teams, and w3id IRIs beside the model's namespace for everything this layer mints (scripts/graph_iris.py). Timestamps are xsd:dateTime.""" .

gov:DUOPlus1 a owl:Class ;
    rdfs:label "DUOPlus1" ;
    rdfs:subClassOf DUO:0000017 ;
    skos:definition "Source geography is relevant to governance decisions. If providing this term, please provide the applicable country code(s) in column sourceGeography." .

gov:DUOPlus2 a owl:Class ;
    rdfs:label "DUOPlus2" ;
    rdfs:subClassOf DUO:0000017 ;
    skos:definition "Study population is relevant to governance decisions. If providing this term, please provide the applicable population type(s) in column populationType." .

gov:DUOPlus3 a owl:Class ;
    rdfs:label "DUOPlus3" ;
    rdfs:subClassOf DUO:0000017 ;
    skos:definition "Data deidentification is relevant to governance decisions. If providing this term, please provide the applicable deidentification type(s) in column deidentificationType." .

gov:DUOPlus4 a owl:Class ;
    rdfs:label "DUOPlus4" ;
    rdfs:subClassOf DUO:0000017 ;
    skos:definition "A data permission designation is associated with the Study. If providing this term, please provide the applicable permission type(s) in column dataPermission." .

gov:DUOPlus5 a owl:Class ;
    rdfs:label "DUOPlus5" ;
    rdfs:subClassOf DUO:0000017 ;
    skos:definition "A data tier designation is associated with the Study. If providing this term, please provide the applicable data tier designation(s) in column dataTier." .

gov:DUOPlus6 a owl:Class ;
    rdfs:label "DUOPlus6" ;
    rdfs:subClassOf DUO:0000017 ;
    skos:definition "A license is associated with the Study. If providing this term, please provide the applicable license in column license." .

gov:DUOPlus7 a owl:Class ;
    rdfs:label "DUOPlus7" ;
    rdfs:subClassOf DUO:0000017 ;
    skos:definition "Attribution conditions are associated with this Study. If providing this term, please provide the attribution statement in column attribution." .

gov:accessRequirement a owl:ObjectProperty ;
    rdfs:label "accessRequirement" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( gov:DataAccessRequest gov:DataAccessSubmission gov:ResearchProject ) ] ;
    rdfs:range gov:AccessRequirement .

gov:accessType a owl:ObjectProperty ;
    rdfs:label "accessType" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( gov:AccessRequirement gov:AccessRequirementTemplate gov:IRBRequirement ) ] ;
    rdfs:range gov:Permission ;
    skos:definition "The permission the Access Requirement gates, e.g. DOWNLOAD." .

gov:activity a owl:ObjectProperty ;
    rdfs:label "activity" ;
    rdfs:domain gov:DerivationReview ;
    rdfs:range prov:Activity .

gov:affiliatedWith a owl:ObjectProperty ;
    rdfs:label "affiliatedWith" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( gov:DataAccessRequest gov:ResearchProject gov:User ) ] ;
    rdfs:range gov:Site ;
    skos:definition "A site the user, request or project is affiliated with." .

gov:arType a owl:DatatypeProperty ;
    rdfs:label "arType" ;
    rdfs:domain gov:IRBRequirement ;
    rdfs:range xsd:string ;
    skos:definition "The kind of IRB requirement, e.g. IRB." .

gov:benefactor a owl:ObjectProperty ;
    rdfs:label "benefactor" ;
    rdfs:domain gov:SynapseEntity ;
    rdfs:range gov:SynapseEntity ;
    skos:definition "The entity whose ACL governs this one: itself if it has its own ACL, otherwise its nearest ancestor that does." .

gov:company a owl:DatatypeProperty ;
    rdfs:label "company" ;
    rdfs:domain gov:User ;
    rdfs:range xsd:string ;
    skos:definition "The company field of the user's Synapse profile, as written." .

gov:computedFrom a owl:ObjectProperty ;
    rdfs:label "computedFrom" ;
    rdfs:domain gov:ControlLabel ;
    rdfs:range prov:Activity .

gov:computedOn a owl:DatatypeProperty ;
    rdfs:label "computedOn" ;
    rdfs:domain gov:ControlLabel ;
    rdfs:range xsd:dateTime .

gov:conditionDetail a owl:DatatypeProperty ;
    rdfs:label "conditionDetail" ;
    rdfs:domain gov:Condition ;
    rdfs:range xsd:string ;
    skos:definition "A parameter of the condition other than a disease, as the curated record gives it (the GovernanceMixin companion field its DUO rule names)." .

gov:createdBy a owl:ObjectProperty ;
    rdfs:label "createdBy" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( prov:Activity gov:AccessRequirement gov:AccessRequirementTemplate gov:DataAccessRequest gov:IRBRequirement gov:ResearchProject gov:SynapseEntity ) ] ;
    rdfs:range gov:User .

gov:createdOn a owl:DatatypeProperty ;
    rdfs:label "createdOn" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( prov:Activity gov:AccessRequirement gov:AccessRequirementTemplate gov:Approval gov:DataAccessRequest gov:IRBRequirement gov:ResearchProject gov:SynapseEntity ) ] ;
    rdfs:range xsd:dateTime .

gov:dataTier a owl:ObjectProperty ;
    rdfs:label "dataTier" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( gov:AccessRequirement gov:AccessRequirementTemplate gov:ControlLabel gov:IRBRequirement ) ] ;
    rdfs:range gov:DataTier .

gov:dataUseTerm a owl:ObjectProperty ;
    rdfs:label "dataUseTerm" ;
    rdfs:domain gov:Condition .

gov:description a owl:DatatypeProperty ;
    rdfs:label "description" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( prov:Activity gov:Condition ) ] ;
    rdfs:range xsd:string ;
    skos:definition "A free-text description." .

gov:diseaseContext a owl:ObjectProperty ;
    rdfs:label "diseaseContext" ;
    rdfs:domain gov:Condition ;
    skos:definition "A MONDO disease the condition names." .

gov:domain a owl:DatatypeProperty ;
    rdfs:label "domain" ;
    rdfs:domain gov:AccessRequirementTemplate ;
    rdfs:range xsd:string ;
    skos:definition "The data domain a template covers, e.g. genomics." .

gov:entityType a owl:DatatypeProperty ;
    rdfs:label "entityType" ;
    rdfs:domain gov:SynapseEntity ;
    rdfs:range xsd:string ;
    skos:definition "The Synapse entity's concreteType, e.g. org.sagebionetworks.repo.model.FileEntity." .

gov:entityVersionNumber a owl:DatatypeProperty ;
    rdfs:label "entityVersionNumber" ;
    rdfs:domain prov:Usage ;
    rdfs:range xsd:integer .

gov:etag a owl:DatatypeProperty ;
    rdfs:label "etag" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( gov:AccessRequirement gov:AccessRequirementTemplate gov:Approval gov:DataAccessRequest gov:DataAccessSubmission gov:IRBRequirement gov:ResearchProject gov:SynapseEntity ) ] ;
    rdfs:range xsd:string ;
    skos:definition "Synapse's concurrency token for the record." .

gov:expiresAt a owl:DatatypeProperty ;
    rdfs:label "expiresAt" ;
    rdfs:domain gov:Approval ;
    rdfs:range xsd:dateTime .

gov:extendsTemplate a owl:ObjectProperty ;
