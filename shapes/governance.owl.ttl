gov:name a owl:DatatypeProperty ;
    rdfs:label "name" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( prov:Activity prov:Usage gov:AccessRequirement gov:AccessRequirementTemplate gov:IRBRequirement gov:Program gov:SynapseEntity ) ] ;
