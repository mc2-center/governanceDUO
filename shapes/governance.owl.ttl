gov:versionNumber a owl:DatatypeProperty ;
    rdfs:label "versionNumber" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( gov:AccessRequirement gov:AccessRequirementTemplate gov:IRBRequirement gov:SynapseEntity ) ] ;
    rdfs:range xsd:integer ;
    skos:definition "The version number of an entity or Access Requirement." .

gov:wasExecuted a owl:DatatypeProperty ;
    rdfs:label "wasExecuted" ;
    rdfs:domain prov:Usage ;
    rdfs:range xsd:boolean ;
    skos:definition "True for code that was run; false for data that was read." .

acl:Append a owl:Class .

acl:Control a owl:Class .

foaf:Agent a owl:Class .

gov:ACTRequirement a gov:AccessRequirementType ;
    skos:definition "Controlled by the Access and Compliance Team (AccessRequirementType.ATC)." ;
    skos:inScheme gov:AccessRequirementTypeScheme ;
    skos:notation "ACTAccessRequirement" ;
    skos:prefLabel "ACTAccessRequirement" .

gov:AnonymousTier a gov:DataTier ;
    skos:definition "Data can be viewed and downloaded anonymously by anyone on the internet." ;
    skos:inScheme gov:DataTierScheme ;
    skos:notation "Anonymous" ;
    skos:prefLabel "Anonymous" ;
    gov:rank 0 .

gov:Cancelled a gov:SubmissionState ;
    skos:definition "Cancelled by the submitter." ;
    skos:inScheme gov:SubmissionStateScheme ;
    skos:notation "CANCELLED" ;
    skos:prefLabel "CANCELLED" .

gov:ChangePermissions a owl:Class,
        gov:Permission ;
    rdfs:subClassOf acl:Control ;
    skos:definition "Permission to change access permissions for the entity or resource." ;
    skos:inScheme gov:PermissionScheme ;
    skos:notation "CHANGE_PERMISSIONS" ;
    skos:prefLabel "CHANGE_PERMISSIONS" .

gov:ChangeSettings a owl:Class,
        gov:Permission ;
    rdfs:subClassOf acl:Access ;
    skos:definition "Permission to change settings or configuration for the entity or resource." ;
    skos:inScheme gov:PermissionScheme ;
    skos:notation "CHANGE_SETTINGS" ;
    skos:prefLabel "CHANGE_SETTINGS" .

gov:ControlledTier a gov:DataTier ;
    skos:definition "Users must have a Synapse account and satisfy access conditions to download data." ;
    skos:inScheme gov:DataTierScheme ;
    skos:notation "Controlled" ;
    skos:prefLabel "Controlled" ;
    gov:rank 2 .

gov:Create a owl:Class,
        gov:Permission ;
    rdfs:subClassOf acl:Write ;
    skos:definition "Permission to create a new entity or resource." ;
    skos:inScheme gov:PermissionScheme ;
    skos:notation "CREATE" ;
    skos:prefLabel "CREATE" .

gov:Delete a owl:Class,
        gov:Permission ;
    rdfs:subClassOf acl:Write ;
    skos:definition "Permission to delete the entity or resource." ;
    skos:inScheme gov:PermissionScheme ;
    skos:notation "DELETE" ;
    skos:prefLabel "DELETE" .

gov:DeleteSubmission a owl:Class,
        gov:Permission ;
    rdfs:subClassOf acl:Access ;
    skos:definition "Permission to delete a submission." ;
    skos:inScheme gov:PermissionScheme ;
    skos:notation "DELETE_SUBMISSION" ;
    skos:prefLabel "DELETE_SUBMISSION" .

gov:DerivationApproved a gov:DerivationReviewStatus ;
    skos:definition "The combination was reviewed and judged safe to permit." ;
    skos:inScheme gov:DerivationReviewStatusScheme ;
    skos:notation "Approved" ;
    skos:prefLabel "Approved" .

gov:DerivationDenied a gov:DerivationReviewStatus ;
    skos:definition "The combination was reviewed and judged unsafe; access to the derived output should be blocked." ;
    skos:inScheme gov:DerivationReviewStatusScheme ;
    skos:notation "Denied" ;
    skos:prefLabel "Denied" .

gov:DerivationFlagged a gov:DerivationReviewStatus ;
    skos:definition "Minted automatically because a derivation rule or disjoint sourceAccessRequirements need a person to look; not yet reviewed." ;
    skos:inScheme gov:DerivationReviewStatusScheme ;
    skos:notation "Flagged" ;
    skos:prefLabel "Flagged" .

gov:DerivationReviewed a gov:DerivationReviewStatus ;
    skos:definition "A person has looked at this combination but not yet recorded a decision." ;
    skos:inScheme gov:DerivationReviewStatusScheme ;
    skos:notation "Reviewed" ;
    skos:prefLabel "Reviewed" .

gov:Download a owl:Class,
        gov:Permission ;
    rdfs:subClassOf acl:Read ;
    skos:definition "Permission to download files or data from the entity or resource." ;
    skos:inScheme gov:PermissionScheme ;
    skos:notation "DOWNLOAD" ;
    skos:prefLabel "DOWNLOAD" .

gov:ExemptionEligible a owl:Class,
        gov:Permission ;
    rdfs:subClassOf acl:Access ;
    skos:definition "Qualifies for exemption when granted on Access Requirement ACLs." ;
    skos:inScheme gov:PermissionScheme ;
    skos:notation "EXEMPTION_ELIGIBLE" ;
    skos:prefLabel "EXEMPTION_ELIGIBLE" .

gov:LockRequirement a gov:AccessRequirementType ;
    skos:definition "Controlled by the Access and Compliance Team; locks an entity (AccessRequirementType.LOCK)." ;
    skos:inScheme gov:AccessRequirementTypeScheme ;
    skos:notation "LockAccessRequirement" ;
    skos:prefLabel "LockAccessRequirement" .

gov:ManagedACTRequirement a gov:AccessRequirementType ;
    skos:definition "Controlled by the Access and Compliance Team, with a managed data access submission workflow (AccessRequirementType.MANAGED_ATC). The only type with DataAccessSubmissions." ;
    skos:inScheme gov:AccessRequirementTypeScheme ;
    skos:notation "ManagedACTAccessRequirement" ;
    skos:prefLabel "ManagedACTAccessRequirement" .

gov:Moderate a owl:Class,
        gov:Permission ;
    rdfs:subClassOf acl:Access ;
    skos:definition "Permission to moderate content or activity related to the entity or resource." ;
    skos:inScheme gov:PermissionScheme ;
    skos:notation "MODERATE" ;
    skos:prefLabel "MODERATE" .

gov:OpenTier a gov:DataTier ;
    skos:definition "Users must have a Synapse account to download data." ;
    skos:inScheme gov:DataTierScheme ;
    skos:notation "Open" ;
    skos:prefLabel "Open" ;
    gov:rank 1 .

gov:Participate a owl:Class,
        gov:Permission ;
    rdfs:subClassOf acl:Access ;
    skos:definition "Permission to participate in activities related to the entity, such as discussions or challenges." ;
    skos:inScheme gov:PermissionScheme ;
    skos:notation "PARTICIPATE" ;
    skos:prefLabel "PARTICIPATE" .

gov:PrivateTier a gov:DataTier ;
    skos:definition "Users must be provided access to data in Synapse by a project administrator." ;
    skos:inScheme gov:DataTierScheme ;
    skos:notation "Private" ;
    skos:prefLabel "Private" ;
    gov:rank 3 .

gov:Read a owl:Class,
        gov:Permission ;
    rdfs:subClassOf acl:Read ;
    skos:definition "Permission to read or view the entity or resource." ;
    skos:inScheme gov:PermissionScheme ;
    skos:notation "READ" ;
    skos:prefLabel "READ" .

gov:ReadPrivateSubmission a owl:Class,
        gov:Permission ;
    rdfs:subClassOf acl:Access ;
    skos:definition "Permission to read private submissions associated with the entity." ;
    skos:inScheme gov:PermissionScheme ;
    skos:notation "READ_PRIVATE_SUBMISSION" ;
    skos:prefLabel "READ_PRIVATE_SUBMISSION" .

gov:Rejected a gov:SubmissionState ;
    skos:definition "Reviewed and rejected." ;
    skos:inScheme gov:SubmissionStateScheme ;
    skos:notation "REJECTED" ;
    skos:prefLabel "REJECTED" .

gov:ReviewSubmissions a owl:Class,
        gov:Permission ;
    rdfs:subClassOf acl:Access ;
    skos:definition "Enables reviewing submission groups (e.g., on Access Requirements) for specified objects." ;
    skos:inScheme gov:PermissionScheme ;
    skos:notation "REVIEW_SUBMISSIONS" ;
    skos:prefLabel "REVIEW_SUBMISSIONS" .

gov:Revoked a gov:ApprovalStatus ;
    skos:definition "The approval was revoked." ;
    skos:inScheme gov:ApprovalStatusScheme ;
    skos:notation "REVOKED" ;
    skos:prefLabel "REVOKED" .

gov:SelfSignRequirement a gov:AccessRequirementType ;
    skos:definition "Restricted by terms of use, self-signed (AccessRequirementType.SELF_SIGNED)." ;
    skos:inScheme gov:AccessRequirementTypeScheme ;
    skos:notation "SelfSignAccessRequirement" ;
    skos:prefLabel "SelfSignAccessRequirement" .

gov:SendMessage a owl:Class,
        gov:Permission ;
    rdfs:subClassOf acl:Access ;
    skos:definition "Permission to send messages related to the entity or resource." ;
    skos:inScheme gov:PermissionScheme ;
    skos:notation "SEND_MESSAGE" ;
    skos:prefLabel "SEND_MESSAGE" .

gov:Submit a owl:Class,
        gov:Permission ;
    rdfs:subClassOf acl:Access ;
    skos:definition "Permission to submit content or data to the entity or resource." ;
    skos:inScheme gov:PermissionScheme ;
    skos:notation "SUBMIT" ;
    skos:prefLabel "SUBMIT" .

gov:Submitted a gov:SubmissionState ;
    skos:definition "Submitted and awaiting review." ;
    skos:inScheme gov:SubmissionStateScheme ;
    skos:notation "SUBMITTED" ;
    skos:prefLabel "SUBMITTED" .

gov:TeamMembershipUpdate a owl:Class,
        gov:Permission ;
    rdfs:subClassOf acl:Access ;
    skos:definition "Permission to update team membership, such as adding or removing members." ;
    skos:inScheme gov:PermissionScheme ;
    skos:notation "TEAM_MEMBERSHIP_UPDATE" ;
    skos:prefLabel "TEAM_MEMBERSHIP_UPDATE" .

gov:TermsOfUseRequirement a gov:AccessRequirementType ;
    skos:definition "Restricted by terms of use (AccessRequirementType.TOU)." ;
    skos:inScheme gov:AccessRequirementTypeScheme ;
    skos:notation "TermsOfUseAccessRequirement" ;
    skos:prefLabel "TermsOfUseAccessRequirement" .

gov:UnclassifiedTier a gov:DataTier ;
    skos:definition "Tier not yet determined by a curator. Ranked above Private, so an entity bound to an Access Requirement with no recorded tier fails closed rather than reading as unrestricted." ;
    skos:inScheme gov:DataTierScheme ;
    skos:notation "Unclassified" ;
    skos:prefLabel "Unclassified" ;
    gov:rank 4 .

gov:Update a owl:Class,
        gov:Permission ;
    rdfs:subClassOf acl:Write ;
    skos:definition "Permission to modify or update the entity or resource." ;
    skos:inScheme gov:PermissionScheme ;
    skos:notation "UPDATE" ;
    skos:prefLabel "UPDATE" .

gov:UpdateSubmission a owl:Class,
        gov:Permission ;
    rdfs:subClassOf acl:Access ;
    skos:definition "Permission to update or modify a submission." ;
    skos:inScheme gov:PermissionScheme ;
    skos:notation "UPDATE_SUBMISSION" ;
    skos:prefLabel "UPDATE_SUBMISSION" .

gov:Upload a owl:Class,
        gov:Permission ;
    rdfs:subClassOf acl:Append ;
    skos:definition "Deprecated; adding this to an ACL has no effect." ;
    skos:inScheme gov:PermissionScheme ;
    skos:notation "UPLOAD" ;
    skos:prefLabel "UPLOAD" .

acl:Read a owl:Class .

gov:ApprovalStatusScheme a skos:ConceptScheme ;
    rdfs:label "ApprovalStatus scheme" ;
    skos:hasTopConcept gov:Approved,
        gov:Revoked .

gov:Approved a gov:ApprovalStatus,
        gov:SubmissionState ;
    skos:definition "Approved. One concept in both the ApprovalStatus and SubmissionState schemes." ;
    skos:inScheme gov:ApprovalStatusScheme,
        gov:SubmissionStateScheme ;
    skos:notation "APPROVED" ;
    skos:prefLabel "APPROVED" .

acl:Write a owl:Class .

gov:ApprovalStatus a owl:Class ;
    rdfs:label "ApprovalStatus" ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "An AccessApproval's state (org.sagebionetworks.repo.model.ApprovalState), verified against Synapse's OpenAPI spec." .

gov:Program a owl:Class ;
    rdfs:label "Program" ;
    skos:definition "A research program an IRB requirement can be scoped to." .

prov:Usage a owl:Class .

gov:DerivationReviewStatusScheme a skos:ConceptScheme ;
    rdfs:label "DerivationReviewStatus scheme" ;
    skos:hasTopConcept gov:DerivationApproved,
        gov:DerivationDenied,
        gov:DerivationFlagged,
        gov:DerivationReviewed .

gov:Site a owl:Class ;
    rdfs:label "Site" ;
    skos:definition "An institution principals and requests are affiliated with." .

gov:SubmissionStateScheme a skos:ConceptScheme ;
    rdfs:label "SubmissionState scheme" ;
    skos:hasTopConcept gov:Approved,
        gov:Cancelled,
        gov:Rejected,
        gov:Submitted .

gov:AccessRequirementTypeScheme a skos:ConceptScheme ;
    rdfs:label "AccessRequirementType scheme" ;
    skos:hasTopConcept gov:ACTRequirement,
        gov:LockRequirement,
        gov:ManagedACTRequirement,
        gov:SelfSignRequirement,
        gov:TermsOfUseRequirement .

gov:Condition a owl:Class ;
    rdfs:label "Condition" ;
    skos:definition "One data-use condition of an Access Requirement: a DUO term, with the parameters the curated record gives it -- the disease(s) for DUO:0000007 as MONDO IRIs, anything else (an agreement document id, a region, a time limit) as recorded." .

gov:DataTierScheme a skos:ConceptScheme ;
    rdfs:label "DataTier scheme" ;
    skos:hasTopConcept gov:AnonymousTier,
        gov:ControlledTier,
        gov:OpenTier,
        gov:PrivateTier,
        gov:UnclassifiedTier .

gov:DerivationReviewStatus a owl:Class ;
    rdfs:label "DerivationReviewStatus" ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "Where a DerivationReview stands." .

gov:SubmissionState a owl:Class ;
    rdfs:label "SubmissionState" ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "A DataAccessSubmission's state (DataAccessSubmissionState), verified against SynapseWebClient's ACTDataAccessSubmissionWidget." .

skos:Concept a owl:Class .

skos:ConceptScheme a owl:Class .

gov:AccessRequirementType a owl:Class ;
    rdfs:label "AccessRequirementType" ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "An Access Requirement's Synapse concreteType, by its short class name." .

gov:ControlLabel a owl:Class ;
    rdfs:label "ControlLabel" ;
    skos:definition "A precomputed sensitivity label on a Synapse entity: its data tier and the Access Requirements it inherits, direct or through derivation." .

gov:DataTier a owl:Class ;
    rdfs:label "DataTier" ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "How restricted data is, in increasing order. Each concept's gov:rank is its position: a derived output takes the highest rank among its inputs." .

gov:DerivationReview a owl:Class ;
    rdfs:label "DerivationReview" ;
    skos:definition "A review of an Activity whose inputs' labels combine in a way a rule forbids or flags, or whose Access Requirement sets are disjoint." .

DUO:0000017 a owl:Class .

gov:User a owl:Class ;
    rdfs:label "User" ;
    rdfs:subClassOf foaf:Agent ;
    skos:definition "An individual Synapse user, identified by their profile URL." .

prov:Activity a owl:Class .

gov:ResearchProject a owl:Class ;
    rdfs:label "ResearchProject" ;
    skos:definition "The research project a data access request is made for." .

gov:Approval a owl:Class ;
    rdfs:label "Approval" ;
    skos:definition "A Synapse AccessApproval: a user holds an approval of an Access Requirement at a version, with a status and an expiry. Every approval is recorded, whatever its status; whether it holds at a given time is for the evaluator. Close to a GA4GH Passport ControlledAccessGrants visa (which has no RDF IRI to map to)." .

acl:Access a owl:Class .

gov:DataAccessSubmission a owl:Class ;
    rdfs:label "DataAccessSubmission" ;
    skos:definition "A request for access submitted against a managed Access Requirement, with its current state." .

gov:AccessRequirementTemplate a owl:Class ;
    rdfs:label "AccessRequirementTemplate" ;
    rdfs:subClassOf gov:AccessRequirement ;
    skos:definition "A reusable Access Requirement pattern for a data domain." .

gov:SynapseEntity a owl:Class ;
    rdfs:label "SynapseEntity" ;
    skos:closeMatch prov:Entity ;
    skos:definition "A concrete Synapse entity (project, folder, file, ...), identified by its syn: IRI. ACLs, Access Requirements and provenance attach here." .

gov:AccessRequirement a owl:Class ;
    rdfs:label "AccessRequirement" ;
    skos:definition "A Synapse Access Requirement. The curated record (the record layer's AccessRequirement) describes the same IRI, so there is one node per AR. An AR attached to an entity also governs that entity's descendants." .

gov:IRBRequirement a owl:Class ;
    rdfs:label "IRBRequirement" ;
    rdfs:subClassOf gov:AccessRequirement ;
    skos:definition "An IRB-specific Access Requirement extending a template, optionally scoped to a program or site." .

gov:DataAccessRequest a owl:Class ;
    rdfs:label "DataAccessRequest" ;
    skos:definition "The request a DataAccessSubmission was made from." .

gov:PermissionScheme a skos:ConceptScheme ;
    rdfs:label "Permission scheme" ;
    skos:hasTopConcept gov:ChangePermissions,
        gov:ChangeSettings,
        gov:Create,
        gov:Delete,
        gov:DeleteSubmission,
        gov:Download,
        gov:ExemptionEligible,
        gov:Moderate,
        gov:Participate,
        gov:Read,
        gov:ReadPrivateSubmission,
        gov:ReviewSubmissions,
        gov:SendMessage,
        gov:Submit,
        gov:TeamMembershipUpdate,
        gov:Update,
        gov:UpdateSubmission,
        gov:Upload .

gov:Permission a owl:Class ;
    rdfs:label "Permission" ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "A Synapse ACCESS_TYPE (org.sagebionetworks.repo.model.ACCESS_TYPE), as a Web Access Control access mode. Each value is also rdfs:subClassOf the WAC mode it amounts to (acl:Read, acl:Write, acl:Append, acl:Control), or of acl:Access when it has no WAC counterpart. The authorizer's derived ACCESS action isn't a value here; the authorizer_v1 projection derives it." .

