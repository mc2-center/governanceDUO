            owl:unionOf ( gov:AccessRequirement gov:AccessRequirementTemplate gov:IRBRequirement ) ] ;
    rdfs:range gov:Condition .

gov:heldBy a owl:ObjectProperty ;
    rdfs:label "heldBy" ;
    rdfs:domain gov:Approval ;
    rdfs:range gov:User ;
