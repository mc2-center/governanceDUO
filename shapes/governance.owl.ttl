gov:modifiedBy a owl:ObjectProperty ;
    rdfs:label "modifiedBy" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( prov:Activity gov:DataAccessRequest gov:DataAccessSubmission ) ] ;
    rdfs:range gov:User .

gov:modifiedOn a owl:DatatypeProperty ;
    rdfs:label "modifiedOn" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( prov:Activity gov:AccessRequirement gov:AccessRequirementTemplate gov:Approval gov:DataAccessRequest gov:DataAccessSubmission gov:IRBRequirement gov:SynapseEntity ) ] ;
