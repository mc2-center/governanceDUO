    rdfs:range xsd:string .

gov:requestPrincipalInvestigatorName a owl:DatatypeProperty ;
    rdfs:label "requestPrincipalInvestigatorName" ;
    rdfs:domain gov:DataAccessRequest ;
    rdfs:range xsd:string .

gov:requestSigningOfficialEmail a owl:DatatypeProperty ;
    rdfs:label "requestSigningOfficialEmail" ;
    rdfs:domain gov:DataAccessRequest ;
    rdfs:range xsd:string .

gov:requestSigningOfficialName a owl:DatatypeProperty ;
    rdfs:label "requestSigningOfficialName" ;
    rdfs:domain gov:DataAccessRequest ;
    rdfs:range xsd:string .

gov:requirementType a owl:ObjectProperty ;
    rdfs:label "requirementType" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( gov:AccessRequirement gov:AccessRequirementTemplate gov:IRBRequirement ) ] ;
    rdfs:range gov:AccessRequirementType .

gov:requirementVersion a owl:DatatypeProperty ;
    rdfs:label "requirementVersion" ;
