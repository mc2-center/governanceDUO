    rdfs:range xsd:string .

gov:reviewStatus a owl:ObjectProperty ;
    rdfs:label "reviewStatus" ;
    rdfs:domain gov:DerivationReview ;
    rdfs:range gov:DerivationReviewStatus .

gov:reviewedBy a owl:ObjectProperty ;
    rdfs:label "reviewedBy" ;
    rdfs:domain gov:DerivationReview ;
    rdfs:range gov:User .

gov:reviewedOn a owl:DatatypeProperty ;
    rdfs:label "reviewedOn" ;
    rdfs:domain gov:DerivationReview ;
    rdfs:range xsd:dateTime .

gov:satisfies a owl:ObjectProperty ;
    rdfs:label "satisfies" ;
    rdfs:domain gov:Approval ;
    rdfs:range gov:AccessRequirement .

gov:scopedToProgram a owl:ObjectProperty ;
    rdfs:label "scopedToProgram" ;
    rdfs:domain gov:IRBRequirement ;
    rdfs:range gov:Program .

gov:scopedToSite a owl:ObjectProperty ;
    rdfs:label "scopedToSite" ;
    rdfs:domain gov:IRBRequirement ;
    rdfs:range gov:Site .

gov:sourceAccessRequirements a owl:ObjectProperty ;
    rdfs:label "sourceAccessRequirements" ;
