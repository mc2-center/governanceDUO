{
  "$id": "http://example.com/Study_validation",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "allOf": [
    {
      "if": {
        "properties": {
          "StudyDataUseModifiers": {
            "enum": [
              "COL"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "StudyCollaborationRequired": {
            "not": {
              "type": "null"
            }
          }
        },
        "required": [
          "StudyCollaborationRequired"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "StudyDataUseModifiers": {
            "enum": [
              "DSR"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "StudyDiseaseSpecificResearch": {
            "not": {
              "type": "null"
            }
          }
        },
        "required": [
          "StudyDiseaseSpecificResearch"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "StudyDataUseModifiers": {
            "enum": [
              "DUOPlus1"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "StudySourceGeography": {
            "not": {
              "type": "null"
            }
          }
        },
        "required": [
          "StudySourceGeography"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "StudyDataUseModifiers": {
            "enum": [
              "DUOPlus2"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "StudyPopulation": {
            "not": {
              "type": "null"
            }
          }
        },
        "required": [
          "StudyPopulation"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "StudyDataUseModifiers": {
            "enum": [
              "DUOPlus4"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "StudyDataPermission": {
            "not": {
              "type": "null"
            }
          }
        },
        "required": [
          "StudyDataPermission"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "StudyDataUseModifiers": {
            "enum": [
              "DUOPlus5"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "StudyDataTier": {
            "not": {
              "type": "null"
            }
          }
        },
        "required": [
          "StudyDataTier"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "StudyDataUseModifiers": {
            "enum": [
              "DUOPlus6"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "StudyLicense": {
            "not": {
              "type": "null"
            }
          }
        },
        "required": [
          "StudyLicense"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "StudyDataUseModifiers": {
            "enum": [
              "DUOPlus7"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "StudyAttribution": {
            "not": {
              "type": "null"
            }
          }
        },
        "required": [
          "StudyAttribution"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "StudyDataUseModifiers": {
            "enum": [
              "GSR"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "StudyGeographicalRestriction": {
            "not": {
              "type": "null"
            }
          }
        },
        "required": [
          "StudyGeographicalRestriction"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "StudyDataUseModifiers": {
            "enum": [
              "IST"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "StudyInstitutionSpecificRestriction": {
            "not": {
              "type": "null"
            }
          }
        },
        "required": [
          "StudyInstitutionSpecificRestriction"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "StudyDataUseModifiers": {
            "enum": [
              "MOR"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "StudyPublicationMoratorium": {
            "not": {
              "type": "null"
            }
          }
        },
        "required": [
          "StudyPublicationMoratorium"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "StudyDataUseModifiers": {
            "enum": [
              "RST"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "StudyResearchSpecificRestrictions": {
            "not": {
              "type": "null"
            }
          }
        },
        "required": [
          "StudyResearchSpecificRestrictions"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "StudyDataUseModifiers": {
            "enum": [
              "TSM"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "StudyTimeLimitOnUse": {
            "not": {
              "type": "null"
            }
          }
        },
        "required": [
          "StudyTimeLimitOnUse"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "StudyDataUseModifiers": {
            "enum": [
              "USE"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "StudyUserSpecificRestriction": {
            "not": {
              "type": "null"
            }
          }
        },
        "required": [
          "StudyUserSpecificRestriction"
        ]
      }
    }
  ],
  "description": "Studies associated with a grant",
  "properties": {
    "AccessRequirementKey": {
      "description": "The Access Requirement id(s) associated with this study. Provide multiple values as a comma-separated list.",
      "oneOf": [
        {
          "title": "string",
          "type": "string"
        },
        {
          "title": "null",
          "type": "null"
        }
      ],
      "title": "AccessRequirementKey"
    },
    "Component": {
      "description": "Category of metadata (e.g. Tools, Publications, etc.); provide the same one for all items/rows.",
      "title": "Component",
      "type": "string"
    },
    "GrantNumber": {
      "description": "The identifier associated with the award funding this study.",
      "oneOf": [
        {
          "title": "array",
          "type": "array"
        },
        {
          "title": "null",
          "type": "null"
        }
      ],
      "title": "grantNumber"
    },
    "StudyAttribution": {
      "description": "The funder-, contributor-, patient-, etc., derived content that includes terms, conditions, or statements associated with accessing and reusing the resource(s). Maps to DUOplus7.",
      "oneOf": [
        {
          "title": "string",
          "type": "string"
        },
        {
          "title": "null",
          "type": "null"
        }
      ],
      "title": "studyAttribution"
    },
    "StudyCollaborationRequired": {
      "description": "Boolean. Collaboration is required to reuse data from this study.",
      "oneOf": [
        {
          "enum": [
            "False",
            "True"
          ],
          "title": "enum"
        },
        {
          "title": "null",
          "type": "null"
        }
      ],
      "title": "studyCollaborationRequired"
    },
    "StudyDataPermission": {
      "description": "The list of entities or objects that define or enforce data sharing permissions. Maps to DUOplus4.",
      "oneOf": [
        {
          "items": {
            "enum": [
              "Agreement",
              "Attestation",
              "Award",
              "Other"
            ]
          },
          "title": "array",
          "type": "array"
        },
        {
          "title": "null",
          "type": "null"
        }
      ],
      "title": "studyDataPermission"
    },
    "StudyDataTier": {
      "description": "The access tier(s) associated with the data in this study. Maps to DUOplus5.",
      "oneOf": [
        {
          "items": {
            "enum": [
              "Anonymous",
              "Controlled",
              "Open",
              "Private"
            ]
          },
          "title": "array",
          "type": "array"
        },
        {
          "title": "null",
          "type": "null"
        }
      ],
      "title": "studyDataTier"
    },
    "StudyDataUseModifiers": {
      "description": "DUO code - A data item that is used to indicate consent permissions for datasets and/or materials and relates to the purposes for which datasets and/or material might be removed, stored, or used.",
