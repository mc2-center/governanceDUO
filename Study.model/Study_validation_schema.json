        {
          "title": "string",
          "type": "string"
        },
        {
          "title": "null",
          "type": "null"
        }
      ],
      "title": "studyDbgapAccessionId"
    },
    "StudyDeidentificationMethodDescription": {
      "description": "Description of the process of removing potentially identifying data or data elements to render data into a form that does not identify individuals and where identification is not likely to take place.",
