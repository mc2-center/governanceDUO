      "title": "studyDataUseModifiers"
    },
    "StudyDbgapAccessionId": {
      "description": "A stable unique alphanumeric identifier assigned to a study and any objects by the database of Genotypes and Phenotypes (dbGaP). Required for controlled access data being submitted to CDS/CRDC.",
