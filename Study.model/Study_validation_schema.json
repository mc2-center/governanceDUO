        {
          "items": {
            "enum": [
              "CC",
              "COL",
              "DSR",
              "DUM",
              "DUOPlus1",
              "DUOPlus2",
              "DUOPlus3",
              "DUOPlus4",
              "DUOPlus5",
              "DUOPlus6",
              "DUOPlus7",
              "GRU",
              "GSO",
              "GSR",
              "HMB",
              "IRB",
              "IST",
              "MOR",
              "NCU",
              "NMDS",
              "NPOA",
